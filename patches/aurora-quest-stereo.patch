+#ifndef AURORA_STEREO_H
+#define AURORA_STEREO_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Stereo rendering for a VR headset (Android; elsewhere these do nothing).
+//
+// Between AuroraStereoBegin and AuroraStereoEnd, each GX draw made with a
+// perspective projection is also drawn for two eyes, into an image holding
+// both side by side (left eye on the left), followed by a single HUD region
+// below the eye images. The hidden screen's world and HUD are skipped.
+// For eye e, the draw's projection is replaced by clip[e]: a row-major
+// 4x4 matrix taking a view-space position (what GXLoadPosMtxImm gives) to GX
+// clip space, with GX's depth conventions (z/w from -1 at near to 0 at far).
+//
+// The images are AHardwareBuffers (RGBA8, GPU color output), registered once,
+// twice as wide as an eye, and eyeHeight + hudHeight tall. Orthographic
+// draws keep their game projection in the hudWidth x hudHeight region.
+// When the frame that drew into one has been
+// submitted to the GPU, `callback` runs on Aurora's render thread with the
+// image's index, the frame tag given to AuroraStereoBegin and a sync fd that
+// signals once the GPU has written the image (-1: nothing to wait for). The
+// callee owns the fd.
+
+typedef void (*AuroraStereoCallback)(uint32_t image, uint64_t frameTag, int syncFd, bool hasWorld, void* user);
+
+bool AuroraStereoRegisterImages(void* const* hardwareBuffers, uint32_t count, uint32_t width, uint32_t height,
+                                uint32_t eyeHeight, uint32_t hudWidth, uint32_t hudHeight,
+                                AuroraStereoCallback callback, void* user);
+void AuroraStereoBegin(uint32_t image, const float clip[2][16], uint64_t frameTag);
+void AuroraStereoEnd(void);
+// Suppress the unused screen world even when all eye buffers are busy.
+void AuroraStereoWorldOnly(bool enabled);
+bool AuroraStereoActive(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
