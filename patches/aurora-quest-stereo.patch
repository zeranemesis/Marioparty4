+        .data = {.setViewport = {left, 0.f, width, height, 0.f, 1.f}},
+    });
+    pass.commands.push_back({
+        .type = CommandType::SetScissor,
+        .data = {.setScissor = {static_cast<int32_t>(eye * desc.eyeWidth), 0, static_cast<int32_t>(desc.eyeWidth),
+                                static_cast<int32_t>(desc.eyeHeight)}},
+    });
+    for (const auto& draw : *desc.eyes[eye]) {
+      pass.commands.push_back({
+          .type = CommandType::Draw,
+          .data = {.draw = ShaderDrawCommand{.type = ShaderType::GX, .gx = draw}},
+      });
+    }
+  }
+  pass.commands.push_back({
+      .type = CommandType::SetViewport,
+      .data = {.setViewport = {0.f, static_cast<float>(desc.eyeHeight), static_cast<float>(desc.hudWidth),
+                              static_cast<float>(desc.hudHeight), 0.f, 1.f}},
+  });
+  pass.commands.push_back({
+      .type = CommandType::SetScissor,
+      .data = {.setScissor = {0, static_cast<int32_t>(desc.eyeHeight), static_cast<int32_t>(desc.hudWidth),
+                             static_cast<int32_t>(desc.hudHeight)}},
+  });
+  for (const auto& draw : *desc.hud) {
+    pass.commands.push_back({
+        .type = CommandType::Draw,
+        .data = {.draw = ShaderDrawCommand{.type = ShaderType::GX, .gx = draw}},
+    });
+  }
+  frame.renderPasses.emplace_back(std::move(pass));
