+void stereo::enqueue_pass(const PassDesc& desc) noexcept {
+  auto& frame = current_frame_packet();
+  RenderPass pass{
+      .label = "Stereo eyes",
+      .colorView = desc.color,
+      .resolveView = desc.resolve,
+      .depthStencilView = desc.depth,
+      .targetSize = desc.size,
+      .msaaSamples = desc.sampleCount,
+      .clearColorValue = {0.f, 0.f, 0.f, 0.f},
+      .clearDepthValue = gx::UseReversedZ ? 0.f : 1.f,
+      .colorStoreOp = desc.sampleCount > 1 ? wgpu::StoreOp::Discard : wgpu::StoreOp::Store,
+      .depthStoreOp = wgpu::StoreOp::Discard,
+      .clearColor = true,
+      .clearDepth = true,
+      .hasDepth = true,
+      .hasStencil = false,
+      .offscreen = true,
+      .stereoImage = desc.image,
+      .stereoTag = desc.tag,
+      .stereoHasWorld = desc.hasWorld,
+  };
+  pass.commands.reserve(desc.eyes[0]->size() + desc.eyes[1]->size() + desc.hud->size() + 6);
+  // With dynamic resolution, each eye draws a smaller rectangle of its half:
+  // at the left, centered vertically, so the headset finds it at the same rows
+  // whichever vertical origin its compositor gives the image.
+  const uint32_t eyeTop = desc.hudTop > desc.eyeHeight ? (desc.hudTop - desc.eyeHeight) / 2 : 0;
+  // Viewport and scissor: 0 the left eye's rectangle, 1 the right eye's,
+  // 2 both (instanced draws: stereo.cpp squeezes each instance into its own).
+  int view = -1;
+  const auto set_view = [&](int wanted) {
+    if (view == wanted) {
+      return;
+    }
+    view = wanted;
+    const uint32_t left = wanted == 1 ? desc.eyeStride : 0;
+    const uint32_t width = wanted == 2 ? desc.eyeStride + desc.eyeWidth : desc.eyeWidth;
+    pass.commands.push_back({
+        .type = CommandType::SetViewport,
+        .data = {.setViewport = {static_cast<float>(left), static_cast<float>(eyeTop), static_cast<float>(width),
+                                 static_cast<float>(desc.eyeHeight), 0.f, 1.f}},
+    });
+    pass.commands.push_back({
+        .type = CommandType::SetScissor,
+        .data = {.setScissor = {static_cast<int32_t>(left), static_cast<int32_t>(eyeTop), static_cast<int32_t>(width),
+                                static_cast<int32_t>(desc.eyeHeight)}},
+    });
+  };
+  const auto push_gx = [&](const gx::DrawData& draw) {
+    pass.commands.push_back({
+        .type = CommandType::Draw,
+        .data = {.draw = ShaderDrawCommand{.type = ShaderType::GX, .gx = draw}},
+    });
+  };
+  // In recording order. A run of per-eye draws goes to the left eye, then the
+  // same run to the right eye, so the viewport changes per run, not per draw.
+  const auto& leftDraws = *desc.eyes[0];
+  const auto& rightDraws = *desc.eyes[1];
+  const auto instanced = [&](size_t i) {
+    return desc.instanced != nullptr && i < desc.instanced->size() && (*desc.instanced)[i] != 0;
+  };
+  for (size_t i = 0; i < leftDraws.size();) {
