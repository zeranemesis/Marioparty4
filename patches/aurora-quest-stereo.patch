+        .type = CommandType::SetScissor,
+        .data = {.setScissor = {static_cast<int32_t>(eye * desc.eyeStride), static_cast<int32_t>(eyeTop),
+                                static_cast<int32_t>(desc.eyeWidth), static_cast<int32_t>(desc.eyeHeight)}},
+    });
+    for (const auto& draw : *desc.eyes[eye]) {
