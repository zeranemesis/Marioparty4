+// Fragment density map (party board patch): one device-wide map, attached to
+// every render pass, and every pipeline's compatible render pass, whose depth
+// format and sample count match (RenderPassCache). The map stays in
+// VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT between writes.
+bool Device::EnableFragmentDensityMap(wgpu::TextureFormat depthFormat,
+                                      uint32_t sampleCount,
+                                      uint32_t maxWidth,
+                                      uint32_t maxHeight) {
+    if (mFdm.enabled) {
+        return true;
+    }
+    if (!mDeviceInfo.HasExt(DeviceExt::FragmentDensityMap) ||
+        mDeviceInfo.fragmentDensityMapFeatures.fragmentDensityMap != VK_TRUE ||
+        mDeviceInfo.fragmentDensityMapFeatures.fragmentDensityMapNonSubsampledImages != VK_TRUE ||
+        GetRenderPassType() == VulkanRenderPassType::DynamicRendering) {
+        return false;
+    }
+    const VkExtent2D texel = mDeviceInfo.fragmentDensityMapProperties.minFragmentDensityTexelSize;
+    if (texel.width == 0 || texel.height == 0) {
+        return false;
+    }
+    mFdm.texelWidth = texel.width;
+    mFdm.texelHeight = texel.height;
+    mFdm.width = (maxWidth + texel.width - 1) / texel.width;
+    mFdm.height = (maxHeight + texel.height - 1) / texel.height;
+
+    VkImageCreateInfo imageInfo = {};
+    imageInfo.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    imageInfo.imageType = VK_IMAGE_TYPE_2D;
+    imageInfo.format = VK_FORMAT_R8G8_UNORM;
+    imageInfo.extent = {mFdm.width, mFdm.height, 1};
+    imageInfo.mipLevels = 1;
+    imageInfo.arrayLayers = 1;
+    imageInfo.samples = VK_SAMPLE_COUNT_1_BIT;
+    imageInfo.tiling = VK_IMAGE_TILING_OPTIMAL;
+    imageInfo.usage = VK_IMAGE_USAGE_FRAGMENT_DENSITY_MAP_BIT_EXT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    imageInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    imageInfo.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (fn.CreateImage(GetVkDevice(), &imageInfo, nullptr, &*mFdm.image) != VK_SUCCESS) {
+        return false;
+    }
+    VkMemoryRequirements requirements;
+    fn.GetImageMemoryRequirements(GetVkDevice(), mFdm.image, &requirements);
+    auto allocation = GetResourceMemoryAllocator()->Allocate(requirements, MemoryKind::DeviceLocal);
+    if (allocation.IsError()) {
+        allocation.AcquireError();
+        fn.DestroyImage(GetVkDevice(), mFdm.image, nullptr);
+        mFdm.image = VK_NULL_HANDLE;
+        return false;
+    }
+    mFdm.memory = allocation.AcquireSuccess();
+    if (fn.BindImageMemory(GetVkDevice(), mFdm.image,
+                           ToBackend(mFdm.memory.GetResourceHeap())->GetMemory(),
+                           mFdm.memory.GetOffset()) != VK_SUCCESS) {
+        return false;
+    }
+    VkImageViewCreateInfo viewInfo = {};
+    viewInfo.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+    viewInfo.image = mFdm.image;
+    viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    viewInfo.format = VK_FORMAT_R8G8_UNORM;
+    viewInfo.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    if (fn.CreateImageView(GetVkDevice(), &viewInfo, nullptr, &*mFdm.view) != VK_SUCCESS) {
+        return false;
+    }
+    mFdm.id = 0xFD00000000000000ull | reinterpret_cast<uintptr_t>(this);
+    mFdm.depthFormat = depthFormat;
+    mFdm.sampleCount = sampleCount;
+    // Full density everywhere until written.
+    std::vector<uint8_t> full(size_t(mFdm.width) * mFdm.height * 2, 255);
+    mFdm.enabled = true;
+    if (!WriteFragmentDensityMap(full.data(), mFdm.width, mFdm.height)) {
+        mFdm.enabled = false;
+        return false;
+    }
+    return true;
+}
+
+bool Device::WriteFragmentDensityMap(const uint8_t* rg8, uint32_t width, uint32_t height) {
+    if (!mFdm.enabled || rg8 == nullptr || width == 0 || height == 0 || width > mFdm.width ||
+        height > mFdm.height) {
+        return false;
+    }
+    const VkDeviceSize size = VkDeviceSize(width) * height * 2;
+    VkBufferCreateInfo bufferInfo = {};
+    bufferInfo.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    bufferInfo.size = size;
+    bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    VkBuffer staging = VK_NULL_HANDLE;
+    if (fn.CreateBuffer(GetVkDevice(), &bufferInfo, nullptr, &*staging) != VK_SUCCESS) {
+        return false;
+    }
+    VkMemoryRequirements requirements;
+    fn.GetBufferMemoryRequirements(GetVkDevice(), staging, &requirements);
+    auto allocation = GetResourceMemoryAllocator()->Allocate(
+        requirements, MemoryKind::Linear | MemoryKind::WriteMappable);
+    if (allocation.IsError()) {
+        allocation.AcquireError();
+        fn.DestroyBuffer(GetVkDevice(), staging, nullptr);
+        return false;
+    }
+    ResourceMemoryAllocation memory = allocation.AcquireSuccess();
+    fn.BindBufferMemory(GetVkDevice(), staging, ToBackend(memory.GetResourceHeap())->GetMemory(),
+                        memory.GetOffset());
+    std::memcpy(memory.GetMappedPointer(), rg8, size_t(size));
+    const size_t memoryType = ToBackend(memory.GetResourceHeap())->GetMemoryType();
+    if (!IsSubset(VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+                  mDeviceInfo.memoryTypes[memoryType].propertyFlags)) {
+        const VkDeviceSize atom = mDeviceInfo.properties.limits.nonCoherentAtomSize;
+        const VkDeviceSize begin = memory.GetOffset() / atom * atom;
+        const VkDeviceSize end = (memory.GetOffset() + size + atom - 1) / atom * atom;
+        VkMappedMemoryRange range = {};
+        range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+        range.memory = ToBackend(memory.GetResourceHeap())->GetMemory();
+        range.offset = begin;
+        range.size = end - begin;
+        fn.FlushMappedMemoryRanges(GetVkDevice(), 1, &range);
+    }
+
+    CommandRecordingContext* recordingContext = ToBackend(GetQueue())->GetPendingRecordingContext();
+    VkImageMemoryBarrier toTransfer = {};
+    toTransfer.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    toTransfer.srcAccessMask = mFdm.written ? VK_ACCESS_FRAGMENT_DENSITY_MAP_READ_BIT_EXT : 0;
+    toTransfer.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    toTransfer.oldLayout = mFdm.written ? VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT
+                                        : VK_IMAGE_LAYOUT_UNDEFINED;
+    toTransfer.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    toTransfer.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toTransfer.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    toTransfer.image = mFdm.image;
+    toTransfer.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    fn.CmdPipelineBarrier(recordingContext->commandBuffer,
+                          mFdm.written ? VK_PIPELINE_STAGE_FRAGMENT_DENSITY_PROCESS_BIT_EXT
+                                       : VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1,
+                          &toTransfer);
+    VkBufferImageCopy region = {};
+    region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.imageExtent = {width, height, 1};
+    fn.CmdCopyBufferToImage(recordingContext->commandBuffer, staging, mFdm.image,
+                            VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+    VkImageMemoryBarrier toDensity = toTransfer;
+    toDensity.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    toDensity.dstAccessMask = VK_ACCESS_FRAGMENT_DENSITY_MAP_READ_BIT_EXT;
+    toDensity.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    toDensity.newLayout = VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT;
+    fn.CmdPipelineBarrier(recordingContext->commandBuffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_FRAGMENT_DENSITY_PROCESS_BIT_EXT, 0, 0, nullptr, 0,
+                          nullptr, 1, &toDensity);
+    recordingContext->needsSubmit = true;
+    mFdm.written = true;
+
+    GetFencedDeleter()->DeleteWhenUnused(staging);
+    GetResourceMemoryAllocator()->Deallocate(&memory);
+    return true;
+}
+
+bool Device::FragmentDensityMapApplies(bool hasDepthStencil,
+                                       wgpu::TextureFormat depthFormat,
+                                       uint32_t sampleCount) const {
+    return mFdm.enabled && hasDepthStencil && depthFormat == mFdm.depthFormat &&
+           sampleCount == mFdm.sampleCount;
+}
+
+VkImageView Device::GetFragmentDensityMapView() const {
+    return mFdm.view;
+}
+
+uint64_t Device::GetFragmentDensityMapId() const {
+    return mFdm.id;
+}
+
+void Device::GetFragmentDensityMapLayout(uint32_t* texelWidth,
+                                         uint32_t* texelHeight,
+                                         uint32_t* mapWidth,
+                                         uint32_t* mapHeight) const {
+    *texelWidth = mFdm.enabled ? mFdm.texelWidth : 0;
+    *texelHeight = mFdm.enabled ? mFdm.texelHeight : 0;
+    *mapWidth = mFdm.enabled ? mFdm.width : 0;
+    *mapHeight = mFdm.enabled ? mFdm.height : 0;
+}
+
+void Device::DestroyFragmentDensityMap() {
+    if (mFdm.view != VK_NULL_HANDLE) {
+        fn.DestroyImageView(GetVkDevice(), mFdm.view, nullptr);
+        mFdm.view = VK_NULL_HANDLE;
+    }
+    if (mFdm.image != VK_NULL_HANDLE) {
+        fn.DestroyImage(GetVkDevice(), mFdm.image, nullptr);
+        mFdm.image = VK_NULL_HANDLE;
+    }
+    if (mFdm.memory.GetInfo().mMethod != AllocationMethod::kInvalid) {
+        GetResourceMemoryAllocator()->Deallocate(&mFdm.memory);
+    }
+    mFdm.enabled = false;
+}
+
 }  // namespace dawn::native::vulkan
