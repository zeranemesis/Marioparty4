diff --git a/lib/gfx/rt_composite.cpp b/lib/gfx/rt_composite.cpp
new file mode 100644
index 0000000..55a7262
--- /dev/null
+++ b/lib/gfx/rt_composite.cpp
@@ -0,0 +1,332 @@
+#include "rt_composite.hpp"
+
+#include "../webgpu/gpu.hpp"
+#include "common.hpp"
+
+#ifdef _WIN32
+#include "../rt/rt_capture.hpp"
+#include "../rt/rt_interop.hpp"
+#endif
+
+#include <array>
+
+namespace aurora::gfx::rt_composite {
+namespace {
+using webgpu::g_device;
+using webgpu::g_graphicsConfig;
+
+Module Log("aurora::gfx::rt_composite");
+
+// Two draws rather than one: a multiply cannot also do an over-blend, and the
+// two terms need different blend states. Both are full-screen triangles with no
+// vertex buffer, so the second costs a state change and nothing else.
+enum class Term { Occlusion, Reflection };
+
+wgpu::BindGroupLayout g_bindGroupLayout;
+wgpu::ShaderModule g_module;
+wgpu::RenderPipeline g_occlusionPipeline;
+wgpu::RenderPipeline g_reflectionPipeline;
+uint32_t g_pipelineSamples = 0;
+bool g_pipelineDepth = false;
+bool g_pipelineReplace = false;
+
+wgpu::BindGroup g_bindGroup;
+WGPUTextureView g_boundAo = nullptr;
+WGPUTextureView g_boundReflection = nullptr;
+
+constexpr std::string_view kShaderSource = R"""(
+// Ray traced ambient occlusion, three channels because the indirect bounce
+// carries colour.
+@group(0) @binding(0)
+var ao_texture: texture_2d<f32>;
+// Reflected colour in rgb, blend weight in a.
+@group(0) @binding(1)
+var reflection_texture: texture_2d<f32>;
+
+struct VertexOutput {
+    @builtin(position) pos: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+};
+
+var<private> pos: array<vec2<f32>, 3> = array<vec2<f32>, 3>(
+    vec2(-1.0, 1.0),
+    vec2(-1.0, -3.0),
+    vec2(3.0, 1.0),
+);
+var<private> uvs: array<vec2<f32>, 3> = array<vec2<f32>, 3>(
+    vec2(0.0, 0.0),
+    vec2(0.0, 2.0),
+    vec2(2.0, 0.0),
+);
+
+@vertex
+fn vs_main(@builtin(vertex_index) vtxIdx: u32) -> VertexOutput {
+    var out: VertexOutput;
+    out.pos = vec4<f32>(pos[vtxIdx], 0.0, 1.0);
+    out.uv = uvs[vtxIdx];
+    return out;
+}
+
+// The ray tracing targets are unfilterable-float, so a sampler cannot touch
+// them. This is the bilinear a sampler would have done, by hand: four loads and
+// two mixes. It matters because the trace runs at a fraction of the render
+// resolution -- point sampling would make a half resolution buffer look like
+// one.
+fn sample_rt(t: texture_2d<f32>, uv: vec2<f32>) -> vec4<f32> {
+    let dims = vec2<f32>(textureDimensions(t));
+    let hi = vec2<i32>(dims) - vec2<i32>(1, 1);
+    let p = uv * dims - vec2<f32>(0.5, 0.5);
+    let base = floor(p);
+    let f = p - base;
+    let i0 = clamp(vec2<i32>(base), vec2<i32>(0, 0), hi);
+    let i1 = clamp(vec2<i32>(base) + vec2<i32>(1, 1), vec2<i32>(0, 0), hi);
+    let c00 = textureLoad(t, vec2<i32>(i0.x, i0.y), 0);
+    let c10 = textureLoad(t, vec2<i32>(i1.x, i0.y), 0);
+    let c01 = textureLoad(t, vec2<i32>(i0.x, i1.y), 0);
+    let c11 = textureLoad(t, vec2<i32>(i1.x, i1.y), 0);
+    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
+}
+
+// Blended as dst * src, so this output is the multiplier itself.
+@fragment
+fn fs_occlusion(in: VertexOutput) -> @location(0) vec4<f32> {
+    return vec4<f32>(sample_rt(ao_texture, in.uv).rgb, 1.0);
+}
+
+// Premultiplied, blended as src + dst * (1 - src.a): a reflection replaces
+// rather than adds, because the surfaces the game environment maps are already
+// bright and adding light to them would be invisible.
+@fragment
+fn fs_reflection(in: VertexOutput) -> @location(0) vec4<f32> {
+    let refl = sample_rt(reflection_texture, in.uv);
+    return vec4<f32>(refl.rgb * refl.a, refl.a);
+}
+)""";
+
+bool ensure_module() noexcept {
+  if (g_module) {
+    return true;
+  }
+  if (!g_device) {
+    return false;
+  }
+  wgpu::ShaderSourceWGSL sourceDescriptor{};
+  sourceDescriptor.code = wgpu::StringView(kShaderSource.data(), kShaderSource.size());
+  const wgpu::ShaderModuleDescriptor moduleDescriptor{
+      .nextInChain = &sourceDescriptor,
+      .label = "RT Composite Module",
+  };
+  g_module = g_device.CreateShaderModule(&moduleDescriptor);
+
+  const std::array bindGroupLayoutEntries{
+      wgpu::BindGroupLayoutEntry{
+          .binding = 0,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture =
+              wgpu::TextureBindingLayout{
+                  // Unfilterable: the ray tracing targets are float formats
+                  // Dawn does not allow a filtering sampler on.
+                  .sampleType = wgpu::TextureSampleType::UnfilterableFloat,
+                  .viewDimension = wgpu::TextureViewDimension::e2D,
+              },
+      },
+      wgpu::BindGroupLayoutEntry{
+          .binding = 1,
+          .visibility = wgpu::ShaderStage::Fragment,
+          .texture =
+              wgpu::TextureBindingLayout{
+                  .sampleType = wgpu::TextureSampleType::UnfilterableFloat,
+                  .viewDimension = wgpu::TextureViewDimension::e2D,
+              },
+      },
+  };
+  const wgpu::BindGroupLayoutDescriptor bindGroupLayoutDescriptor{
+      .label = "RT Composite Bind Group Layout",
+      .entryCount = bindGroupLayoutEntries.size(),
+      .entries = bindGroupLayoutEntries.data(),
+  };
+  g_bindGroupLayout = g_device.CreateBindGroupLayout(&bindGroupLayoutDescriptor);
+  return true;
+}
+
+wgpu::RenderPipeline create_pipeline(Term term, uint32_t msaaSamples, bool hasDepth, bool replace) noexcept {
+  const wgpu::BlendState blendState =
+      replace ? wgpu::BlendState{
+                    .color = {.operation = wgpu::BlendOperation::Add,
+                              .srcFactor = wgpu::BlendFactor::One,
+                              .dstFactor = wgpu::BlendFactor::Zero},
+                    .alpha = {.operation = wgpu::BlendOperation::Add,
+                              .srcFactor = wgpu::BlendFactor::Zero,
+                              .dstFactor = wgpu::BlendFactor::One},
+                }
+      : term == Term::Occlusion
+          ? wgpu::BlendState{
+                // dst * src: the shader's output is the occlusion multiplier.
+                .color = {.operation = wgpu::BlendOperation::Add,
+                          .srcFactor = wgpu::BlendFactor::Zero,
+                          .dstFactor = wgpu::BlendFactor::Src},
+                // The EFB's alpha is the game's; leave it exactly as it was.
+                .alpha = {.operation = wgpu::BlendOperation::Add,
+                          .srcFactor = wgpu::BlendFactor::Zero,
+                          .dstFactor = wgpu::BlendFactor::One},
+            }
+          : wgpu::BlendState{
+                .color = {.operation = wgpu::BlendOperation::Add,
+                          .srcFactor = wgpu::BlendFactor::One,
+                          .dstFactor = wgpu::BlendFactor::OneMinusSrcAlpha},
+                .alpha = {.operation = wgpu::BlendOperation::Add,
+                          .srcFactor = wgpu::BlendFactor::Zero,
+                          .dstFactor = wgpu::BlendFactor::One},
+            };
+  const wgpu::ColorTargetState colorTarget{
+      .format = g_graphicsConfig.surfaceConfiguration.format,
+      .blend = &blendState,
+      .writeMask = wgpu::ColorWriteMask::All,
+  };
+  const wgpu::FragmentState fragmentState{
+      .module = g_module,
+      .entryPoint = term == Term::Occlusion ? "fs_occlusion" : "fs_reflection",
+      .targetCount = 1,
+      .targets = &colorTarget,
+  };
+  // Never touches depth: this sits between the scene and the 2D layer, and the
+  // 2D draws that follow still need the depth the scene left behind.
+  const wgpu::DepthStencilState depthStencil{
+      .format = g_graphicsConfig.depthFormat,
+      .depthWriteEnabled = false,
+      .depthCompare = wgpu::CompareFunction::Always,
+  };
+  const wgpu::PipelineLayoutDescriptor layoutDescriptor{
+      .bindGroupLayoutCount = 1,
+      .bindGroupLayouts = &g_bindGroupLayout,
+  };
+  auto pipelineLayout = g_device.CreatePipelineLayout(&layoutDescriptor);
+  const wgpu::RenderPipelineDescriptor pipelineDescriptor{
+      .label = term == Term::Occlusion ? "RT Composite Occlusion Pipeline" : "RT Composite Reflection Pipeline",
+      .layout = pipelineLayout,
+      .vertex =
+          wgpu::VertexState{
+              .module = g_module,
+              .entryPoint = "vs_main",
+          },
+      .primitive =
+          wgpu::PrimitiveState{
+              .topology = wgpu::PrimitiveTopology::TriangleList,
+          },
+      .depthStencil = hasDepth ? &depthStencil : nullptr,
+      .multisample =
+          wgpu::MultisampleState{
+              .count = msaaSamples,
+              .mask = UINT32_MAX,
+          },
+      .fragment = &fragmentState,
+  };
+  return g_device.CreateRenderPipeline(&pipelineDescriptor);
+}
+
+// The views change when the trace resolution changes, which is rare; rebuilding
+// on identity rather than every frame keeps the allocation off the hot path.
+bool ensure_bind_group() noexcept {
+#ifdef _WIN32
+  if (!rt::interop::ensure_imported()) {
+    return false;
+  }
+  const wgpu::TextureView aoView = rt::interop::view();
+  const wgpu::TextureView reflView = rt::interop::reflection_view();
+  if (!aoView || !reflView) {
+    return false;
+  }
+  if (g_bindGroup && g_boundAo == aoView.Get() && g_boundReflection == reflView.Get()) {
+    return true;
+  }
+  const std::array entries{
+      wgpu::BindGroupEntry{.binding = 0, .textureView = aoView},
+      wgpu::BindGroupEntry{.binding = 1, .textureView = reflView},
+  };
+  const wgpu::BindGroupDescriptor descriptor{
+      .label = "RT Composite Bind Group",
+      .layout = g_bindGroupLayout,
+      .entryCount = entries.size(),
+      .entries = entries.data(),
+  };
+  g_bindGroup = g_device.CreateBindGroup(&descriptor);
+  g_boundAo = aoView.Get();
+  g_boundReflection = reflView.Get();
+  return g_bindGroup != nullptr;
+#else
+  return false;
+#endif
+}
+} // namespace
+
+bool prepare(uint32_t msaaSamples, bool hasDepth) noexcept {
+#ifdef _WIN32
+  if (!ensure_module()) {
+    return false;
+  }
+  const bool replace = rt::debug_mode() != 0u;
+  if (msaaSamples != g_pipelineSamples || hasDepth != g_pipelineDepth || replace != g_pipelineReplace ||
+      !g_occlusionPipeline) {
+    g_occlusionPipeline = create_pipeline(Term::Occlusion, msaaSamples, hasDepth, replace);
+    g_reflectionPipeline = create_pipeline(Term::Reflection, msaaSamples, hasDepth, false);
+    g_pipelineSamples = msaaSamples;
+    g_pipelineDepth = hasDepth;
+    g_pipelineReplace = replace;
+    if (!g_occlusionPipeline || !g_reflectionPipeline) {
+      Log.error("Failed to create the composition pipelines ({} samples, depth {})", msaaSamples, hasDepth);
+      return false;
+    }
+  }
+  return ensure_bind_group();
+#else
+  (void)msaaSamples;
+  (void)hasDepth;
+  return false;
+#endif
+}
+
+uint32_t g_drawsThisFrame = 0;
+uint32_t g_lastReportedDraws = 0;
+
+uint32_t take_draw_count() noexcept {
+  const uint32_t count = g_drawsThisFrame;
+  g_drawsThisFrame = 0;
+  return count;
+}
+
+void render(const wgpu::RenderPassEncoder& pass, const wgpu::Extent3D& targetSize) noexcept {
+  // prepare() ran before the pass was handed over, and publishing it to the
+  // worker is what orders these reads against those writes. Re-checked rather
+  // than assumed, because a failed prepare still leaves the command in place.
+  if (!g_occlusionPipeline || !g_reflectionPipeline || !g_bindGroup) {
+    return;
+  }
+
+  // The pass is mid-flight: the scene left its own viewport and scissor behind,
+  // and the caller puts both back once these two draws are recorded.
+  pass.SetViewport(0.f, 0.f, static_cast<float>(targetSize.width), static_cast<float>(targetSize.height), 0.f, 1.f);
+  pass.SetScissorRect(0, 0, targetSize.width, targetSize.height);
+  pass.SetBindGroup(0, g_bindGroup, 0, nullptr);
+  pass.SetPipeline(g_occlusionPipeline);
+  pass.Draw(3);
+  if (!g_pipelineReplace) {
+    // A diagnostic buffer has already replaced the frame; blending a reflection
+    // over it would only make it unreadable.
+    pass.SetPipeline(g_reflectionPipeline);
+    pass.Draw(3);
+  }
+  ++g_drawsThisFrame;
+}
+
+void shutdown() noexcept {
+  g_bindGroup = nullptr;
+  g_boundAo = nullptr;
+  g_boundReflection = nullptr;
+  g_occlusionPipeline = nullptr;
+  g_reflectionPipeline = nullptr;
+  g_bindGroupLayout = nullptr;
+  g_module = nullptr;
+  g_pipelineSamples = 0;
+}
+
+} // namespace aurora::gfx::rt_composite
