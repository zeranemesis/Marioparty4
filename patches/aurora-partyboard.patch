+
+// Runtime toggle, driven by the game's video settings. Kept as a plain setter so
+// the engine layer does not depend on the game's configuration types.
+void set_enabled(bool enabled) noexcept {
+  if (g_enabled == enabled) {
+    return;
+  }
+  g_enabled = enabled;
+  Log.info("Ray traced AO {}", enabled ? "enabled" : "disabled");
+  if (!enabled) {
+    // Drop the imported texture and restore the white fallback, otherwise the
+    // last frame traced would stay multiplied over everything.
+    interop::shutdown();
+    webgpu::refresh_copy_bind_group();
+#ifdef AURORA_ENABLE_RMLUI
+    rmlui::refresh_copy_bind_group();
+#endif
+    g_composited = false;
+  }
+}
+
+bool enabled() noexcept { return g_enabled; }
+
+void set_quality(int level) noexcept {
+  const int clamped = level < 0 ? 0 : (level >= kQualityCount ? kQualityCount - 1 : level);
+  if (clamped == g_quality) {
+    return;
+  }
+  g_quality = clamped;
+  const QualityLevel& q = kQualityLevels[clamped];
+  if (!g_scaleFromEnv) {
+    g_traceScale = q.scale;
+  }
+  if (!g_samplesFromEnv) {
+    g_samples = q.aoSamples;
+  }
+  if (!g_shadowSamplesFromEnv) {
+    g_shadowSamples = q.shadowSamples;
+  }
+  Log.info("Ray tracing quality {}: scale {:.2f}, {} AO samples, {} shadow samples", clamped,
+           g_traceScale, g_samples, g_shadowSamples);
+}
+
+int quality_levels() noexcept { return kQualityCount; }
+
+void set_features(bool ambientOcclusion, bool shadows, bool reflections) noexcept {
+  const uint32_t features = (ambientOcclusion ? trace::FeatureAmbientOcclusion : 0u) |
+                            (shadows ? trace::FeatureShadows : 0u) |
+                            (reflections ? trace::FeatureReflections : 0u);
+  if (features == g_features) {
+    return;
+  }
+  g_features = features;
+  Log.info("Ray tracing terms: ambient occlusion {}, shadows {}, reflections {}",
+           ambientOcclusion ? "on" : "off", shadows ? "on" : "off",
+           reflections ? "on" : "off");
+}
+
+void begin_frame() noexcept {
+  static bool read = false;
+  if (!read) {
+    read = true;
+    if (const char* env = std::getenv("AURORA_RT_DUMP_FRAME")) {
+      g_dumpFrame = std::atoi(env);
+      Log.info("Geometry capture armed for frame {}", g_dumpFrame);
+    }
+    if (const char* env = std::getenv("AURORA_RT_ALPHA_TEST")) {
+      g_alphaTest = env[0] != '0';
+      Log.info("Alpha testing of see-through surfaces {}", g_alphaTest ? "on" : "off");
+    }
+    if (const char* env = std::getenv("AURORA_RT_TEV_TEXTURES")) {
+      g_tevTextures = env[0] != '0';
+      Log.info("Textures read as the TEV stages combine them {}", g_tevTextures ? "on" : "off");
+    }
+    if (const char* env = std::getenv("AURORA_RT_ADDITIVE")) {
+      g_skipAdditive = env[0] != '0';
+      Log.info("Additive surfaces {}", g_skipAdditive ? "left out of the rays" : "traced");
+    }
+    if (const char* env = std::getenv("AURORA_RT_SHADOW_STRATIFY")) {
+      g_stratifiedShadow = env[0] != '0';
+      Log.info("Shadow disc sampled {}", g_stratifiedShadow ? "in strata" : "by white noise");
+    }
+    if (const char* env = std::getenv("AURORA_RT_SEQUENCE")) {
+      const int frames = std::atoi(env);
+      g_sequenceFrames = frames <= 0 ? 0u : static_cast<uint32_t>(frames > 240 ? 240 : frames);
+      if (g_sequenceFrames > 0 && std::getenv("AURORA_RT_AB") != nullptr) {
+        // The pair's single-frame traces would break the accumulation the
+        // sequence is there to record.
+        Log.warn("AURORA_RT_SEQUENCE is ignored alongside AURORA_RT_AB");
+        g_sequenceFrames = 0;
+      }
+      if (g_sequenceFrames > 0) {
+        Log.info("Sequence dump of {} frames once armed by rt_ab_arm", g_sequenceFrames);
+      }
+    }
+    if (const char* env = std::getenv("AURORA_RT_SEQUENCE_REF")) {
+      const int samples = std::atoi(env);
+      g_sequenceReference = samples <= 0 ? 0u : static_cast<uint32_t>(samples > 256 ? 256 : samples);
+      if (g_sequenceReference > 0) {
+        Log.info("Each sequence frame also traced at {} samples as a reference",
+                 g_sequenceReference);
+      }
+    }
+    if (const char* env = std::getenv("AURORA_RT_AB")) {
+      static constexpr const char* kAbNames[] = {"aoSamples", "shadowSamples", "lightRadius",
+                                                 "aoRadius",  "bounce",        "denoisePhi",
+                                                 "denoisePasses", "debugMode", "alphaTest",
+                                                 "additive", "shadowStratify"};
+      bool known = false;
+      if (const char* eq = std::strchr(env, '='); eq != nullptr) {
+        const std::string name(env, eq);
+        for (const char* candidate : kAbNames) {
+          known = known || name == candidate;
+        }
+        if (known) {
+          g_abName = name;
+          g_abValue = std::atof(eq + 1);
+        }
+      }
+      if (known) {
+        Log.info("A/B bench armed: the dump frame is traced twice, B with {}={} "
+                 "(needs AURORA_RT_DUMP_FRAME or AURORA_RT_DUMP_MIN_TRIS)", g_abName, g_abValue);
+      } else {
+        Log.warn("AURORA_RT_AB ignored: expected name=value, name one of aoSamples, shadowSamples, "
+                 "lightRadius, aoRadius, bounce, denoisePhi, denoisePasses, debugMode, alphaTest, "
+                 "additive, shadowStratify");
+      }
+    }
+    // Frame numbers are a poor handle: the counter runs uncapped through boot,
+    // so a fixed index lands on a 2D loading screen. This arms every frame and
+    // dumps the first one carrying real geometry instead.
+    if (const char* env = std::getenv("AURORA_RT_DUMP_MIN_TRIS")) {
+      g_minTriangles = std::atoi(env);
+      Log.info("Geometry capture armed for the first frame with >= {} triangles", g_minTriangles);
+    }
+    if (const char* env = std::getenv("AURORA_RT_AO_SAMPLES")) {
+      g_samples = static_cast<uint32_t>(std::atoi(env));
+      g_samplesFromEnv = true;
+    }
+    if (const char* env = std::getenv("AURORA_RT_AO_RADIUS")) {
+      g_radius = static_cast<float>(std::atof(env));
+    }
+    if (const char* env = std::getenv("AURORA_RT_LIGHT_RADIUS")) {
+      g_lightRadius = static_cast<float>(std::atof(env));
+    }
+    if (const char* env = std::getenv("AURORA_RT_SHADOW_RANGE")) {
+      g_shadowRangeFactor = static_cast<float>(std::atof(env));
+    }
+    if (const char* env = std::getenv("AURORA_RT_TRACE_SCALE")) {
+      g_traceScale = static_cast<float>(std::atof(env));
+      g_scaleFromEnv = true;
+      Log.info("Trace resolution scale {:.2f}", g_traceScale);
+    }
+    if (const char* env = std::getenv("AURORA_RT_COMPOSITE")) {
+      g_compositeInPass = std::strcmp(env, "present") != 0;
+      g_maskEnabled = !g_compositeInPass;
+      Log.info("Composition {}", g_compositeInPass ? "inside the pass, before the 2D layer"
+                                                   : "over the finished frame, with the 2D mask");
+    }
+    if (const char* env = std::getenv("AURORA_RT_ORTHO_MASK")) {
+      g_maskEnabled = env[0] != '0';
+      Log.info("Orthographic coverage mask {}", g_maskEnabled ? "on" : "off");
+    }
+    if (const char* env = std::getenv("AURORA_RT_BOUNCE")) {
+      g_bounce = static_cast<float>(std::atof(env));
+    }
+    if (const char* env = std::getenv("AURORA_RT_NO_TRACE")) {
+      g_noTrace = env[0] != '0';
+      if (g_noTrace) {
+        Log.info("Tracing skipped: structures are still built every frame");
+      }
+    }
+    if (const char* env = std::getenv("AURORA_RT_INSTANCES")) {
+      g_useInstances = env[0] != '0';
+      if (!g_useInstances) {
+        Log.info("Per-draw instancing disabled: the whole scene baked into one group");
+      }
+    }
+    if (const char* env = std::getenv("AURORA_RT_SHADOW_SAMPLES")) {
+      const int count = std::atoi(env);
+      g_shadowSamples = count <= 0 ? 1u : static_cast<uint32_t>(count);
+      g_shadowSamplesFromEnv = true;
+    }
+    if (const char* env = std::getenv("AURORA_RT_DEBUG_MODE")) {
+      const int mode = std::atoi(env);
+      g_debugMode = mode < 0 ? 0u : static_cast<uint32_t>(mode);
+      if (g_debugMode != 0u) {
+        static constexpr const char* kNames[] = {
+            "off",        "shadow",   "occlusion", "normals",   "depth",   "primitive id",
+            "material",   "reflection", "texcoord", "mask",     "screen uv", "history",
+            "thumbnail"};
+        const uint32_t named = sizeof(kNames) / sizeof(kNames[0]);
+        Log.info("Ray tracing diagnostic view: {} ({})", g_debugMode,
+                 g_debugMode < named ? kNames[g_debugMode] : "unknown");
+      }
+    }
+    if (const char* env = std::getenv("AURORA_RT_BUILD_FRAMES")) {
+      g_buildFrames = std::atoi(env);
+      Log.info("Reporting acceleration structure timing over {} builds", g_buildFrames);
+    }
+  }
+
+  const bool debugCapture = (g_dumpFrame >= 0 && static_cast<int32_t>(g_frameIndex) == g_dumpFrame) ||
+                            (g_minTriangles > 0 && !g_dumped);
+  g_armed = g_enabled || debugCapture;
+  if (g_armed) {
+    g_triangles.clear();
+    g_normals.clear();
+    g_texcoords.clear();
+    g_materials.clear();
+    g_groups.clear();
+    g_contentHash = 0xcbf29ce484222325ull; // FNV-1a offset basis
+    g_viewHash = 0xcbf29ce484222325ull;
+    g_haveReference = false;
+    g_prevDrawHashes.swap(g_drawHashes);
+    g_prevDrawTriangles.swap(g_drawTriangles);
+    g_drawHashes.clear();
+    g_drawTriangles.clear();
+    g_colours.clear();
+    g_drawsSeen = 0;
+    g_projSwitches = 0;
+    g_backToPerspective = 0;
+    g_firstOrthoDraw = 0;
+    g_lastSwitchDraw = 0;
+    g_orthoBeforeLast = 0;
+    g_perspAfterLast = 0;
+    g_lastDrawOrtho = false;
+    g_drawsBlended = 0;
+    g_drawsAdditive = 0;
+    for (uint32_t& bucket : g_opacityHistogram) {
+      bucket = 0;
+    }
+    g_drawsAlphaTested = 0;
+    g_drawsReflective = 0;
+    g_drawsSingularMatrix = 0;
+    g_skippedDraws = 0;
+    g_orthoDrawsSkipped = 0;
+    g_orthoFullscreen = 0;
+    g_orthoBounded = 0;
+    g_orthoBoundedArea = 0.0;
+    g_drawsWithColour = 0;
+    g_drawsWithTexture = 0;
+    g_drawsWithTexcoords = 0;
+    g_haveUv = false;
+    g_coverageMoved = 0;
+    g_texgenMatrix = 0;
+    g_texgenPostMatrix = 0;
+    g_texgenOtherSource = 0;
+    g_texgenUnusable = 0;
+    g_sampledOtherUnit = 0;
+    g_staleUnit0 = 0;
+    g_albedoSaturation = 0.0;
+    g_drawsTotal = 0;
+    g_haveProj = false;
+    g_projections.clear();
+    std::fill(g_orthoMask.begin(), g_orthoMask.end(), 0u);
+    g_lightWeight = 0.f;
+    g_light[3] = 0.f;
+    g_haveBounds = false;
+  }
+}
+
+namespace {
+void dump_obj() noexcept {
+  const char* path = "rt_frame.obj";
+  FILE* f = std::fopen(path, "wb");
+  if (f == nullptr) {
+    Log.error("Failed to open {} for writing", path);
+    return;
+  }
+  std::fprintf(f, "# PartyBoard ray tracing geometry capture, frame %u\n", g_frameIndex);
+  std::fprintf(f, "# %zu triangles, view space\n", g_triangles.size() / 3);
+  for (const auto& v : g_triangles) {
+    std::fprintf(f, "v %.6f %.6f %.6f\n", v.x, v.y, v.z);
+  }
+  for (size_t i = 0; i < g_triangles.size(); i += 3) {
+    std::fprintf(f, "f %zu %zu %zu\n", i + 1, i + 2, i + 3);
+  }
+  std::fclose(f);
+  Log.info("Captured {} triangles to {} ({} draws skipped, {} orthographic draws excluded)",
+           g_triangles.size() / 3, path, g_skippedDraws, g_orthoDrawsSkipped);
+}
+
+void record_build_time(double ms) noexcept {
+  if (g_buildsDone == 0 || ms < g_buildMsMin) {
+    g_buildMsMin = ms;
+  }
+  if (ms > g_buildMsMax) {
+    g_buildMsMax = ms;
+  }
+  g_buildMsTotal += ms;
+  ++g_buildsDone;
+  if (g_buildFrames > 0 && g_buildsDone == g_buildFrames) {
+    Log.info("Steady-state rebuild over {} frames: min {:.2f} ms, avg {:.2f} ms, max {:.2f} ms",
+             g_buildsDone, g_buildMsMin, g_buildMsTotal / g_buildsDone, g_buildMsMax);
+  }
+}
+} // namespace
+
+void end_frame() noexcept {
+  ++g_endFrameCalls;
+  if (!g_armed) {
+    ++g_frameIndex;
+    return;
+  }
+  g_armed = false;
+
+  // A frame with no perspective geometry is a menu or a loading screen. Leave
+  // the previous acceleration structures alone rather than tracing an empty
+  // scene, which would black out the image.
+  if (g_triangles.empty() || !g_haveProj) {
+    ++g_frameIndex;
+    return;
+  }
+
+  // A/B bench armed from outside: the test script creates rt_ab_arm in the
+  // working directory once the scene it drove to is up. A triangle threshold
+  // cannot pick that frame -- the title sequence traces 53 512 triangles, more
+  // than any board, and the first pair landed there -- and a frame number
+  // drifts with every menu timing. Polled every 30 frames, and only while a
+  // pair is still wanted.
+  // A sequence is armed the same way.
+  if ((!g_abName.empty() || g_sequenceFrames > 0) && !g_abArmed && !g_dumped &&
+      (g_frameIndex % 30u) == 0u) {
+    std::error_code missing;
+    if (std::filesystem::exists("rt_ab_arm", missing)) {
+      g_abArmed = true;
+      Log.info("A/B bench armed by rt_ab_arm at frame {}", g_frameIndex);
+    }
+  }
+
+  // Debug dump, once, when a threshold, a frame index or the A/B bench asked.
+  const bool wantDump = !g_dumped &&
+                        (g_minTriangles > 0 || g_dumpFrame >= 0 || (g_abArmed && !g_abName.empty())) &&
+                        static_cast<int32_t>(g_triangles.size() / 3) >= g_minTriangles;
+  if (wantDump) {
+    g_dumped = true;
+    dump_obj();
+  }
+
+  // The build grows the vertex, colour, normal and material buffers, and the
+  // structures themselves, whenever the scene outgrows what is allocated -- and
+  // growing one means releasing the old one. Last frame's trace reads every one
+  // of them and is still running, so it has to finish first. This is what made
+  // entering a screen bigger than the menus a device removal rather than a
+  // slower frame: the menus never grew the buffers, so nothing was ever freed
+  // underneath the dispatch until the scene got larger.
+  trace::wait_idle();
+
+  ++g_buildCalls;
+  if (!accel::build(reinterpret_cast<const float*>(g_triangles.data()),
+                    reinterpret_cast<const float*>(g_colours.data()),
+                    reinterpret_cast<const float*>(g_normals.data()),
+                    reinterpret_cast<const float*>(g_texcoords.data()), g_materials.data(),
+                    g_triangles.size(), g_contentHash, g_groups.data(), g_groups.size())) {
+    Log.error("Acceleration structure build failed");
+    report_device_removal();
+    ++g_frameIndex;
+    return;
+  }
+  report_device_removal();
+  record_build_time(accel::stats().buildMs);
+
+  const bool firstTrace = !g_composited;
+  // Trace at the game's own render resolution rather than a fixed 640x480: the
+  // result is point-sampled at composition time, so a lower resolution shows up
+  // directly as blocky occlusion. Clamped so an oversized window cannot make the
+  // per-frame cost run away.
+  constexpr uint32_t kMaxTraceDim = 1920;
+  const auto& renderTarget = webgpu::present_source();
+  uint32_t traceWidth = renderTarget.size.width != 0 ? renderTarget.size.width : 640;
+  uint32_t traceHeight = renderTarget.size.height != 0 ? renderTarget.size.height : 480;
+
+  // The scale is a fraction of what reaches the screen, not of the internal
+  // render target. It used to be the latter, which tied the definition of the
+  // ray tracing to a setting that has nothing to do with it: the same "0.5"
+  // meant 1280x960 at Internal Resolution 4 and 320x240 at 1, so the quality
+  // level said nothing on its own.
+  //
+  // One trace texel per displayed pixel is the right target, measured rather
+  // than assumed. Sharpest step the shadow buffer can produce, and the grain
+  // left in it, on w01Dll into a 1272x958 window:
+  //   640x480   (0.5x)  sharpness 0.43  grain 0.0076  0.59 ms
+  //   1280x960  (1.0x)  sharpness 0.67  grain 0.0095  1.78 ms
+  //   1920x1440 (1.5x)  sharpness 0.63  grain 0.0179  4.28 ms
+  // Below one, edges are visibly soft. Above it, they are no sharper and the
+  // noise more than doubles: the frame is resolved down to the window anyway,
+  // so a texel finer than a pixel averages fewer samples into what is shown and
+  // the filter's fixed pixel radius covers less of the image. So the ladder
+  // stops at 1.0 and buys rays past that instead.
+  const auto windowSize = window::get_window_size();
+  const uint32_t presented = windowSize.native_fb_height != 0 ? windowSize.native_fb_height
+                                                              : windowSize.fb_height;
+  float ratio = g_traceScale;
+  if (presented != 0 && traceHeight != 0) {
+    // Against the render target's own height, so the trace keeps its aspect
+    // ratio whatever letterboxing sits between the two.
+    ratio = static_cast<float>(presented) * g_traceScale / static_cast<float>(traceHeight);
+  }
+  // Never more than the render target: there is no detail past it to resolve.
+  ratio = ratio > 1.f ? 1.f : ratio;
+  if (ratio > 0.f && ratio < 1.f) {
+    traceWidth = static_cast<uint32_t>(static_cast<float>(traceWidth) * ratio);
+    traceHeight = static_cast<uint32_t>(static_cast<float>(traceHeight) * ratio);
+  }
+  // A cost ceiling, not a quality choice: on a display large enough to reach it
+  // the trace falls back below one texel per pixel rather than running away.
+  if (traceWidth > kMaxTraceDim) {
+    traceHeight = traceHeight * kMaxTraceDim / traceWidth;
+    traceWidth = kMaxTraceDim;
+  }
+  traceWidth = traceWidth < 64u ? 64u : traceWidth;
+  traceHeight = traceHeight < 64u ? 64u : traceHeight;
+
+  // Derive the radii from the scene's own diagonal so the same settings work on
+  // a title screen and on a game board.
+  float aoRadius = g_radius;
+  // An angle, so unlike the AO radius it does not scale with the scene.
+  float lightRadius = g_lightRadius > 0.f ? g_lightRadius : kLightAngularRadius;
+  float shadowRange = 1.e6f;
+  if (g_haveBounds) {
+    const float dx = g_boundsMax[0] - g_boundsMin[0];
+    const float dy = g_boundsMax[1] - g_boundsMin[1];
+    const float dz = g_boundsMax[2] - g_boundsMin[2];
+    const float diagonal = std::sqrt(dx * dx + dy * dy + dz * dz);
+    // Positions are screened before they reach the bounds, so this should not
+    // fire. It stays as the second line because what it guards is the reach of
+    // every occlusion and shadow ray, and a NaN there is outside what DXR
+    // defines for a ray. The last usable scene size is kept rather than
+    // inventing one; the test scripts still fail on the extent printed below,
+    // because this firing means the first line did not hold.
+    const bool usableDiagonal = std::isfinite(diagonal);
+    if (usableDiagonal) {
+      g_lastGoodDiagonal = diagonal;
+    } else {
+      ++g_unusableBoundsFrames;
+    }
+    if (usableDiagonal || g_lastGoodDiagonal > 0.f) {
+      const float sceneSize = usableDiagonal ? diagonal : g_lastGoodDiagonal;
+      if (aoRadius <= 0.f) {
+        aoRadius = sceneSize * kAoRadiusFraction;
+      }
+      shadowRange = sceneSize * g_shadowRangeFactor;
+    }
+  }
+
+  // How the camera moved since the last frame, measured from the geometry
+  // itself. Everything is captured in view space, so a group that did not move
+  // differs from its last frame only by the camera: this frame's transform
+  // inverted, composed with the previous frame's, is that motion. Groups that
+  // did move give a different answer, so the median over the groups decides --
+  // it asks that the still ones be the majority, and where they are not, the
+  // guide test in the temporal pass rejects what the reprojection brought back.
+  g_haveViewDelta = false;
+  if (g_prevGroups.size() == g_groups.size() && !g_groups.empty()) {
+    std::vector<std::array<float, 12>> candidates;
+    candidates.reserve(g_groups.size());
+    for (size_t i = 0; i < g_groups.size(); ++i) {
+      if (g_groups[i].triangleCount != g_prevGroups[i].triangleCount) {
+        continue;
+      }
+      float inverse[12];
+      if (!invert_affine(g_groups[i].transform, inverse)) {
+        continue;
+      }
+      std::array<float, 12> delta{};
+      compose_affine(g_prevGroups[i].transform, inverse, delta.data());
+      bool finite = true;
+      for (const float value : delta) {
+        finite = finite && std::isfinite(value);
+      }
+      if (finite) {
+        candidates.push_back(delta);
+      }
+    }
+    if (candidates.size() >= 4) {
+      for (uint32_t component = 0; component < 12; ++component) {
+        std::vector<float> column;
+        column.reserve(candidates.size());
+        for (const auto& candidate : candidates) {
+          column.push_back(candidate[component]);
+        }
+        const size_t middle = column.size() / 2;
+        std::nth_element(column.begin(), column.begin() + middle, column.end());
+        g_viewDelta[component] = column[middle];
+      }
+      g_haveViewDelta = true;
+    }
+  }
+  ++g_framesTraced;
+  if (g_haveViewDelta) {
+    ++g_framesWithDelta;
+  }
+
+  // Did the camera move while the geometry stayed put? That is the case the
+  // reference-space baking exists for, and the only honest way to know whether
+  // it earns its complexity on a given scene.
+  if (g_frameIndex > 0 && rt_debug_logging()) {
+    if (g_viewHash != g_prevViewHash && g_contentHash == g_prevContentHash) {
+      ++g_framesCameraOnly;
+    }
+    if (g_contentHash != g_prevContentHash) {
+      ++g_framesReferenceMoved;
+    }
+  }
+  g_prevViewHash = g_viewHash;
+  g_prevContentHash = g_contentHash;
+  g_prevGroups = g_groups;
+  std::memcpy(g_prevProjParams, g_projParams, sizeof(g_prevProjParams));
+  g_havePrevProj = g_haveProj;
+
+  // How much of the scene is actually in motion. Draws are keyed by their
+  // position in the frame, which holds while the game issues them in a stable
+  // order; a differing draw count voids the comparison rather than skewing it.
+  if (rt_debug_logging() && g_drawHashes.size() == g_prevDrawHashes.size()) {
+    for (size_t i = 0; i < g_drawHashes.size(); ++i) {
+      if (g_drawHashes[i] == g_prevDrawHashes[i] &&
+          g_drawTriangles[i] == g_prevDrawTriangles[i]) {
+        g_staticTriangles += g_drawTriangles[i];
+      } else {
+        g_movingTriangles += g_drawTriangles[i];
+      }
+    }
+  }
+
+  if (g_noTrace) {
+    ++g_frameIndex;
+    return;
+  }
+
+  // One projection has to stand for the whole screen, so it is the one covering
+  // the most geometry rather than whichever draw came last. Where a frame uses
+  // only one -- which is the common case -- this picks that one and changes
+  // nothing.
+  if (g_projections.size() > g_maxProjections) {
+    g_maxProjections = g_projections.size();
+  }
+  const float* chosenProj = g_projParams;
+  if (!g_projections.empty()) {
+    size_t best = 0;
+    for (size_t i = 1; i < g_projections.size(); ++i) {
+      if (g_projections[i].triangles > g_projections[best].triangles) {
+        best = i;
+      }
+    }
+    chosenProj = g_projections[best].params;
+  }
+
+  trace::TraceParams params;
+  params.width = traceWidth;
+  params.height = traceHeight;
+  std::memcpy(params.proj, chosenProj, sizeof(params.proj));
+  std::memcpy(params.light, g_light, sizeof(params.light));
+  params.lightRadius = lightRadius;
+  params.shadowRange = shadowRange;
+  params.bounceStrength = g_bounce;
+  params.aoRadius = aoRadius;
+  params.aoSamples = g_samples;
+  params.shadowSamples = g_shadowSamples;
+  params.features = g_features | (g_alphaTest ? trace::FeatureAlphaTest : 0u) |
+                    (g_skipAdditive ? trace::FeatureSkipAdditive : 0u) |
+                    (g_stratifiedShadow ? trace::FeatureStratifiedShadow : 0u);
+  std::memcpy(params.viewDelta, g_viewDelta, sizeof(params.viewDelta));
+  std::memcpy(params.prevProj, g_prevProjParams, sizeof(params.prevProj));
+  params.haveViewDelta = g_haveViewDelta && g_havePrevProj;
+  params.reflectionRange = shadowRange; // the scene's own size bounds both
+  params.debugMode = g_debugMode;
+  if (g_maskEnabled) {
+    params.orthoMask = g_orthoMask.data();
+    params.maskCols = kMaskCols;
+    params.maskRows = kMaskRows;
+    size_t covered = 0;
+    for (const uint32_t tile : g_orthoMask) {
+      covered += tile != 0u ? 1u : 0u;
+    }
+    g_maskCoverage = static_cast<double>(covered) / static_cast<double>(g_orthoMask.size());
+  }
+  // A/B bench: B first, as a side trace that advances nothing, so that A -- the
+  // normal setting -- is what gets displayed and what the history keeps. Both
+  // are single-frame: the same sampling pattern and no accumulation, so the two
+  // buffers differ by the setting and by nothing else. It compares estimates of
+  // one frame, not accumulation settings.
+  const bool abPair = wantDump && !g_abName.empty();
+  if (abPair) {
+    params.singleFrame = true;
+    trace::TraceParams probe = params;
+    probe.advanceState = false;
+    const double value = g_abValue;
+    if (g_abName == "aoSamples") {
+      probe.aoSamples = static_cast<uint32_t>(value);
+    } else if (g_abName == "shadowSamples") {
+      probe.shadowSamples = static_cast<uint32_t>(value);
+    } else if (g_abName == "lightRadius") {
+      probe.lightRadius = static_cast<float>(value);
+    } else if (g_abName == "aoRadius") {
+      probe.aoRadius = static_cast<float>(value);
+    } else if (g_abName == "bounce") {
+      probe.bounceStrength = static_cast<float>(value);
+    } else if (g_abName == "denoisePhi") {
+      probe.luminancePhi = static_cast<float>(value);
+    } else if (g_abName == "denoisePasses") {
+      probe.denoisePasses = static_cast<int32_t>(value);
+    } else if (g_abName == "debugMode") {
+      probe.debugMode = static_cast<uint32_t>(value);
+    } else if (g_abName == "alphaTest") {
+      probe.features = value != 0.0 ? (probe.features | trace::FeatureAlphaTest)
+                                    : (probe.features & ~static_cast<uint32_t>(trace::FeatureAlphaTest));
+    } else if (g_abName == "additive") {
+      probe.features = value != 0.0
+                           ? (probe.features | trace::FeatureSkipAdditive)
+                           : (probe.features & ~static_cast<uint32_t>(trace::FeatureSkipAdditive));
+    } else if (g_abName == "shadowStratify") {
+      probe.features =
+          value != 0.0 ? (probe.features | trace::FeatureStratifiedShadow)
+                       : (probe.features & ~static_cast<uint32_t>(trace::FeatureStratifiedShadow));
+    }
+    if (!trace::run(probe, "rt_ab_b.pfm")) {
+      Log.error("A/B bench: the B trace failed");
+    }
+    report_device_removal();
+  }
+  const char* dumpPath = wantDump ? (abPair ? "rt_ab_a.pfm" : "rt_ao.bmp") : nullptr;
+  // A sequence frame is the normal trace, accumulation and all, read back.
+  const bool sequenceFrame = dumpPath == nullptr && g_abArmed && g_abName.empty() &&
+                             g_sequenceWritten < g_sequenceFrames;
+  char sequencePath[24];
+  if (sequenceFrame) {
+    if (g_sequenceWritten == 0) {
+      g_sequenceStart = g_frameIndex;
+    }
+    std::snprintf(sequencePath, sizeof(sequencePath), "rt_seq_%03u.pfm", g_sequenceWritten);
+    dumpPath = sequencePath;
+  }
+  // The converged reference for this frame, before the frame's own pass so that
+  // what is displayed and what the history keeps is the normal one. Many
+  // samples, one frame, no accumulation and no filter: the error of the
+  // displayed frame against it counts the noise and the lag together, which the
+  // spread from frame to frame cannot separate.
+  if (sequenceFrame && g_sequenceReference > 0u) {
+    trace::TraceParams reference = params;
+    reference.advanceState = false;
+    reference.singleFrame = true;
+    reference.denoisePasses = 0;
+    reference.aoSamples = g_sequenceReference;
+    reference.shadowSamples = g_sequenceReference;
+    char referencePath[28];
+    std::snprintf(referencePath, sizeof(referencePath), "rt_seq_ref_%03u.pfm", g_sequenceWritten);
+    if (!trace::run(reference, referencePath)) {
+      Log.error("Sequence reference trace failed");
+    }
+    report_device_removal();
+  }
+  if (!trace::run(params, dumpPath)) {
+    Log.error("Ray traced AO pass failed");
+    report_device_removal();
+    ++g_frameIndex;
+    return;
+  }
+  report_device_removal();
+  if (sequenceFrame && ++g_sequenceWritten == g_sequenceFrames) {
+    Log.info("Sequence written: {} frames, rt_seq_000.pfm to rt_seq_{:03}.pfm, {}x{}, from frame {}",
+             g_sequenceFrames, g_sequenceFrames - 1, params.width, params.height, g_sequenceStart);
+    if (g_sequenceReference > 0u) {
+      Log.info("A reference beside each: rt_seq_ref_000.pfm to rt_seq_ref_{:03}.pfm, {} samples, "
+               "unfiltered",
+               g_sequenceFrames - 1, g_sequenceReference);
+    }
+  }
+  if (abPair) {
+    Log.info("A/B pair written: rt_ab_a.pfm and rt_ab_b.pfm, {}x{}, {} triangles, B with {}={}",
+             params.width, params.height, g_triangles.size() / 3, g_abName, g_abValue);
+  }
+
+  // The copy bind groups are otherwise built long before this texture exists.
+  if (interop::ensure_imported()) {
+    interop::begin_access();
+    if (!g_composited) {
+      webgpu::refresh_copy_bind_group();
+#ifdef AURORA_ENABLE_RMLUI
+      // While the RmlUi overlay is up the present pass uses its cached bind
+      // group instead of the one above, so that one needs rebuilding too.
+      rmlui::refresh_copy_bind_group();
+#endif
+      g_composited = true;
+    }
+  }
+
+  // The one-shot report says nothing about how the scene grows once the game
+  // settles. Under AURORA_RT_DEBUG, repeat it periodically so a capture that
+  // is quietly dropping geometry is visible rather than inferred.
+  if (firstTrace || (rt_debug_logging() && (g_frameIndex % 300u) == 0u)) {
+    const auto& s = accel::stats();
+    const auto& t = trace::stats();
+    // Report the terms that actually ran, not merely whether a light exists:
+    // the old wording said "shadows on" even with the shadow term switched off.
+    const bool aoOn = (g_features & trace::FeatureAmbientOcclusion) != 0u;
+    const bool shadowsOn = (g_features & trace::FeatureShadows) != 0u;
+    Log.info("Ray tracing active: {} triangles, BLAS {} KB, build {} ms, "
+             "{}x{} {:.2f} ms GPU (+{:.2f} ms CPU); AO {}, shadows {}, reflections {}",
+             s.triangleCount, s.blasBytes / 1024,
+             s.reusedThisFrame ? std::string("reused, 0.00")
+                               : std::to_string(s.buildMs).substr(0, 4),
+             t.width, t.height, t.traceMs, t.submitMs,
+             aoOn ? std::to_string(t.sampleCount) + " samples" : std::string("off"),
+             !shadowsOn                ? "off"
+             : g_light[3] > 0.f       ? std::to_string(g_shadowSamples) + " samples"
+                                      : std::string("no light"),
+             (g_features & trace::FeatureReflections) != 0u ? "on" : "off");
+    Log.info("Texture coordinates on {} of {} draws; range {:.2f}..{:.2f}; {} thumbnails "
+             "registered",
+             g_drawsWithTexcoords, g_drawsTotal, g_uvMin, g_uvMax, textures::count() - 1);
+    Log.info("Textures read as the TEV stages combine them ({}): {} draws classified from "
+             "another map than the most transparent one named; the map read through a texture "
+             "matrix on {}, a post-transform matrix on {}, another source than TEX0 on {}; {} not "
+             "reproducible, traced without a thumbnail; {} reading another unit than 0; {} naming "
+             "no map at all, which the old reading gave unit 0's texture",
+             g_tevTextures ? "on" : "off", g_coverageMoved, g_texgenMatrix, g_texgenPostMatrix,
+             g_texgenOtherSource, g_texgenUnusable, g_sampledOtherUnit, g_staleUnit0);
+    Log.info("Albedo sources: {} textured, {} vertex-coloured, of {} draws; mean saturation {:.3f}",
+             g_drawsWithTexture, g_drawsWithColour, g_drawsTotal,
+             g_drawsWithTexture > 0 ? g_albedoSaturation / g_drawsWithTexture : 0.0);
+    // Rejections, so a scene that traces far less than it draws is visible here
+    // rather than having to be inferred from a triangle count.
+    Log.info("Draws seen by the hook: {}; rejected: {} unsupported layout, {} orthographic",
+             g_drawsSeen, g_skippedDraws, g_orthoDrawsSkipped);
+    Log.info("Positions rejected as non-finite or out of range: {} triangles since start; "
+             "frames that fell back to the last usable scene size: {}",
+             g_rejectedTriangles, g_unusableBoundsFrames);
+    Log.info("See-through draws by mean alpha (tenths, 0.0-0.1 first): "
+             "{} {} {} {} {} {} {} {} {} {}",
+             g_opacityHistogram[0], g_opacityHistogram[1], g_opacityHistogram[2],
+             g_opacityHistogram[3], g_opacityHistogram[4], g_opacityHistogram[5],
+             g_opacityHistogram[6], g_opacityHistogram[7], g_opacityHistogram[8],
+             g_opacityHistogram[9]);
+    Log.info("Projection layout: {} 3D->2D switches, {} 2D->3D returns, first 2D draw at {} of {}",
+             g_projSwitches, g_backToPerspective, g_firstOrthoDraw, g_drawsSeen);
+    Log.info("Composition ran {} time(s) since the last report; {} further passes were "
+             "eligible and skipped",
+             gfx::rt_composite::take_draw_count(), gfx::rt_composite_skipped());
+    Log.info("Last 3D->2D boundary at draw {} of {}: {} of {} 2D draws precede it, "
+             "{} 3D draws follow it",
+             g_lastSwitchDraw, g_drawsSeen, g_orthoBeforeLast, g_orthoDrawsSkipped,
+             g_perspAfterLast);
+    // Near 100% would mean the mask has switched the whole effect off rather
+    // than protecting the interface, which is the failure worth noticing.
+    Log.info("Orthographic coverage: {:.1f}% of the screen left unshaded ({}); {} full-screen "
+             "2D draws, {} bounded ones averaging {:.1f}% of the screen",
+             100.0 * g_maskCoverage, g_maskEnabled ? "mask on" : "mask off", g_orthoFullscreen,
+             g_orthoBounded,
+             g_orthoBounded > 0 ? 100.0 * g_orthoBoundedArea / g_orthoBounded : 0.0);
+    Log.info("end_frame calls {}, acceleration builds {}", g_endFrameCalls, g_buildCalls);
+    // Every one of these is a frame that would have reset the command allocator
+    // or freed a buffer while the GPU was still reading it.
+    Log.info("Trace still running when the next build wanted its buffers: {} times, {:.1f} ms "
+             "waited in total",
+             t.waitedFrames, t.waitedMs);
+    Log.info("Acceleration structure reused on {} of {} frames; {} camera-only, "
+             "{} with geometry that actually moved",
+             accel::stats().reusedFrames, g_frameIndex + 1, g_framesCameraOnly,
+             g_framesReferenceMoved);
+    const uint64_t seen = g_staticTriangles + g_movingTriangles;
+    Log.info("Triangles whose source vertices are unchanged: {:.1f}% ({} of {} counted)",
+             seen > 0 ? 100.0 * static_cast<double>(g_staticTriangles) / static_cast<double>(seen)
+                      : 0.0,
+             g_staticTriangles, seen);
+    Log.info("Camera motion measured from the geometry on {} of {} traced frames",
+             g_framesWithDelta, g_framesTraced);
+    Log.info("Of {} captured draws: {} cut-out, occluding by their solid fraction; {} "
+             "uniformly translucent, still traced as opaque; {} environment mapped; {} "
+             "baked for want of a usable matrix; {} additive, {}",
+             g_drawsTotal, g_drawsAlphaTested, g_drawsBlended, g_drawsReflective,
+             g_drawsSingularMatrix, g_drawsAdditive,
+             g_skipAdditive ? "left out of the rays" : "traced");
+    // More than one means part of the picture is being traced through a
+    // projection it was not drawn with, which lands the occlusion in the wrong
+    // place across everything that used the other one.
+    {
+      std::string split;
+      for (const auto& entry : g_projections) {
+        split += (split.empty() ? "" : ", ") + std::to_string(entry.triangles);
+      }
+      Log.info("Perspective projections this frame: {} ({} triangles each); most in any frame "
+               "so far: {}",
+               g_projections.size(), split, g_maxProjections);
+    }
+    // Where the light actually is, in view space. A shadow term that darkens
+    // everything is either a light in the wrong place or a ray reaching too far,
+    // and these two lines are what tell the two apart.
+    Log.info("Shadow light at ({:.0f}, {:.0f}, {:.0f}), present {}; range factor {:.3f}",
+             g_light[0], g_light[1], g_light[2], g_light[3] > 0.f, g_shadowRangeFactor);
+    Log.info("Scene extent {:.0f} x {:.0f} x {:.0f}; AO radius {:.1f}, light half-angle "
+             "{:.2f} deg, shadow range {:.0f}",
+             g_boundsMax[0] - g_boundsMin[0], g_boundsMax[1] - g_boundsMin[1],
+             g_boundsMax[2] - g_boundsMin[2], aoRadius,
+             std::atan(lightRadius) * 57.29578f, shadowRange);
+  }
+
+  ++g_frameIndex;
+}
+
+} // namespace aurora::rt
diff --git a/lib/rt/rt_capture.hpp b/lib/rt/rt_capture.hpp
new file mode 100644
index 0000000..5653f4f
--- /dev/null
+++ b/lib/rt/rt_capture.hpp
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <dolphin/gx.h>
+
+#include <cstdint>
+
+namespace aurora::rt {
+
+// Geometry capture for ray tracing acceleration structures.
+//
+// Hooked into draw_prim rather than handle_draw_unmerged: consecutive draws are
+// merged into the previous DrawData and never reach the unmerged path, so
+// capturing there would silently drop geometry. See docs/RAYTRACING.md.
+//
+// Positions are decoded from their GX component format and transformed by the
+// per-vertex position matrix, producing view-space triangles.
+
+// True when capture is armed for the current frame; checked before doing the
+// per-vertex work so the normal path pays close to nothing.
+bool capture_enabled() noexcept;
+
+// Captures one draw command's triangles. vtxData points at the raw vertex
+// stream, vtxSize is the stride of a single vertex.
+void capture_draw(GXPrimitive prim, GXVtxFmt fmt, uint16_t vtxCount, const uint8_t* vtxData,
+                  uint32_t vtxSize) noexcept;
+
+// Whether the ray tracing terms are applied inside the EFB pass, ahead of the
+// 2D layer, rather than over the finished frame. True unless
+// AURORA_RT_COMPOSITE=present asks for the old path. See rt_composite.hpp.
+bool composite_in_pass() noexcept;
+
+// Which diagnostic buffer the trace is writing, 0 for none. The composition
+// shows a diagnostic instead of multiplying by it: a shadow buffer read through
+// a multiply is the frame times the shadow, which is the thing being diagnosed.
+uint32_t debug_mode() noexcept;
+
+// Runtime toggle. Off by default; the game's video settings drive it. A plain
+// setter keeps the engine layer free of the game's configuration types.
+void set_enabled(bool enabled) noexcept;
+bool enabled() noexcept;
+
+// Trace resolution and ray counts, as one coarse level. Clamped to range; an
+// AURORA_RT_* override of any of the three keeps precedence over it.
+void set_quality(int level) noexcept;
+int quality_levels() noexcept;
+
+// Which terms the trace computes, independently of the master toggle above.
+// Turning both off leaves the pass running but writing an untouched white
+// buffer, so the caller should disable it outright instead.
+void set_features(bool ambientOcclusion, bool shadows, bool reflections) noexcept;
+
+// Frame boundaries. begin_frame clears the accumulator and decides whether this
+// frame is captured; end_frame builds, traces and composites.
+void begin_frame() noexcept;
+void end_frame() noexcept;
+
+} // namespace aurora::rt
diff --git a/lib/rt/rt_device.cpp b/lib/rt/rt_device.cpp
new file mode 100644
index 0000000..12f7b9b
--- /dev/null
+++ b/lib/rt/rt_device.cpp
@@ -0,0 +1,249 @@
+#include "rt_device.hpp"
+
+#include "rt_accel.hpp"
+#include "rt_trace.hpp"
+#include "../logging.hpp"
+
+#include <cstring>
+#include <string_view>
+#include <vector>
+
+#include <cstdlib>
+
+#ifdef AURORA_HAS_RAYTRACING
+#include <d3d12.h>
+#include <d3d12sdklayers.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+#endif
+
+namespace aurora::rt {
+static Module Log("aurora::rt");
+
+namespace {
+DeviceCaps g_caps;
+bool g_probed = false;
+
+#ifdef AURORA_HAS_RAYTRACING
+using Microsoft::WRL::ComPtr;
+
+ComPtr<ID3D12Device5> g_d3dDevice;
+ComPtr<IDXGIAdapter1> g_adapter;
+
+// Narrows the adapter description for logging; the DXGI name is UTF-16.
+void copy_adapter_name(const wchar_t* src, char* dst, size_t dstSize) noexcept {
+  const int written =
+      WideCharToMultiByte(CP_UTF8, 0, src, -1, dst, static_cast<int>(dstSize), nullptr, nullptr);
+  if (written <= 0) {
+    dst[0] = '\0';
+  }
+}
+
+// Picks the adapter Dawn already chose, so BLAS and shared textures live on the
+// same GPU. Falls back to the first hardware adapter when the IDs don't match
+// anything, which can happen under a debug or virtualised adapter.
+bool find_adapter(uint32_t vendorId, uint32_t deviceId, int64_t luid, bool luidValid,
+                  ComPtr<IDXGIAdapter1>& out) noexcept {
+  ComPtr<IDXGIFactory4> factory;
+  if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) {
+    Log.error("CreateDXGIFactory1 failed");
+    return false;
+  }
+
+  // The exact answer when Dawn could give it: EnumAdapterByLuid is designed to
+  // be paired with ID3D12Device::GetAdapterLuid, and names one instance rather
+  // than one model.
+  if (luidValid) {
+    LUID key{};
+    std::memcpy(&key, &luid, sizeof(key));
+    ComPtr<IDXGIAdapter1> byLuid;
+    if (SUCCEEDED(factory->EnumAdapterByLuid(key, IID_PPV_ARGS(&byLuid))) && byLuid) {
+      out = byLuid;
+      return true;
+    }
+    Log.warn("EnumAdapterByLuid found nothing, falling back to the vendor and device ids");
+  }
+
+  ComPtr<IDXGIAdapter1> fallback;
+  ComPtr<IDXGIAdapter1> adapter;
+  for (UINT i = 0; factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; ++i) {
+    DXGI_ADAPTER_DESC1 desc{};
+    if (FAILED(adapter->GetDesc1(&desc))) {
+      continue;
+    }
+    if ((desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0) {
+      continue;
+    }
+    if (desc.VendorId == vendorId && desc.DeviceId == deviceId) {
+      out = adapter;
+      return true;
+    }
+    if (!fallback) {
+      fallback = adapter;
+    }
+  }
+
+  if (fallback) {
+    Log.warn("No adapter matched vendor {:#06x} device {:#06x}, using first hardware adapter",
+             vendorId, deviceId);
+    out = fallback;
+    return true;
+  }
+
+  Log.error("No hardware adapter found");
+  return false;
+}
+#endif
+} // namespace
+
+const DeviceCaps& caps() noexcept { return g_caps; }
+
+void* native_device() noexcept {
+#ifdef AURORA_HAS_RAYTRACING
+  return g_d3dDevice.Get();
+#else
+  return nullptr;
+#endif
+}
+
+// DRED rather than the D3D12 debug layer. EnableDebugLayer() is process-wide:
+// switching it on made Dawn's own device fail validation and lose the device
+// outright, taking the game with it. DRED only asks the driver to keep
+// breadcrumbs, leaves everyone else alone, and is what actually explains a hang
+// after the fact. See docs/RAYTRACING.md.
+bool debug_requested() noexcept {
+  const char* env = std::getenv("AURORA_RT_DEBUG");
+  return env != nullptr && env[0] != '\0' && env[0] != '0';
+}
+
+bool initialize(uint32_t vendorId, uint32_t deviceId, int64_t luid,
+                bool luidValid) noexcept {
+  if (g_probed) {
+    return g_caps.available;
+  }
+  g_probed = true;
+
+#ifndef AURORA_HAS_RAYTRACING
+  Log.info("Ray tracing unavailable: DXR requires Windows");
+  return false;
+#else
+  const bool wantDebug = debug_requested();
+  if (wantDebug) {
+    ComPtr<ID3D12DeviceRemovedExtendedDataSettings> dred;
+    if (SUCCEEDED(D3D12GetDebugInterface(IID_PPV_ARGS(&dred)))) {
+      dred->SetAutoBreadcrumbsEnablement(D3D12_DRED_ENABLEMENT_FORCED_ON);
+      dred->SetPageFaultEnablement(D3D12_DRED_ENABLEMENT_FORCED_ON);
+      Log.info("DRED breadcrumbs enabled (AURORA_RT_DEBUG)");
+    } else {
+      Log.warn("DRED unavailable; a device removal will not be explained");
+    }
+  }
+
+  if (!find_adapter(vendorId, deviceId, luid, luidValid, g_adapter)) {
+    return false;
+  }
+
+  DXGI_ADAPTER_DESC1 desc{};
+  g_adapter->GetDesc1(&desc);
+  copy_adapter_name(desc.Description, g_caps.adapterName, sizeof(g_caps.adapterName));
+  g_caps.dedicatedVideoMemory = desc.DedicatedVideoMemory;
+
+  ComPtr<ID3D12Device> device;
+  const HRESULT hr = D3D12CreateDevice(g_adapter.Get(), D3D_FEATURE_LEVEL_12_0, IID_PPV_ARGS(&device));
+  if (FAILED(hr)) {
+    Log.error("D3D12CreateDevice failed on {} (hr {:#010x})", g_caps.adapterName,
+              static_cast<uint32_t>(hr));
+    return false;
+  }
+
+  // ID3D12Device5 is what exposes the ray tracing entry points.
+  if (FAILED(device.As(&g_d3dDevice))) {
+    Log.error("ID3D12Device5 unavailable on {}: DXR entry points missing", g_caps.adapterName);
+    return false;
+  }
+
+  D3D12_FEATURE_DATA_D3D12_OPTIONS5 options5{};
+  if (FAILED(g_d3dDevice->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS5, &options5,
+                                              sizeof(options5)))) {
+    Log.error("CheckFeatureSupport(OPTIONS5) failed on {}", g_caps.adapterName);
+    return false;
+  }
+
+  g_caps.raytracingTier = static_cast<uint32_t>(options5.RaytracingTier);
+  g_caps.inlineRayQuery = options5.RaytracingTier >= D3D12_RAYTRACING_TIER_1_1;
+
+  if (options5.RaytracingTier == D3D12_RAYTRACING_TIER_NOT_SUPPORTED) {
+    Log.warn("{} reports no ray tracing support", g_caps.adapterName);
+    g_d3dDevice.Reset();
+    return false;
+  }
+
+  g_caps.available = true;
+  Log.info("Ray tracing device ready: {} ({} MB VRAM), tier {}, inline RayQuery {}",
+           g_caps.adapterName, g_caps.dedicatedVideoMemory / (1024 * 1024),
+           g_caps.inlineRayQuery ? "1.1" : "1.0", g_caps.inlineRayQuery ? "yes" : "no");
+
+  if (!g_caps.inlineRayQuery) {
+    Log.warn("Tier 1.0 only: the planned RayQuery path needs 1.1, shader tables would be required");
+  }
+
+  return true;
+#endif
+}
+
+// Called when something has gone wrong. Asks the driver what the GPU was doing
+// when it died, which is the only way to name an invalid DXR usage without the
+// process-wide debug layer.
+void report_device_removal() noexcept {
+#ifdef AURORA_HAS_RAYTRACING
+  if (!g_d3dDevice) {
+    return;
+  }
+  const HRESULT reason = g_d3dDevice->GetDeviceRemovedReason();
+  if (SUCCEEDED(reason)) {
+    return; // still alive, nothing to explain
+  }
+  Log.error("Ray tracing device removed: {:#010x}", static_cast<uint32_t>(reason));
+
+  ComPtr<ID3D12DeviceRemovedExtendedData> dred;
+  if (FAILED(g_d3dDevice.As(&dred))) {
+    Log.error("DRED data unavailable; rerun with AURORA_RT_DEBUG=1 for breadcrumbs");
+    return;
+  }
+
+  D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT breadcrumbs{};
+  if (SUCCEEDED(dred->GetAutoBreadcrumbsOutput(&breadcrumbs))) {
+    for (const auto* node = breadcrumbs.pHeadAutoBreadcrumbNode; node != nullptr;
+         node = node->pNext) {
+      const uint32_t executed = node->pLastBreadcrumbValue != nullptr ? *node->pLastBreadcrumbValue : 0;
+      Log.error("DRED: command list completed {} of {} operations", executed,
+                node->BreadcrumbCount);
+      // The operation right after the last completed one is where it died.
+      if (executed < node->BreadcrumbCount && node->pCommandHistory != nullptr) {
+        Log.error("DRED: died on operation {}", static_cast<uint32_t>(node->pCommandHistory[executed]));
+      }
+    }
+  }
+
+  D3D12_DRED_PAGE_FAULT_OUTPUT pageFault{};
+  if (SUCCEEDED(dred->GetPageFaultAllocationOutput(&pageFault))) {
+    Log.error("DRED: page fault at GPU address {:#x}",
+              static_cast<uint64_t>(pageFault.PageFaultVA));
+  }
+#endif
+}
+
+void shutdown() noexcept {
+  // Acceleration structures hold resources created on this device; they must go
+  // first or the device outlives nothing and the release order is wrong.
+  trace::shutdown();
+  accel::shutdown();
+#ifdef AURORA_HAS_RAYTRACING
+  g_d3dDevice.Reset();
+  g_adapter.Reset();
+#endif
+  g_caps = {};
+  g_probed = false;
+}
+
+} // namespace aurora::rt
diff --git a/lib/rt/rt_device.hpp b/lib/rt/rt_device.hpp
new file mode 100644
index 0000000..ba84b33
--- /dev/null
+++ b/lib/rt/rt_device.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstdint>
+
+namespace aurora::rt {
+
+// Ray tracing capabilities of the private D3D12 device.
+struct DeviceCaps {
+  bool available = false;      // device created successfully
+  bool inlineRayQuery = false; // DXR 1.1: RayQuery usable from compute
+  uint32_t raytracingTier = 0; // raw D3D12_RAYTRACING_TIER value
+  uint64_t dedicatedVideoMemory = 0;
+  char adapterName[128] = {};
+};
+
+// Creates a private D3D12 device on the adapter matching vendorId/deviceId and
+// probes its ray tracing support. Idempotent; returns caps().available.
+//
+// The device is deliberately separate from the one Dawn owns: DXR work runs on
+// its own queue, and results come back through shared textures. See
+// docs/RAYTRACING.md.
+// `luid` identifies the adapter exactly, and is what should be used when it is
+// available: VendorId and DeviceId name a model of hardware, not an instance, so
+// two identical cards in one machine make them ambiguous and the shared handles
+// can end up on the wrong GPU. Pass luidValid = false when it cannot be had.
+bool initialize(uint32_t vendorId, uint32_t deviceId, int64_t luid, bool luidValid) noexcept;
+
+// If the ray tracing device has been removed, logs why, plus DRED breadcrumbs
+// when AURORA_RT_DEBUG was set at startup. A no-op while the device is healthy.
+void report_device_removal() noexcept;
+
+void shutdown() noexcept;
+
+const DeviceCaps& caps() noexcept;
+
+// The ID3D12Device5 backing the RT work, as an opaque pointer so this header
+// stays free of d3d12.h. Null until initialize() succeeds. Callers cast it.
+void* native_device() noexcept;
+
+} // namespace aurora::rt
diff --git a/lib/rt/rt_interop.cpp b/lib/rt/rt_interop.cpp
new file mode 100644
index 0000000..4063364
--- /dev/null
+++ b/lib/rt/rt_interop.cpp
@@ -0,0 +1,181 @@
+#include "rt_interop.hpp"
+
+#include "rt_trace.hpp"
+#include "../logging.hpp"
+#include "../webgpu/gpu.hpp"
+
+namespace aurora::rt::interop {
+static Module Log("aurora::rt");
+
+namespace {
+wgpu::SharedTextureMemory g_memory;
+wgpu::SharedFence g_fence;
+wgpu::Texture g_texture;
+wgpu::TextureView g_view;
+
+// Reflections ride the same fence: both targets are written by one dispatch, so
+// one signal covers them and Dawn waits once.
+wgpu::SharedTextureMemory g_reflectionMemory;
+wgpu::Texture g_reflectionTexture;
+wgpu::TextureView g_reflectionView;
+void* g_importedReflectionHandle = nullptr;
+
+void* g_importedTextureHandle = nullptr;
+void* g_importedFenceHandle = nullptr;
+bool g_accessOpen = false;
+bool g_failed = false; // stop retrying a failed import every frame
+} // namespace
+
+bool ensure_imported() noexcept {
+  void* texHandle = trace::shared_texture_handle();
+  void* fenceHandle = trace::shared_fence_handle();
+  if (texHandle == nullptr || fenceHandle == nullptr) {
+    return false;
+  }
+  if (!webgpu::g_sharedTextureSupported || !webgpu::g_sharedFenceSupported) {
+    return false;
+  }
+  if (g_texture && texHandle == g_importedTextureHandle && fenceHandle == g_importedFenceHandle) {
+    return true;
+  }
+  if (g_failed) {
+    return false;
+  }
+
+  // The handles changed (first trace, or a resize recreated the texture).
+  shutdown();
+
+  wgpu::SharedTextureMemoryDXGISharedHandleDescriptor handleDesc;
+  handleDesc.handle = texHandle;
+  // The producer signals an explicit fence, so no keyed mutex is needed.
+  handleDesc.useKeyedMutex = false;
+
+  wgpu::SharedTextureMemoryDescriptor memoryDesc;
+  memoryDesc.nextInChain = &handleDesc;
+  memoryDesc.label = "RT AO shared memory";
+
+  g_memory = webgpu::g_device.ImportSharedTextureMemory(&memoryDesc);
+  if (!g_memory) {
+    Log.error("ImportSharedTextureMemory failed; in-game composition disabled");
+    g_failed = true;
+    return false;
+  }
+
+  g_texture = g_memory.CreateTexture();
+  if (!g_texture) {
+    Log.error("SharedTextureMemory::CreateTexture failed");
+    g_memory = {};
+    g_failed = true;
+    return false;
+  }
+  g_view = g_texture.CreateView();
+
+  wgpu::SharedFenceDXGISharedHandleDescriptor fenceHandleDesc;
+  fenceHandleDesc.handle = fenceHandle;
+  wgpu::SharedFenceDescriptor fenceDesc;
+  fenceDesc.nextInChain = &fenceHandleDesc;
+  fenceDesc.label = "RT AO shared fence";
+
+  g_fence = webgpu::g_device.ImportSharedFence(&fenceDesc);
+  if (!g_fence) {
+    Log.error("ImportSharedFence failed; in-game composition disabled");
+    shutdown();
+    g_failed = true;
+    return false;
+  }
+
+  // The reflection target is optional: without it the composition simply has no
+  // reflection to blend, and everything else still works.
+  if (void* reflHandle = trace::shared_reflection_handle()) {
+    wgpu::SharedTextureMemoryDXGISharedHandleDescriptor reflHandleDesc;
+    reflHandleDesc.handle = reflHandle;
+    reflHandleDesc.useKeyedMutex = false;
+    wgpu::SharedTextureMemoryDescriptor reflMemoryDesc;
+    reflMemoryDesc.nextInChain = &reflHandleDesc;
+    reflMemoryDesc.label = "RT reflection shared memory";
+
+    g_reflectionMemory = webgpu::g_device.ImportSharedTextureMemory(&reflMemoryDesc);
+    if (g_reflectionMemory) {
+      g_reflectionTexture = g_reflectionMemory.CreateTexture();
+      if (g_reflectionTexture) {
+        g_reflectionView = g_reflectionTexture.CreateView();
+        g_importedReflectionHandle = reflHandle;
+      } else {
+        g_reflectionMemory = {};
+      }
+    }
+    if (!g_reflectionView) {
+      Log.warn("Reflection texture import failed; reflections will not composite");
+    }
+  }
+
+  g_importedTextureHandle = texHandle;
+  g_importedFenceHandle = fenceHandle;
+  Log.info("Ray tracing output imported into Dawn: {}x{}", trace::output_width(),
+           trace::output_height());
+  return true;
+}
+
+wgpu::TextureView view() noexcept { return g_view; }
+wgpu::TextureView reflection_view() noexcept { return g_reflectionView; }
+
+bool begin_access() noexcept {
+  if (!g_memory || !g_texture || g_accessOpen) {
+    return false;
+  }
+
+  // Wait on the value the producer signalled after its dispatch. The texture is
+  // always initialised by that point: the trace writes every pixel.
+  const uint64_t signaled = trace::fence_value();
+  wgpu::SharedFence fences[] = {g_fence};
+  const uint64_t values[] = {signaled};
+
+  wgpu::SharedTextureMemoryBeginAccessDescriptor desc{};
+  desc.initialized = true;
+  desc.concurrentRead = false;
+  desc.fenceCount = 1;
+  desc.fences = fences;
+  desc.signaledValueCount = 1;
+  desc.signaledValues = values;
+
+  if (g_memory.BeginAccess(g_texture, &desc) != wgpu::Status::Success) {
+    Log.error("SharedTextureMemory::BeginAccess failed");
+    return false;
+  }
+  if (g_reflectionMemory && g_reflectionTexture) {
+    if (g_reflectionMemory.BeginAccess(g_reflectionTexture, &desc) != wgpu::Status::Success) {
+      Log.error("BeginAccess failed on the reflection texture");
+    }
+  }
+  g_accessOpen = true;
+  return true;
+}
+
+void end_access() noexcept {
+  if (!g_accessOpen) {
+    return;
+  }
+  wgpu::SharedTextureMemoryEndAccessState state;
+  g_memory.EndAccess(g_texture, &state);
+  if (g_reflectionMemory && g_reflectionTexture) {
+    wgpu::SharedTextureMemoryEndAccessState reflState;
+    g_reflectionMemory.EndAccess(g_reflectionTexture, &reflState);
+  }
+  g_accessOpen = false;
+}
+
+void shutdown() noexcept {
+  end_access();
+  g_view = {};
+  g_texture = {};
+  g_reflectionView = {};
+  g_reflectionTexture = {};
+  g_reflectionMemory = {};
+  g_importedReflectionHandle = nullptr;
+  g_fence = {};
+  g_memory = {};
+  g_importedTextureHandle = nullptr;
+  g_importedFenceHandle = nullptr;
+}
+
+} // namespace aurora::rt::interop
diff --git a/lib/rt/rt_interop.hpp b/lib/rt/rt_interop.hpp
new file mode 100644
index 0000000..f6dffd4
--- /dev/null
+++ b/lib/rt/rt_interop.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <webgpu/webgpu_cpp.h>
+
+namespace aurora::rt::interop {
+
+// Imports the ray tracing output into Dawn.
+//
+// The AO texture is produced on a private D3D12 device, so it reaches Dawn as a
+// DXGI shared handle rather than a copy. A shared fence carries the dependency,
+// which keeps the wait on the GPU. See docs/RAYTRACING.md.
+
+// Imports the handles currently exported by rt_trace. Cheap to call repeatedly:
+// it only does work when the handles change. Returns false when interop is
+// unavailable, in which case the caller renders as before.
+bool ensure_imported() noexcept;
+
+// Texture view for the composition pass, or an empty view when unavailable.
+wgpu::TextureView view() noexcept;
+// Reflected colour in rgb, blend weight in a. Empty when unavailable, in which
+// case the composition uses a transparent fallback and nothing changes.
+wgpu::TextureView reflection_view() noexcept;
+
+// Wrap Dawn's use of the texture. begin_access waits on the shared fence value
+// written by the last trace; end_access hands the texture back.
+bool begin_access() noexcept;
+void end_access() noexcept;
+
+void shutdown() noexcept;
+
+} // namespace aurora::rt::interop
diff --git a/lib/rt/rt_textures.cpp b/lib/rt/rt_textures.cpp
new file mode 100644
index 0000000..abdc778
--- /dev/null
+++ b/lib/rt/rt_textures.cpp
@@ -0,0 +1,96 @@
+#include "rt_textures.hpp"
+
+#include "../logging.hpp"
+
+#include <vector>
+
+namespace aurora::rt::textures {
+static Module Log("aurora::rt");
+
+namespace {
+// 4096 thumbnails is 4 MB at 16x16 RGBA. Indices are never reused: a board's
+// textures are freed when it unloads, but tracking that would mean reaching
+// into the texture cache's lifetime for a buffer this small. The cap is what
+// stops a long session growing without bound, and reaching it degrades to the
+// average colour rather than failing.
+constexpr size_t kMaxTextures = 4096;
+
+std::vector<uint32_t> g_texels; // kTexels per entry, entry 0 left blank
+size_t g_count = 1;             // index 0 is "none"
+bool g_dirty = false;
+bool g_warnedFull = false;
+} // namespace
+
+uint32_t add(const uint32_t width, const uint32_t height, const uint8_t* rgba,
+             const size_t bytes) noexcept {
+  if (rgba == nullptr || width == 0 || height == 0) {
+    return 0;
+  }
+  // Only plain 8-bit RGBA reaches here; the caller checks the format.
+  if (bytes < static_cast<size_t>(width) * height * 4) {
+    return 0;
+  }
+  if (g_count >= kMaxTextures) {
+    if (!g_warnedFull) {
+      g_warnedFull = true;
+      Log.warn("Ray tracing thumbnail registry full at {}; further textures use their average "
+               "colour",
+               kMaxTextures);
+    }
+    return 0;
+  }
+
+  if (g_texels.empty()) {
+    g_texels.resize(kTexels, 0u); // entry 0
+  }
+  const size_t base = g_texels.size();
+  g_texels.resize(base + kTexels, 0u);
+
+  // Box filter down to kEdge x kEdge. Averaging rather than point sampling
+  // because a reflection of a checkerboard should be its mean, not whichever
+  // square the nearest texel happened to land on.
+  for (uint32_t ty = 0; ty < kEdge; ++ty) {
+    const uint32_t y0 = ty * height / kEdge;
+    const uint32_t y1 = (ty + 1) * height / kEdge > y0 ? (ty + 1) * height / kEdge : y0 + 1;
+    for (uint32_t tx = 0; tx < kEdge; ++tx) {
+      const uint32_t x0 = tx * width / kEdge;
+      const uint32_t x1 = (tx + 1) * width / kEdge > x0 ? (tx + 1) * width / kEdge : x0 + 1;
+      uint32_t sums[4] = {0, 0, 0, 0};
+      uint32_t n = 0;
+      for (uint32_t y = y0; y < y1 && y < height; ++y) {
+        for (uint32_t x = x0; x < x1 && x < width; ++x) {
+          const uint8_t* p = rgba + (static_cast<size_t>(y) * width + x) * 4;
+          sums[0] += p[0];
+          sums[1] += p[1];
+          sums[2] += p[2];
+          sums[3] += p[3];
+          ++n;
+        }
+      }
+      if (n == 0) {
+        continue;
+      }
+      const uint32_t packed = ((sums[3] / n) << 24) | ((sums[2] / n) << 16) |
+                              ((sums[1] / n) << 8) | (sums[0] / n);
+      g_texels[base + static_cast<size_t>(ty) * kEdge + tx] = packed;
+    }
+  }
+
+  g_dirty = true;
+  return static_cast<uint32_t>(g_count++);
+}
+
+bool dirty() noexcept { return g_dirty; }
+void mark_uploaded() noexcept { g_dirty = false; }
+const uint32_t* data() noexcept { return g_texels.empty() ? nullptr : g_texels.data(); }
+size_t count() noexcept { return g_count; }
+
+void shutdown() noexcept {
+  g_texels.clear();
+  g_texels.shrink_to_fit();
+  g_count = 1;
+  g_dirty = false;
+  g_warnedFull = false;
+}
+
+} // namespace aurora::rt::textures
diff --git a/lib/rt/rt_textures.hpp b/lib/rt/rt_textures.hpp
new file mode 100644
index 0000000..b805129
--- /dev/null
+++ b/lib/rt/rt_textures.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace aurora::rt::textures {
+
+// A small thumbnail of every texture the ray tracing can reach, all in one
+// buffer.
+//
+// Reflections currently blend the hit surface's *whole-texture average*, which
+// is why the term measures a 0.0% difference on screen: a flat colour close to
+// what is already there. Sampling the real texture at the hit needs each one on
+// the private D3D12 device, behind a bindless descriptor table, with the upload
+// and lifetime that implies.
+//
+// This is the cheap half of that, done first to find out whether the expensive
+// half is worth building: each texture is reduced to kEdge x kEdge and packed
+// into a single structured buffer, indexed arithmetically. No descriptor heap,
+// no per-texture resource, no lifetime beyond an index. It cannot resolve
+// detail, but it gives a reflection spatial variation instead of one colour,
+// which is the difference between the term doing something and doing nothing.
+//
+// If a thumbnail makes reflections worth having, the full path is justified. If
+// it does not, the full path would not have helped either.
+constexpr uint32_t kEdge = 16;
+constexpr uint32_t kTexels = kEdge * kEdge;
+
+// Registers a decoded RGBA8 image. Returns a 1-based index for the material
+// word, or 0 when the registry is full or ray tracing is unavailable -- 0 means
+// "no thumbnail", and the shader falls back to the average colour.
+uint32_t add(uint32_t width, uint32_t height, const uint8_t* rgba, size_t bytes) noexcept;
+
+// Number of registered thumbnails, and whether any changed since the last
+// upload. The trace uploads on demand rather than every frame.
+bool dirty() noexcept;
+void mark_uploaded() noexcept;
+const uint32_t* data() noexcept; // kTexels packed RGBA8 per entry, index 0 unused
+size_t count() noexcept;         // entries, including the unused index 0
+
+void shutdown() noexcept;
+
+} // namespace aurora::rt::textures
diff --git a/lib/rt/rt_trace.cpp b/lib/rt/rt_trace.cpp
new file mode 100644
index 0000000..0661f23
--- /dev/null
+++ b/lib/rt/rt_trace.cpp
@@ -0,0 +1,1239 @@
+#include "rt_trace.hpp"
+
+#include "rt_accel.hpp"
+#include "rt_device.hpp"
+#include "rt_textures.hpp"
+#include "../logging.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#ifdef AURORA_HAS_RAYTRACING
+#include <d3d12.h>
+#include <wrl/client.h>
+
+#include "rt_ao_dxil.h"      // generated by dxc at build time: g_rt_ao_dxil
+#include "rt_denoise_dxil.h" // likewise: g_rt_denoise_dxil
+#include "rt_temporal_dxil.h" // likewise: g_rt_temporal_dxil
+#endif
+
+namespace aurora::rt::trace {
+static Module Log("aurora::rt");
+
+namespace {
+TraceStats g_stats;
+
+#ifdef AURORA_HAS_RAYTRACING
+using Microsoft::WRL::ComPtr;
+
+ComPtr<ID3D12CommandQueue> g_queue;
+ComPtr<ID3D12CommandAllocator> g_allocator;
+ComPtr<ID3D12GraphicsCommandList> g_cmdList;
+ComPtr<ID3D12Fence> g_fence;
+HANDLE g_fenceEvent = nullptr;
+uint64_t g_fenceValue = 0;
+
+ComPtr<ID3D12RootSignature> g_rootSig;
+ComPtr<ID3D12PipelineState> g_pso;
+ComPtr<ID3D12DescriptorHeap> g_uavHeap;
+ComPtr<ID3D12Resource> g_output;
+// Reflections travel in their own texture: the composition needs the reflected
+// colour and a weight alongside the multiplicative AO term, which is six
+// channels in all -- more than one RGBA target can carry.
+ComPtr<ID3D12Resource> g_reflection;
+HANDLE g_sharedReflectionHandle = nullptr;
+ComPtr<ID3D12Resource> g_readback;
+// Orthographic coverage grid, refilled by the CPU each frame. An upload-heap
+// buffer is enough: wait_idle() has already retired the dispatch that read it.
+ComPtr<ID3D12Resource> g_maskBuffer;
+uint32_t g_maskCapacity = 0;
+// Texture thumbnails, uploaded only when the registry grows rather than every
+// frame: the game registers them as a board loads and then stops.
+ComPtr<ID3D12Resource> g_thumbnailBuffer;
+size_t g_thumbnailCapacity = 0;
+// GPU timestamps around the dispatch. Without them traceMs measured the time to
+// record and submit the command list -- microseconds of CPU work -- and called
+// it the cost of tracing, which is how a 1920x1440 pass with 48 rays a pixel
+// came to be reported at 0.05 ms.
+ComPtr<ID3D12QueryHeap> g_timestampHeap;
+ComPtr<ID3D12Resource> g_timestampReadback;
+uint64_t g_timestampFrequency = 0;
+bool g_timestampPending = false;
+uint32_t g_outWidth = 0;
+uint32_t g_outHeight = 0;
+
+// Denoiser: a second pipeline plus the two extra targets it needs. The guide
+// carries the normal and hit distance the filter uses to find edges; the
+// scratch texture is the other half of the a-trous ping-pong.
+ComPtr<ID3D12RootSignature> g_denoiseRootSig;
+ComPtr<ID3D12PipelineState> g_denoisePso;
+// Two guides and two histories, alternating by frame parity: temporal
+// accumulation reads the previous frame's while writing this one's, and a
+// single texture cannot be both.
+ComPtr<ID3D12Resource> g_guide[2];
+ComPtr<ID3D12Resource> g_history[2];
+ComPtr<ID3D12Resource> g_scratch;
+// Temporal pass: accumulation, the history clamp and the variance the filter
+// weighs by. See rt_temporal.hlsl.
+ComPtr<ID3D12RootSignature> g_temporalRootSig;
+ComPtr<ID3D12PipelineState> g_temporalPso;
+ComPtr<ID3D12Resource> g_moments[2];
+// Width of the history clamp, in standard deviations of this frame's 3x3
+// neighbourhood; 0 turns it off. AURORA_RT_CLAMP_SIGMA overrides.
+float g_clampSigma = 2.0f;
+// Whether the temporal pass looks the history up where the pixel was, using the
+// camera motion the capture measures, rather than at the same pixel.
+// AURORA_RT_REPROJECT=0 goes back to the same pixel.
+bool g_reproject = true;
+// Whether the filter weighs signal agreement by the variance the temporal pass
+// carries, or by its own 3x3 spread as before. AURORA_RT_VARIANCE=0 falls back.
+bool g_varianceGuided = true;
+// Descriptors in the one heap every pass binds from; the layout is spelled out
+// in ensure_output.
+constexpr uint32_t kDescriptorCount = 34;
+uint32_t g_denoisePasses = 4;
+uint32_t g_frameIndex = 0;
+// Multiplier on the local spread in the denoiser's signal-agreement weight.
+// Larger lets the filter cross more of a step; smaller keeps more edge and more
+// grain. AURORA_RT_DENOISE_PHI overrides it.
+float g_luminancePhi = 4.0f;
+uint32_t g_frameParity = 0;
+// Weight given to this frame's estimate when the history is usable. 1 disables
+// accumulation. AURORA_RT_TEMPORAL overrides it.
+// Weight of this frame's estimate where the history holds; 1 disables the
+// accumulation. 0.15 averaged too few frames to pay for a sampling pattern that
+// now moves -- measured on w01Dll, grain and frame-to-frame variation of the
+// shadow buffer once the intro camera settles:
+//   motif fixe, sans accumulation   0.0112   0.00810
+//   mobile, alpha 0.05              0.0111   0.00751
+//   mobile, alpha 0.10              0.0144   0.00850
+//   mobile, alpha 0.15              0.0133   0.00864
+// 0.05 is the only one that matches the old grain and is steadier besides.
+float g_temporalAlpha = 0.05f;
+
+// Interop: the output texture and a fence are exported as NT handles so Dawn can
+// import them and wait on the GPU rather than on the CPU.
+ComPtr<ID3D12Fence> g_sharedFence;
+HANDLE g_sharedTextureHandle = nullptr;
+HANDLE g_sharedFenceHandle = nullptr;
+uint64_t g_sharedFenceValue = 0;
+
+// Must match the cbuffer in rt_ao.hlsl exactly.
+struct Constants {
+  float proj[4];
+  uint32_t dims[2];
+  uint32_t sampleCount;
+  float rayLength;
+  float light[4];
+  float lightRadius;
+  float bounceStrength;
+  float shadowRange;
+  uint32_t debugMode;
+  uint32_t features;
+  uint32_t shadowSamples;
+  float reflectionRange;
+  // Dimensions of the orthographic coverage grid; 0 means no mask was supplied.
+  uint32_t maskCols;
+  uint32_t maskRows;
+  // Entries in the thumbnail registry; 0 means none is bound.
+  uint32_t thumbnailCount;
+  // Weight of this frame's estimate when the history is usable; 1 disables.
+  float temporalAlpha;
+  // Counts frames, to move the sampling pattern. See the seed in rt_ao.hlsl.
+  uint32_t frameIndex;
+};
+// HLSL packs a cbuffer in float4 rows, so the size has to stay a multiple of 16.
+static_assert(sizeof(Constants) == 96, "constants must stay 24 DWORDs");
+
+// Must match the cbuffer in rt_denoise.hlsl exactly.
+struct DenoiseConstants {
+  uint32_t dims[2];
+  uint32_t step;
+  float normalSharpness;
+  float depthTolerance;
+  float luminancePhi;
+  // 1 weighs signal agreement by the variance carried in the source's alpha,
+  // 0 by the filter's own 3x3 spread.
+  uint32_t varianceGuided;
+  float pad;
+};
+static_assert(sizeof(DenoiseConstants) == 32, "denoise constants must stay 8 DWORDs");
+
+// Must match the cbuffer in rt_temporal.hlsl exactly.
+struct TemporalConstants {
+  uint32_t dims[2];
+  float alpha;
+  float clampSigma;
+  uint32_t debugMode;
+  uint32_t reproject;
+  float pad0[2];
+  float proj[4];
+  float prevProj[4];
+  float viewDelta[12];
+};
+static_assert(sizeof(TemporalConstants) == 112, "temporal constants must stay 28 DWORDs");
+
+ID3D12Device5* device() noexcept { return static_cast<ID3D12Device5*>(native_device()); }
+
+bool create_pipeline() noexcept {
+  if (g_pso) {
+    return true;
+  }
+
+  // AURORA_RT_DENOISE overrides the a-trous pass count, so the filter can be
+  // measured against itself. 0 disables it; odd counts are rounded up because
+  // the ping-pong has to finish in the texture Dawn imports.
+  if (const char* env = std::getenv("AURORA_RT_TEMPORAL")) {
+    g_temporalAlpha = static_cast<float>(std::atof(env));
+    if (g_temporalAlpha <= 0.f || g_temporalAlpha > 1.f) {
+      g_temporalAlpha = 1.f;
+    }
+    Log.info("Temporal accumulation alpha {:.2f}{}", g_temporalAlpha,
+             g_temporalAlpha >= 1.f ? " (off)" : "");
+  }
+  if (const char* env = std::getenv("AURORA_RT_DENOISE_PHI")) {
+    g_luminancePhi = static_cast<float>(std::atof(env));
+    Log.info("Denoiser signal tolerance {:.2f}", g_luminancePhi);
+  }
+  if (const char* env = std::getenv("AURORA_RT_DENOISE")) {
+    const int requested = std::atoi(env);
+    g_denoisePasses = requested <= 0 ? 0u : static_cast<uint32_t>((requested + 1) & ~1);
+  }
+  if (const char* env = std::getenv("AURORA_RT_CLAMP_SIGMA")) {
+    g_clampSigma = static_cast<float>(std::atof(env));
+    Log.info("Temporal history clamp {:.2f} sigma{}", g_clampSigma, g_clampSigma > 0.f ? "" : " (off)");
+  }
+  if (const char* env = std::getenv("AURORA_RT_REPROJECT")) {
+    g_reproject = env[0] != '0';
+    Log.info("History looked up {}", g_reproject ? "where the pixel was" : "at the same pixel");
+  }
+  if (const char* env = std::getenv("AURORA_RT_VARIANCE")) {
+    g_varianceGuided = env[0] != '0';
+    Log.info("Denoiser weighs by {}", g_varianceGuided ? "the carried variance" : "its own 3x3 spread");
+  }
+
+  // b0 as root constants, t0/t1 as root SRVs, u0 through a descriptor table
+  // because textures cannot be root descriptors.
+  D3D12_ROOT_PARAMETER params[10]{};
+  params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  params[0].Constants.ShaderRegister = 0;
+  params[0].Constants.Num32BitValues = sizeof(Constants) / 4;
+  params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+
+  params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[1].Descriptor.ShaderRegister = 0; // t0: TLAS
+  params[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[2].Descriptor.ShaderRegister = 1; // t1: vertices
+  params[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[4].Descriptor.ShaderRegister = 2; // t2: vertex colours
+  params[5].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[5].Descriptor.ShaderRegister = 3; // t3: vertex normals
+  params[6].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[6].Descriptor.ShaderRegister = 4; // t4: per-triangle materials
+  params[7].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[7].Descriptor.ShaderRegister = 5; // t5: orthographic coverage grid
+  params[8].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[8].Descriptor.ShaderRegister = 6; // t6: vertex texture coordinates
+  params[9].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+  params[9].Descriptor.ShaderRegister = 7; // t7: texture thumbnails
+
+  D3D12_DESCRIPTOR_RANGE uavRange{};
+  uavRange.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  // u0 this frame's raw estimate, u1 guide, u2 reflection. The history belongs
+  // to the temporal pass now, which can read a pixel's neighbours.
+  uavRange.NumDescriptors = 3;
+  uavRange.BaseShaderRegister = 0;
+  params[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+  params[3].DescriptorTable.NumDescriptorRanges = 1;
+  params[3].DescriptorTable.pDescriptorRanges = &uavRange;
+
+  D3D12_ROOT_SIGNATURE_DESC rootDesc{};
+  rootDesc.NumParameters = 10;
+  rootDesc.pParameters = params;
+
+  ComPtr<ID3DBlob> blob;
+  ComPtr<ID3DBlob> error;
+  HRESULT hr = D3D12SerializeRootSignature(&rootDesc, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &error);
+  if (FAILED(hr)) {
+    Log.error("Root signature serialisation failed: {}",
+              error ? static_cast<const char*>(error->GetBufferPointer()) : "unknown");
+    return false;
+  }
+  if (FAILED(device()->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(),
+                                           IID_PPV_ARGS(&g_rootSig)))) {
+    Log.error("CreateRootSignature failed");
+    return false;
+  }
+
+  D3D12_COMPUTE_PIPELINE_STATE_DESC psoDesc{};
+  psoDesc.pRootSignature = g_rootSig.Get();
+  psoDesc.CS.pShaderBytecode = g_rt_ao_dxil;
+  psoDesc.CS.BytecodeLength = sizeof(g_rt_ao_dxil);
+  if (FAILED(device()->CreateComputePipelineState(&psoDesc, IID_PPV_ARGS(&g_pso)))) {
+    Log.error("CreateComputePipelineState failed: the DXIL may not match the root signature");
+    return false;
+  }
+
+  // Denoiser: root constants plus one table of three UAVs (source, target,
+  // guide). Separate from the tracing signature so the ping-pong can just point
+  // the table at a different run of descriptors on each pass.
+  {
+    D3D12_DESCRIPTOR_RANGE range{};
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    range.NumDescriptors = 3;
+    range.BaseShaderRegister = 0;
+
+    D3D12_ROOT_PARAMETER denoiseParams[2]{};
+    denoiseParams[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    denoiseParams[0].Constants.ShaderRegister = 0;
+    denoiseParams[0].Constants.Num32BitValues = sizeof(DenoiseConstants) / 4;
+    denoiseParams[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    denoiseParams[1].DescriptorTable.NumDescriptorRanges = 1;
+    denoiseParams[1].DescriptorTable.pDescriptorRanges = &range;
+
+    D3D12_ROOT_SIGNATURE_DESC denoiseDesc{};
+    denoiseDesc.NumParameters = 2;
+    denoiseDesc.pParameters = denoiseParams;
+
+    ComPtr<ID3DBlob> denoiseBlob;
+    ComPtr<ID3DBlob> denoiseError;
+    if (FAILED(D3D12SerializeRootSignature(&denoiseDesc, D3D_ROOT_SIGNATURE_VERSION_1,
+                                           &denoiseBlob, &denoiseError)) ||
+        FAILED(device()->CreateRootSignature(0, denoiseBlob->GetBufferPointer(),
+                                             denoiseBlob->GetBufferSize(),
+                                             IID_PPV_ARGS(&g_denoiseRootSig)))) {
+      Log.error("Denoise root signature failed: {}",
+                denoiseError ? static_cast<const char*>(denoiseError->GetBufferPointer())
+                             : "unknown");
+      return false;
+    }
+
+    D3D12_COMPUTE_PIPELINE_STATE_DESC denoisePsoDesc{};
+    denoisePsoDesc.pRootSignature = g_denoiseRootSig.Get();
+    denoisePsoDesc.CS.pShaderBytecode = g_rt_denoise_dxil;
+    denoisePsoDesc.CS.BytecodeLength = sizeof(g_rt_denoise_dxil);
+    if (FAILED(device()->CreateComputePipelineState(&denoisePsoDesc,
+                                                    IID_PPV_ARGS(&g_denoisePso)))) {
+      Log.error("Denoise pipeline creation failed");
+      return false;
+    }
+  }
+
+  // Temporal pass: root constants plus one table of eight UAVs, laid out in
+  // ensure_output.
+  {
+    D3D12_DESCRIPTOR_RANGE range{};
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    range.NumDescriptors = 8;
+    range.BaseShaderRegister = 0;
+
+    D3D12_ROOT_PARAMETER temporalParams[2]{};
+    temporalParams[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    temporalParams[0].Constants.ShaderRegister = 0;
+    temporalParams[0].Constants.Num32BitValues = sizeof(TemporalConstants) / 4;
+    temporalParams[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    temporalParams[1].DescriptorTable.NumDescriptorRanges = 1;
+    temporalParams[1].DescriptorTable.pDescriptorRanges = &range;
+
+    D3D12_ROOT_SIGNATURE_DESC temporalDesc{};
+    temporalDesc.NumParameters = 2;
+    temporalDesc.pParameters = temporalParams;
+
+    ComPtr<ID3DBlob> temporalBlob;
+    ComPtr<ID3DBlob> temporalError;
+    if (FAILED(D3D12SerializeRootSignature(&temporalDesc, D3D_ROOT_SIGNATURE_VERSION_1,
+                                           &temporalBlob, &temporalError)) ||
+        FAILED(device()->CreateRootSignature(0, temporalBlob->GetBufferPointer(),
+                                             temporalBlob->GetBufferSize(),
+                                             IID_PPV_ARGS(&g_temporalRootSig)))) {
+      Log.error("Temporal root signature failed: {}",
+                temporalError ? static_cast<const char*>(temporalError->GetBufferPointer())
+                              : "unknown");
+      return false;
+    }
+
+    D3D12_COMPUTE_PIPELINE_STATE_DESC temporalPsoDesc{};
+    temporalPsoDesc.pRootSignature = g_temporalRootSig.Get();
+    temporalPsoDesc.CS.pShaderBytecode = g_rt_temporal_dxil;
+    temporalPsoDesc.CS.BytecodeLength = sizeof(g_rt_temporal_dxil);
+    if (FAILED(device()->CreateComputePipelineState(&temporalPsoDesc,
+                                                    IID_PPV_ARGS(&g_temporalPso)))) {
+      Log.error("Temporal pipeline creation failed");
+      return false;
+    }
+  }
+
+  D3D12_DESCRIPTOR_HEAP_DESC heapDesc{};
+  heapDesc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+  // The layout is spelled out in ensure_output.
+  heapDesc.NumDescriptors = kDescriptorCount;
+  heapDesc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+  if (FAILED(device()->CreateDescriptorHeap(&heapDesc, IID_PPV_ARGS(&g_uavHeap)))) {
+    Log.error("CreateDescriptorHeap failed");
+    return false;
+  }
+
+  D3D12_COMMAND_QUEUE_DESC queueDesc{};
+  queueDesc.Type = D3D12_COMMAND_LIST_TYPE_COMPUTE;
+  if (FAILED(device()->CreateCommandQueue(&queueDesc, IID_PPV_ARGS(&g_queue))) ||
+      FAILED(device()->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_COMPUTE,
+                                              IID_PPV_ARGS(&g_allocator))) ||
+      FAILED(device()->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_COMPUTE, g_allocator.Get(),
+                                         nullptr, IID_PPV_ARGS(&g_cmdList))) ||
+      FAILED(device()->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&g_fence)))) {
+    Log.error("Failed to create tracing command objects");
+    return false;
+  }
+  g_cmdList->Close();
+
+  // Timestamps are best effort: a device that refuses them loses the
+  // measurement, not the feature.
+  {
+    D3D12_QUERY_HEAP_DESC queryDesc{};
+    queryDesc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    queryDesc.Count = 2;
+    D3D12_HEAP_PROPERTIES rbHeap{};
+    rbHeap.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rbDesc{};
+    rbDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rbDesc.Width = 2 * sizeof(uint64_t);
+    rbDesc.Height = 1;
+    rbDesc.DepthOrArraySize = 1;
+    rbDesc.MipLevels = 1;
+    rbDesc.Format = DXGI_FORMAT_UNKNOWN;
+    rbDesc.SampleDesc.Count = 1;
+    rbDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(device()->CreateQueryHeap(&queryDesc, IID_PPV_ARGS(&g_timestampHeap))) ||
+        FAILED(device()->CreateCommittedResource(&rbHeap, D3D12_HEAP_FLAG_NONE, &rbDesc,
+                                                 D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                                 IID_PPV_ARGS(&g_timestampReadback))) ||
+        FAILED(g_queue->GetTimestampFrequency(&g_timestampFrequency))) {
+      Log.warn("Timestamp queries unavailable: the trace time will not be measured");
+      g_timestampHeap.Reset();
+      g_timestampReadback.Reset();
+      g_timestampFrequency = 0;
+    }
+  }
+
+  g_fenceEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  if (g_fenceEvent == nullptr) {
+    return false;
+  }
+
+  // A second, shared fence: Dawn waits on this one to know the AO is ready.
+  if (FAILED(device()->CreateFence(0, D3D12_FENCE_FLAG_SHARED, IID_PPV_ARGS(&g_sharedFence))) ||
+      FAILED(device()->CreateSharedHandle(g_sharedFence.Get(), nullptr, GENERIC_ALL, nullptr,
+                                          &g_sharedFenceHandle))) {
+    Log.warn("Failed to export a shared fence: in-game composition unavailable");
+    g_sharedFence.Reset();
+    g_sharedFenceHandle = nullptr;
+  }
+  return true;
+}
+
+bool ensure_output(uint32_t width, uint32_t height) noexcept {
+  if (g_output && g_reflection && g_outWidth == width && g_outHeight == height) {
+    return true;
+  }
+
+  D3D12_HEAP_PROPERTIES heap{};
+  heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+  D3D12_RESOURCE_DESC desc{};
+  desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+  desc.Width = width;
+  desc.Height = height;
+  desc.DepthOrArraySize = 1;
+  desc.MipLevels = 1;
+  desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  desc.SampleDesc.Count = 1;
+  // SIMULTANEOUS_ACCESS lets Dawn read the texture while this device still holds
+  // it in UNORDERED_ACCESS, which avoids a cross-device state transition.
+  desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS |
+               D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS;
+
+  g_output.Reset();
+  g_reflection.Reset();
+  if (g_sharedTextureHandle != nullptr) {
+    CloseHandle(g_sharedTextureHandle);
+    g_sharedTextureHandle = nullptr;
+  }
+  if (g_sharedReflectionHandle != nullptr) {
+    CloseHandle(g_sharedReflectionHandle);
+    g_sharedReflectionHandle = nullptr;
+  }
+  if (FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_SHARED, &desc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_output)))) {
+    Log.error("Failed to create ray tracing output texture");
+    return false;
+  }
+  if (FAILED(device()->CreateSharedHandle(g_output.Get(), nullptr, GENERIC_ALL, nullptr,
+                                          &g_sharedTextureHandle))) {
+    Log.warn("Failed to export the output texture: in-game composition unavailable");
+    g_sharedTextureHandle = nullptr;
+  }
+
+  // Guide and scratch stay on this device: neither crosses to Dawn, so they
+  // need no shared handle and no simultaneous access.
+  D3D12_RESOURCE_DESC localDesc = desc;
+  localDesc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+  g_guide[0].Reset();
+  g_guide[1].Reset();
+  g_history[0].Reset();
+  g_history[1].Reset();
+  g_scratch.Reset();
+  g_moments[0].Reset();
+  g_moments[1].Reset();
+  if (FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &localDesc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_guide[0]))) ||
+      FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &localDesc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_guide[1]))) ||
+      FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &localDesc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_history[0]))) ||
+      FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &localDesc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_history[1]))) ||
+      FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &localDesc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_scratch))) ||
+      FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &localDesc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_moments[0]))) ||
+      FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &localDesc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_moments[1])))) {
+    Log.error("Failed to create the denoiser textures");
+    return false;
+  }
+
+  if (FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_SHARED, &desc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&g_reflection)))) {
+    Log.error("Failed to create ray tracing reflection texture");
+    return false;
+  }
+  if (FAILED(device()->CreateSharedHandle(g_reflection.Get(), nullptr, GENERIC_ALL, nullptr,
+                                          &g_sharedReflectionHandle))) {
+    Log.warn("Failed to export the reflection texture: reflections will not composite");
+    g_sharedReflectionHandle = nullptr;
+  }
+
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+  uav.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+
+  const uint32_t stride =
+      device()->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  const D3D12_CPU_DESCRIPTOR_HANDLE base = g_uavHeap->GetCPUDescriptorHandleForHeapStart();
+  const auto slot = [&](uint32_t index) {
+    D3D12_CPU_DESCRIPTOR_HANDLE handle = base;
+    handle.ptr += static_cast<SIZE_T>(index) * stride;
+    return handle;
+  };
+  // Each pass binds one contiguous run, twice over because the guide, the
+  // history and the moments alternate between frames: parity p writes index p
+  // and reads 1 - p.
+  //   trace     3 per parity: raw estimate (scratch), guide, reflection
+  //   temporal  8 per parity: raw, guide, previous guide, history in, history
+  //                           out, moments in, moments out, output
+  //   denoise   6 per parity: forward output -> scratch, backward scratch ->
+  //                           output, each with this frame's guide
+  // The trace writes scratch rather than output because the temporal pass reads
+  // a neighbourhood of it while writing output; the filter then overwrites
+  // scratch freely, the raw estimate having served its purpose.
+  ID3D12Resource* const layout[kDescriptorCount] = {
+      // trace, parity 0 and 1
+      g_scratch.Get(), g_guide[0].Get(), g_reflection.Get(),
+      g_scratch.Get(), g_guide[1].Get(), g_reflection.Get(),
+      // temporal, parity 0
+      g_scratch.Get(), g_guide[0].Get(), g_guide[1].Get(), g_history[1].Get(),
+      g_history[0].Get(), g_moments[1].Get(), g_moments[0].Get(), g_output.Get(),
+      // temporal, parity 1
+      g_scratch.Get(), g_guide[1].Get(), g_guide[0].Get(), g_history[0].Get(),
+      g_history[1].Get(), g_moments[0].Get(), g_moments[1].Get(), g_output.Get(),
+      // denoise, parity 0: forward then backward
+      g_output.Get(), g_scratch.Get(), g_guide[0].Get(),
+      g_scratch.Get(), g_output.Get(), g_guide[0].Get(),
+      // denoise, parity 1
+      g_output.Get(), g_scratch.Get(), g_guide[1].Get(),
+      g_scratch.Get(), g_output.Get(), g_guide[1].Get(),
+  };
+  for (uint32_t i = 0; i < kDescriptorCount; ++i) {
+    device()->CreateUnorderedAccessView(layout[i], nullptr, &uav, slot(i));
+  }
+
+  // Readback rows are aligned to D3D12_TEXTURE_DATA_PITCH_ALIGNMENT.
+  const uint32_t rowPitch =
+      (width * 8 + D3D12_TEXTURE_DATA_PITCH_ALIGNMENT - 1) & ~(D3D12_TEXTURE_DATA_PITCH_ALIGNMENT - 1);
+  D3D12_HEAP_PROPERTIES rbHeap{};
+  rbHeap.Type = D3D12_HEAP_TYPE_READBACK;
+  D3D12_RESOURCE_DESC rbDesc{};
+  rbDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+  rbDesc.Width = static_cast<uint64_t>(rowPitch) * height;
+  rbDesc.Height = 1;
+  rbDesc.DepthOrArraySize = 1;
+  rbDesc.MipLevels = 1;
+  rbDesc.Format = DXGI_FORMAT_UNKNOWN;
+  rbDesc.SampleDesc.Count = 1;
+  rbDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+
+  g_readback.Reset();
+  if (FAILED(device()->CreateCommittedResource(&rbHeap, D3D12_HEAP_FLAG_NONE, &rbDesc,
+                                               D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&g_readback)))) {
+    Log.error("Failed to create readback buffer");
+    return false;
+  }
+
+  g_outWidth = width;
+  g_outHeight = height;
+  return true;
+}
+
+// Uploads the coverage grid and returns its address. A one-element buffer is
+// kept even with no mask, because a root SRV still has to point somewhere.
+D3D12_GPU_VIRTUAL_ADDRESS upload_mask(const uint32_t* mask, uint32_t count) noexcept {
+  const uint32_t needed = count > 0 ? count : 1u;
+  if (needed > g_maskCapacity || !g_maskBuffer) {
+    D3D12_HEAP_PROPERTIES heap{};
+    heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    desc.Width = static_cast<uint64_t>(needed) * sizeof(uint32_t);
+    desc.Height = 1;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_UNKNOWN;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    g_maskBuffer.Reset();
+  g_thumbnailBuffer.Reset();
+  g_thumbnailCapacity = 0;
+  textures::shutdown();
+    if (FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                                 D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                                 IID_PPV_ARGS(&g_maskBuffer)))) {
+      Log.error("Failed to create the coverage mask buffer");
+      g_maskCapacity = 0;
+      return 0;
+    }
+    g_maskCapacity = needed;
+  }
+  void* mapped = nullptr;
+  D3D12_RANGE noRead{0, 0};
+  if (FAILED(g_maskBuffer->Map(0, &noRead, &mapped))) {
+    return 0;
+  }
+  if (mask != nullptr && count > 0) {
+    std::memcpy(mapped, mask, static_cast<size_t>(count) * sizeof(uint32_t));
+  } else {
+    std::memset(mapped, 0, sizeof(uint32_t));
+  }
+  D3D12_RANGE written{0, static_cast<SIZE_T>(needed) * sizeof(uint32_t)};
+  g_maskBuffer->Unmap(0, &written);
+  return g_maskBuffer->GetGPUVirtualAddress();
+}
+
+// Uploads the thumbnail registry when it has grown. Returns its address, or the
+// mask's when there is nothing to bind -- a root SRV still has to point at
+// something, and the shader is told the count is zero.
+D3D12_GPU_VIRTUAL_ADDRESS upload_thumbnails() noexcept {
+  const size_t entries = textures::count();
+  const uint32_t* src = textures::data();
+  if (src == nullptr || entries == 0) {
+    return 0;
+  }
+  const size_t needed = entries * textures::kTexels;
+  if (needed > g_thumbnailCapacity || !g_thumbnailBuffer) {
+    D3D12_HEAP_PROPERTIES heap{};
+    heap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC desc{};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    desc.Width = static_cast<uint64_t>(needed) * sizeof(uint32_t);
+    desc.Height = 1;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_UNKNOWN;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    g_thumbnailBuffer.Reset();
+    if (FAILED(device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc,
+                                                 D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                                 IID_PPV_ARGS(&g_thumbnailBuffer)))) {
+      Log.error("Failed to create the texture thumbnail buffer");
+      g_thumbnailCapacity = 0;
+      return 0;
+    }
+    g_thumbnailCapacity = needed;
+    textures::mark_uploaded();
+    void* mapped = nullptr;
+    D3D12_RANGE noRead{0, 0};
+    if (SUCCEEDED(g_thumbnailBuffer->Map(0, &noRead, &mapped))) {
+      std::memcpy(mapped, src, needed * sizeof(uint32_t));
+      g_thumbnailBuffer->Unmap(0, nullptr);
+    }
+  } else if (textures::dirty()) {
+    textures::mark_uploaded();
+    void* mapped = nullptr;
+    D3D12_RANGE noRead{0, 0};
+    if (SUCCEEDED(g_thumbnailBuffer->Map(0, &noRead, &mapped))) {
+      std::memcpy(mapped, src, needed * sizeof(uint32_t));
+      g_thumbnailBuffer->Unmap(0, nullptr);
+    }
+  }
+  return g_thumbnailBuffer->GetGPUVirtualAddress();
+}
+
+bool wait_for_gpu() noexcept {
+  const uint64_t value = ++g_fenceValue;
+  if (FAILED(g_queue->Signal(g_fence.Get(), value))) {
+    return false;
+  }
+  if (g_fence->GetCompletedValue() >= value) {
+    return true;
+  }
+  if (FAILED(g_fence->SetEventOnCompletion(value, g_fenceEvent))) {
+    return false;
+  }
+  return WaitForSingleObject(g_fenceEvent, 20000) == WAIT_OBJECT_0;
+}
+
+// The output is RGBA16F now, so the debug readback has to widen halves.
+float half_to_float(uint16_t h) noexcept {
+  const uint32_t sign = static_cast<uint32_t>(h >> 15) << 31;
+  uint32_t exponent = (h >> 10) & 0x1F;
+  uint32_t mantissa = h & 0x3FF;
+  if (exponent == 0) {
+    if (mantissa == 0) {
+      float z;
+      const uint32_t bits = sign;
+      std::memcpy(&z, &bits, 4);
+      return z;
+    }
+    while ((mantissa & 0x400) == 0) {
+      mantissa <<= 1;
+      --exponent;
+    }
+    ++exponent;
+    mantissa &= 0x3FF;
+  } else if (exponent == 31) {
+    exponent = 255;
+  }
+  const uint32_t bits = sign | ((exponent + 112) << 23) | (mantissa << 13);
+  float f;
+  std::memcpy(&f, &bits, 4);
+  return f;
+}
+
+// Portable float map: the readback as it is, three float32 per pixel with no
+// clamp and no 8-bit rounding, for the A/B bench to compare. The negative scale
+// in the header declares little-endian, and rows run bottom-up as the format
+// requires.
+void write_pfm(const char* path, const std::vector<float>& pixels, uint32_t width,
+               uint32_t height) noexcept {
+  FILE* f = std::fopen(path, "wb");
+  if (f == nullptr) {
+    Log.error("Failed to open {} for writing", path);
+    return;
+  }
+  std::fprintf(f, "PF\n%u %u\n-1.0\n", width, height);
+  for (uint32_t y = 0; y < height; ++y) {
+    const size_t base = static_cast<size_t>(height - 1 - y) * width * 3;
+    std::fwrite(pixels.data() + base, sizeof(float), static_cast<size_t>(width) * 3, f);
+  }
+  std::fclose(f);
+}
+
+// 24-bit BMP: opens natively on Windows, unlike PGM.
+void write_bmp(const char* path, const std::vector<float>& pixels, uint32_t width,
+               uint32_t height) noexcept {
+  // Three floats per pixel: the trace output carries colour now.
+  FILE* f = std::fopen(path, "wb");
+  if (f == nullptr) {
+    Log.error("Failed to open {} for writing", path);
+    return;
+  }
+
+  const uint32_t rowBytes = (width * 3 + 3) & ~3u;
+  const uint32_t dataSize = rowBytes * height;
+  const uint32_t fileSize = 54 + dataSize;
+
+  uint8_t header[54]{};
+  header[0] = 'B';
+  header[1] = 'M';
+  std::memcpy(header + 2, &fileSize, 4);
+  const uint32_t offset = 54;
+  std::memcpy(header + 10, &offset, 4);
+  const uint32_t infoSize = 40;
+  std::memcpy(header + 14, &infoSize, 4);
+  std::memcpy(header + 18, &width, 4);
+  std::memcpy(header + 22, &height, 4);
+  const uint16_t planes = 1;
+  std::memcpy(header + 26, &planes, 2);
+  const uint16_t bpp = 24;
+  std::memcpy(header + 28, &bpp, 2);
+  std::memcpy(header + 34, &dataSize, 4);
+  std::fwrite(header, 1, sizeof(header), f);
+
+  std::vector<uint8_t> row(rowBytes, 0);
+  // BMP rows run bottom-up.
+  for (uint32_t y = 0; y < height; ++y) {
+    const uint32_t srcY = height - 1 - y;
+    for (uint32_t x = 0; x < width; ++x) {
+      const size_t base = (static_cast<size_t>(srcY) * width + x) * 3;
+      for (uint32_t c = 0; c < 3; ++c) {
+        float v = pixels[base + c];
+        v = v < 0.f ? 0.f : (v > 1.f ? 1.f : v);
+        // BMP stores BGR.
+        row[x * 3 + (2 - c)] = static_cast<uint8_t>(v * 255.f + 0.5f);
+      }
+    }
+    std::fwrite(row.data(), 1, rowBytes, f);
+  }
+  std::fclose(f);
+}
