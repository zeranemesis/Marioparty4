+void capture_draw(GXPrimitive prim, GXVtxFmt fmt, uint16_t vtxCount, const uint8_t* vtxData,
+                  uint32_t vtxSize) noexcept {
+  ++g_drawsSeen;
+  if (!g_armed || vtxCount < 3) {
+    return;
+  }
+  // Lines and points contribute no surface to trace against.
+  if (prim != GX_TRIANGLES && prim != GX_TRIANGLESTRIP && prim != GX_TRIANGLEFAN &&
+      prim != GX_QUADS) {
+    return;
+  }
+
+  // Orthographic draws are the HUD and other 2D overlays. Their quads sit in
+  // front of everything and would occlude the whole scene, so they are left out
+  // of the acceleration structure entirely. They are not simply discarded any
+  // more: the composition multiplies the finished frame, HUD included, by a
+  // term computed for the geometry behind it, which shaded the interface as
+  // though it were part of the scene. Their screen coverage is recorded so the
+  // trace can leave those pixels alone. See ortho_coverage below.
+  const bool ortho = g_gxState.projType == GX_ORTHOGRAPHIC;
+  const auto& proj = g_gxState.proj;
+  if (ortho != g_lastDrawOrtho) {
+    if (ortho) {
+      if (g_projSwitches == 0) {
+        g_firstOrthoDraw = g_drawsSeen;
+      }
+      ++g_projSwitches;
+      // Each new transition resets the counts: only the last one matters, and
+      // which one is last is not known until the frame ends. The renderer keeps
+      // the position in its own command stream for the same reason: that is
+      // where the ray tracing terms get composited, ahead of the 2D layer.
+      if (g_compositeInPass) {
+        gfx::mark_2d_boundary();
+      }
+      g_lastSwitchDraw = g_drawsSeen;
+      g_orthoBeforeLast = g_orthoDrawsSkipped;
+      g_perspAfterLast = 0;
+    } else {
+      ++g_backToPerspective;
+    }
+    g_lastDrawOrtho = ortho;
+  }
+  if (!ortho) {
+    if (g_projSwitches > 0) {
+      ++g_perspAfterLast;
+    }
+    // Marked on every 3D draw, not once a frame: a frame renders into more
+    // than one pass, and a flag latched on the first pass left the others
+    // looking empty.
+    if (g_compositeInPass) {
+      gfx::mark_scene_draw();
+    }
+  }
+  if (ortho) {
+    ++g_orthoDrawsSkipped;
+  }
+
+  size_t projIndex = SIZE_MAX;
+  if (!ortho) {
+    g_projParams[0] = proj.m0[0];
+    g_projParams[1] = proj.m0[2];
+    g_projParams[2] = proj.m1[1];
+    g_projParams[3] = proj.m1[2];
+    g_haveProj = true;
+
+    // Which of the frame's projections this draw belongs to. Bounded because a
+    // frame with more than a handful is pathological and the search is linear.
+    for (size_t i = 0; i < g_projections.size(); ++i) {
+      if (std::memcmp(g_projections[i].params, g_projParams, sizeof(g_projParams)) == 0) {
+        projIndex = i;
+        break;
+      }
+    }
+    if (projIndex == SIZE_MAX && g_projections.size() < 16) {
+      projIndex = g_projections.size();
+      FrameProjection entry{};
+      std::memcpy(entry.params, g_projParams, sizeof(entry.params));
+      g_projections.push_back(entry);
+    }
+
+    // Keep the brightest light of the frame to cast shadows from. GX lights live
+    // in view space, like the geometry, so no extra transform is needed.
+    for (const auto& light : g_gxState.lights) {
+      const float weight = light.color.x() + light.color.y() + light.color.z();
+      if (weight > g_lightWeight) {
+        g_lightWeight = weight;
+        g_light[0] = light.pos.x();
+        g_light[1] = light.pos.y();
+        g_light[2] = light.pos.z();
+        g_light[3] = 1.f;
+      }
+    }
+  }
+
+  // The maps the trace reads for this draw, from what the active TEV stages
+  // combine -- and only the maps they name: the texture array keeps whatever
+  // was bound last, exactly as the texgen array does, and scanning all eight
+  // classified every draw in the mini-game as see-through at 0.1 alpha.
+  //
+  // Coverage decides cut-out and translucent: the most transparent map whose
+  // alpha an alpha combiner reads, the first on a tie. Colour, for the albedo
+  // and the reflections: the first map a colour combiner reads at a texture
+  // coordinate. A reflection or a highlight is generated from the normal and is
+  // not the surface; it stands in only where nothing better is combined.
+  MapChoice named; // the old choice: the most transparent map any stage names
+  MapChoice coverage;
+  MapChoice colour;
+  MapChoice generatedColour;
+  if (!ortho) {
+    for (uint8_t i = 0; i < g_gxState.numTevStages && i < g_gxState.tevStages.size(); ++i) {
+      const auto& stage = g_gxState.tevStages[i];
+      if (stage.texMapId == GX_TEXMAP_NULL) {
+        continue;
+      }
+      const auto slot = static_cast<size_t>(stage.texMapId) & 7u;
+      if (slot >= g_gxState.textures.size()) {
+        continue;
+      }
+      const auto& unit = g_gxState.textures[slot];
+      if (!unit.ref) {
+        continue;
+      }
+      const float alpha = unit.ref->averageAlpha;
+      if (named.map == nullptr || alpha < named.map->ref->averageAlpha) {
+        named = MapChoice{&unit, i};
+      }
+      if (reads_texture_alpha(stage) &&
+          (coverage.map == nullptr || alpha < coverage.map->ref->averageAlpha)) {
+        coverage = MapChoice{&unit, i};
+      }
+      if (reads_texture_colour(stage)) {
+        if (resolve_texgen(stage).source == Texgen::Source::Texcoord) {
+          if (colour.map == nullptr) {
+            colour = MapChoice{&unit, i};
+          }
+        } else if (generatedColour.map == nullptr) {
+          generatedColour = MapChoice{&unit, i};
+        }
+      }
+    }
+    if (colour.map == nullptr) {
+      colour = generatedColour.map != nullptr ? generatedColour : coverage;
+    }
+  }
+  // What classifies the surface, and so what the alpha test reads on a
+  // see-through one; the colour map everywhere else. With
+  // AURORA_RT_TEV_TEXTURES=0, the old reading: the most transparent map named,
+  // and texture unit 0 at the raw TEX0 attribute.
+  const gfx::TextureBind* seeThrough = g_tevTextures ? coverage.map : named.map;
+  const bool seeThroughSurface =
+      seeThrough != nullptr && (is_holed(*seeThrough) || is_hazy(*seeThrough));
+  const gfx::TextureBind* sampled = nullptr;
+  Texgen texgen;
+  if (!g_tevTextures) {
+    sampled = &g_gxState.textures[0];
+    texgen.source = Texgen::Source::Texcoord;
+    texgen.attr = GX_VA_TEX0;
+  } else {
+    const MapChoice& read = seeThroughSurface ? coverage : colour;
+    sampled = read.map;
+    if (read.map != nullptr) {
+      texgen = resolve_texgen(g_gxState.tevStages[read.stage]);
+    }
+  }
+
+  AttrLayout posLayout;
+  AttrLayout mtxLayout;
+  AttrLayout colourLayout;
+  AttrLayout normalLayout;
+  AttrLayout texLayout;
+  AttrLayout texMtxLayout;
+  compute_layout(fmt, texgen.attr, texgen.mtxAttr, posLayout, mtxLayout, colourLayout,
+                 normalLayout, texLayout, texMtxLayout);
+  // A source the vertex does not carry cannot be generated from either.
+  if (g_tevTextures && ((texgen.source == Texgen::Source::Texcoord && !texLayout.present) ||
+                        (texgen.source == Texgen::Source::Normal && !normalLayout.present))) {
+    texgen = Texgen{};
+  }
+  if (!posLayout.present) {
+    ++g_skippedDraws;
+    return;
+  }
+
+  const auto& attrFmt = g_gxState.vtxFmts[fmt].attrs[GX_VA_POS];
+  const auto& array = g_gxState.arrays[GX_VA_POS];
+  const bool indexed = posLayout.type == GX_INDEX8 || posLayout.type == GX_INDEX16;
+  if (indexed && array.data == nullptr) {
+    ++g_skippedDraws;
+    return;
+  }
+
+  // Bytes one position occupies, needed to bound-check the fetch below: checking
+  // only the start offset lets a position near the end of the array read past it.
+  const size_t positionBytes =
+      static_cast<size_t>(gx::comp_type_size(GX_VA_POS, attrFmt.type)) *
+      gx::comp_cnt_count(GX_VA_POS, attrFmt.cnt);
+
+  // draw_prim may reuse a cached vertex size while the layout is recomputed here;
+  // if the two ever disagree these offsets would read past the vertex stream.
+  const size_t positionFieldBytes =
+      indexed ? (posLayout.type == GX_INDEX8 ? 1u : 2u) : positionBytes;
+  if (posLayout.offset + positionFieldBytes > vtxSize) {
+    ++g_skippedDraws;
+    return;
+  }
+  if (mtxLayout.present && mtxLayout.type == GX_DIRECT && mtxLayout.offset >= vtxSize) {
+    ++g_skippedDraws;
+    return;
+  }
+
+  // An orthographic draw contributes nothing but its screen coverage, so the
+  // material, albedo and per-vertex colour work below is all skipped for it --
+  // as are the counters, which describe the traced scene.
+  if (!ortho) {
+    ++g_drawsTotal;
+  }
+  // The GX blend and alpha-compare state says nothing useful on its own: the
+  // game leaves both enabled for solid geometry, so every draw looks
+  // see-through. The texture's own alpha is the honest signal.
+  // Material, derived entirely from what the game already declares. Only the
+  // active texgens are scanned: the array keeps stale entries past numTexGens,
+  // and reading all eight reported every draw as environment mapped.
+  uint32_t material = 0;
+  for (uint8_t i = 0; !ortho && i < g_gxState.numTexGens && i < g_gxState.tcgs.size(); ++i) {
+    if (g_gxState.tcgs[i].src == GX_TG_NRM) {
+      material |= accel::MaterialReflective;
+      ++g_drawsReflective;
+      break;
+    }
+  }
+  // Blended with the destination kept whole: the draw adds light to what is
+  // behind it and cannot take any away. The blend state does not say whether a
+  // surface is solid -- the game leaves blending on for solid geometry -- but a
+  // destination factor of one does say that nothing behind is hidden. The
+  // game's glows, light shafts and caustics are drawn this way
+  // (HSF_MATERIAL_ADDCOL in hsfdraw.c, and the particles in hsfanim.c).
+  if (!ortho && g_gxState.blendMode == GX_BM_BLEND && g_gxState.blendFacDst == GX_BL_ONE) {
+    material |= accel::MaterialAdditive;
+    ++g_drawsAdditive;
+  }
+  // The GX blend and alpha-compare state says nothing useful on its own: the
+  // game leaves both enabled for solid geometry, so every draw looks
+  // see-through. The texture's own alpha is the honest signal.
+  // That of the coverage map chosen above -- not unit 0's: a sprite that binds
+  // its sheet elsewhere read as fully opaque and was one of the draws still
+  // laying a rectangle over the scene.
+  if (!ortho && g_tevTextures && coverage.map != named.map) {
+    ++g_coverageMoved;
+  }
+  if (!ortho && g_tevTextures && named.map == nullptr && g_gxState.textures[0].ref) {
+    ++g_staleUnit0;
+  }
+  if (const auto* texPtr = seeThrough; texPtr != nullptr) {
+    const auto& tex = *texPtr;
+    const bool holed = is_holed(tex);
+    const bool hazy = is_hazy(tex);
+    if (holed) {
+      material |= accel::MaterialCutout; // holes, rather than uniform haze
+      ++g_drawsAlphaTested;
+    }
+    if (hazy && !holed) {
+      material |= accel::MaterialTranslucent;
+      ++g_drawsBlended;
+    }
+    if (holed || hazy) {
+      // How much of the surface actually blocks, as 0..255 in the high byte.
+      //
+      // This was the fraction of texels with alpha at or above half, which
+      // counts holes and misses haze: a bubble sprite whose whole disc sits
+      // just over the threshold came out 70 percent solid and was treated as a
+      // wall. The mean alpha covers both -- a texture that is half holes and
+      // half opaque averages the same 0.5 as one that is uniformly half
+      // translucent, and the two do block about the same amount of light.
+      //
+      // This is still not alpha testing: the light that gets through is uniform
+      // rather than hole-shaped. It is far closer than counting every hit
+      // whole, and it is what lets the primary ray tell a decoration from a
+      // surface.
+      const float solid = g_cutoutOpaque ? 1.f : tex.ref->averageAlpha;
+      const float clamped = solid < 0.f ? 0.f : (solid > 1.f ? 1.f : solid);
+      const uint32_t packed = static_cast<uint32_t>(clamped * 255.f + 0.5f);
+      material |= packed << accel::MaterialOpacityShift;
+      const auto bucket = static_cast<size_t>(clamped * 10.f);
+      ++g_opacityHistogram[bucket > 9 ? 9 : bucket];
+    }
+  }
+  if (colourLayout.present && !ortho) {
+    ++g_drawsWithColour;
+  }
+  if (texLayout.present && !ortho) {
+    ++g_drawsWithTexcoords;
+  }
+
+  // Albedo for the bounce. Vertex colours exist on barely one draw in a hundred
+  // here — the models are textured — so the surface's mean texture colour is
+  // what actually carries the tint. Indirect light is low frequency, so an
+  // average is a close enough stand-in for sampling the texture per hit.
+  Vec3 albedo{1.f, 1.f, 1.f};
+  // The colour map. With AURORA_RT_TEV_TEXTURES=0, unit 0 as before, whether or
+  // not a stage samples it.
+  const gfx::TextureBind* albedoMap = g_tevTextures ? colour.map : &g_gxState.textures[0];
+  if (albedoMap != nullptr && albedoMap->ref && !ortho) {
+    // The thumbnail is the map the trace reads -- the coverage map on a
+    // see-through surface -- and none where its coordinate cannot be
+    // reproduced: a texel read at a coordinate that means nothing would decide
+    // a hole or a reflected colour at random, where the average is at least the
+    // right colour.
+    if (sampled != nullptr && sampled->ref && texgen.source != Texgen::Source::None) {
+      material |= (sampled->ref->rtThumbnail & accel::MaterialThumbnailMask)
+                  << accel::MaterialThumbnailShift;
+    }
+    if (g_tevTextures) {
+      if (texgen.source == Texgen::Source::None) {
+        ++g_texgenUnusable;
+      } else {
+        if (texgen.source != Texgen::Source::Texcoord || texgen.attr != GX_VA_TEX0) {
+          ++g_texgenOtherSource;
+        }
+        if ((texMtxLayout.present && texMtxLayout.type == GX_DIRECT) ||
+            texgen.tcg->mtx != GX_IDENTITY) {
+          ++g_texgenMatrix;
+        }
+        if (texgen.tcg->postMtx != GX_PTIDENTITY) {
+          ++g_texgenPostMatrix;
+        }
+      }
+      if (sampled != &g_gxState.textures[0]) {
+        ++g_sampledOtherUnit;
+      }
+    }
+    albedo = Vec3{albedoMap->ref->averageColour[0], albedoMap->ref->averageColour[1],
+                  albedoMap->ref->averageColour[2]};
+    ++g_drawsWithTexture;
+    const float hi = albedo.x > albedo.y ? (albedo.x > albedo.z ? albedo.x : albedo.z)
+                                         : (albedo.y > albedo.z ? albedo.y : albedo.z);
+    const float lo = albedo.x < albedo.y ? (albedo.x < albedo.z ? albedo.x : albedo.z)
+                                         : (albedo.y < albedo.z ? albedo.y : albedo.z);
+    g_albedoSaturation += hi > 1e-4f ? (hi - lo) / hi : 0.0;
+  }
+  const auto& colourFmt = g_gxState.vtxFmts[fmt].attrs[GX_VA_CLR0];
+  const auto& colourArray = g_gxState.arrays[GX_VA_CLR0];
+  const bool colourIndexed =
+      colourLayout.type == GX_INDEX8 || colourLayout.type == GX_INDEX16;
+  const size_t colourBytes =
+      colourLayout.present
+          ? static_cast<size_t>(gx::comp_type_size(GX_VA_CLR0, colourFmt.type)) *
+                gx::comp_cnt_count(GX_VA_CLR0, colourFmt.cnt)
+          : 0;
+
+  // Normals share the position decoder: same component types, same fixed-point
+  // convention. NBT formats pack three vectors; only the first is the normal.
+  const auto& normalFmt = g_gxState.vtxFmts[fmt].attrs[GX_VA_NRM];
+  const auto& normalArray = g_gxState.arrays[GX_VA_NRM];
+  const bool normalIndexed =
+      normalLayout.type == GX_INDEX8 || normalLayout.type == GX_INDEX16;
+  const size_t normalBytes =
+      normalLayout.present
+          ? static_cast<size_t>(gx::comp_type_size(GX_VA_NRM, normalFmt.type)) * 3u
+          : 0;
+
+  // Texture coordinates, for sampling the surface's own texture at a hit rather
+  // than its whole-texture average: the attribute the map read comes through.
+  const auto texAttr = static_cast<GXAttr>(texgen.attr >= 0 ? texgen.attr : GX_VA_TEX0);
+  const auto& texFmt = g_gxState.vtxFmts[fmt].attrs[texAttr];
+  const auto& texArray = g_gxState.arrays[texAttr];
+  const bool texIndexed = texLayout.type == GX_INDEX8 || texLayout.type == GX_INDEX16;
+  const size_t texBytes =
+      texLayout.present
+          ? static_cast<size_t>(gx::comp_type_size(texAttr, texFmt.type)) *
+                ((texFmt.cnt == GX_TEX_ST) ? 2u : 1u)
+          : 0;
+  // The vertex's own texture matrix index, read the way the shader reads it:
+  // only as direct data.
+  const bool texMtxPerVertex =
+      texgen.tcg != nullptr && texMtxLayout.present && texMtxLayout.type == GX_DIRECT;
+
+  const bool measureCamera = rt_debug_logging();
+  // Hash of the raw decoded positions, before any matrix. Stable means the mesh
+  // is not being re-streamed, so only its transform moves -- which is the
+  // precondition for giving it a BLAS of its own.
+  uint64_t localHash = 0xcbf29ce484222325ull;
+  const size_t trianglesBefore = g_triangles.size() / 3;
+
+  // Both spaces are kept until the draw is fully decoded, because which one is
+  // emitted depends on something only known at the end: whether every vertex
+  // used the same position matrix. A draw that did can live in model space with
+  // its matrix in a TLAS instance, so its BLAS survives the object moving. One
+  // that did not -- per-vertex matrices -- has no single transform to give an
+  // instance, and is baked into view space as before.
+  std::vector<Vec3> verts;  // view space
+  std::vector<Vec3> locals; // model space
+  std::vector<Vec3> cols;
+  std::vector<Vec3> nrmsView;
+  std::vector<Vec3> nrmsLocal;
+  std::vector<Vec3> uvs;
+  uvs.reserve(vtxCount);
+  locals.reserve(vtxCount);
+  verts.reserve(vtxCount);
+  cols.reserve(vtxCount);
+  nrmsView.reserve(vtxCount);
+  nrmsLocal.reserve(vtxCount);
+
+  uint32_t firstMtxIdx = UINT32_MAX;
+  bool singleMatrix = true;
+
+  for (uint16_t i = 0; i < vtxCount; ++i) {
+    const uint8_t* vtx = vtxData + static_cast<size_t>(i) * vtxSize;
+
+    // Position matrix index is stored in units of matrix rows, hence the /3.
+    uint32_t mtxIdx = g_gxState.currentPnMtx;
+    if (mtxLayout.present && mtxLayout.type == GX_DIRECT) {
+      mtxIdx = vtx[mtxLayout.offset] / 3u;
+    }
+    if (mtxIdx >= g_gxState.pnMtx.size()) {
+      mtxIdx = 0;
+    }
+    if (firstMtxIdx == UINT32_MAX) {
+      firstMtxIdx = mtxIdx;
+    } else if (mtxIdx != firstMtxIdx) {
+      singleMatrix = false;
+    }
+
+    const uint8_t* src = nullptr;
+    bool le = false;
+    if (indexed) {
+      const uint32_t index = (posLayout.type == GX_INDEX8)
+                                 ? vtx[posLayout.offset]
+                                 : read_u16_be(vtx + posLayout.offset);
+      const size_t byteOffset = static_cast<size_t>(index) * array.stride;
+      if (byteOffset + positionBytes > array.size) {
+        ++g_skippedDraws;
+        return;
+      }
+      src = static_cast<const uint8_t*>(array.data) + byteOffset;
+      le = array.le;
+    } else {
+      src = vtx + posLayout.offset;
+      le = false; // direct data comes straight from the big-endian FIFO
+    }
+
+    Vec3 local;
+    if (!decode_position(src, attrFmt, le, local)) {
+      ++g_skippedDraws;
+      return;
+    }
+    // View space drives the scene bounds, which set the AO radius and the
+    // shadow range; model space is what goes into the acceleration structure.
+    if (measureCamera) {
+      uint32_t bits;
+      for (const float f : {local.x, local.y, local.z}) {
+        std::memcpy(&bits, &f, sizeof(bits));
+        localHash = (localHash ^ bits) * 0x100000001b3ull;
+      }
+    }
+    verts.push_back(transform(local, g_gxState.pnMtx[mtxIdx]));
+    locals.push_back(local);
+
+    // Untextured white is the safe default: it bounces neutral light rather
+    // than tinting the scene with a colour the surface does not have.
+    Vec3 colour = albedo;
+    if (!ortho && colourLayout.present && colourBytes != 0) {
+      const uint8_t* csrc = nullptr;
+      bool cle = false;
+      if (colourIndexed) {
+        const uint32_t cindex = (colourLayout.type == GX_INDEX8)
+                                    ? vtx[colourLayout.offset]
+                                    : read_u16_be(vtx + colourLayout.offset);
+        const size_t coff = static_cast<size_t>(cindex) * colourArray.stride;
+        if (colourArray.data != nullptr && coff + colourBytes <= colourArray.size) {
+          csrc = static_cast<const uint8_t*>(colourArray.data) + coff;
+          cle = colourArray.le;
+        }
+      } else if (colourLayout.offset + colourBytes <= vtxSize) {
+        csrc = vtx + colourLayout.offset;
+      }
+      Vec3 vertexColour{1.f, 1.f, 1.f};
+      if (csrc != nullptr && decode_colour(csrc, colourFmt.type, cle, vertexColour)) {
+        colour = Vec3{albedo.x * vertexColour.x, albedo.y * vertexColour.y,
+                      albedo.z * vertexColour.z};
+      }
+    }
+    cols.push_back(colour);
+
+    // Zero means "none": the shader falls back to the geometric normal, which
+    // is always available because it comes from the triangle itself.
+    Vec3 normal{0.f, 0.f, 0.f};
+    if (!ortho && normalLayout.present && normalBytes != 0) {
+      const uint8_t* nsrc = nullptr;
+      bool nle = false;
+      if (normalIndexed) {
+        const uint32_t nindex = (normalLayout.type == GX_INDEX8)
+                                    ? vtx[normalLayout.offset]
+                                    : read_u16_be(vtx + normalLayout.offset);
+        const size_t noff = static_cast<size_t>(nindex) * normalArray.stride;
+        if (normalArray.data != nullptr && noff + normalBytes <= normalArray.size) {
+          nsrc = static_cast<const uint8_t*>(normalArray.data) + noff;
+          nle = normalArray.le;
+        }
+      } else if (normalLayout.offset + normalBytes <= vtxSize) {
+        nsrc = vtx + normalLayout.offset;
+      }
+      Vec3 local_n{0.f, 0.f, 0.f};
+      if (nsrc != nullptr && decode_normal(nsrc, normalFmt, nle, local_n)) {
+        normal = local_n;
+      }
+    }
+    nrmsLocal.push_back(normal);
+    const bool haveNormal = normal.x != 0.f || normal.y != 0.f || normal.z != 0.f;
+    nrmsView.push_back(haveNormal ? rotate_normal(normal, g_gxState.pnMtx[mtxIdx]) : normal);
+
+    // Zero when the draw carries none, which the shader reads as "no usable
+    // coordinate" and falls back to the average colour for.
+    float u = 0.f;
+    float v = 0.f;
+    bool haveCoordinate = false;
+    if (!ortho && texLayout.present && texBytes != 0) {
+      const uint8_t* tsrc = nullptr;
+      bool tle = false;
+      if (texIndexed) {
+        const uint32_t tindex = (texLayout.type == GX_INDEX8)
+                                    ? vtx[texLayout.offset]
+                                    : read_u16_be(vtx + texLayout.offset);
+        const size_t toff = static_cast<size_t>(tindex) * texArray.stride;
+        if (texArray.data != nullptr && toff + texBytes <= texArray.size) {
+          tsrc = static_cast<const uint8_t*>(texArray.data) + toff;
+          tle = texArray.le;
+        }
+      } else if (texLayout.offset + texBytes <= vtxSize) {
+        tsrc = vtx + texLayout.offset;
+      }
+      haveCoordinate = tsrc != nullptr && decode_texcoord(tsrc, texFmt, tle, u, v);
+      if (!haveCoordinate) {
+        u = 0.f;
+        v = 0.f;
+      }
+    }
+    // Then through the stage's generator, as the vertex shader runs it
+    // (gx/shader.cpp). A vertex it fails on keeps zero, like one that carries
+    // no coordinate at all.
+    if (!ortho && texgen.tcg != nullptr) {
+      Vec3 tc{u, v, 1.f};
+      if (texgen.source == Texgen::Source::Position) {
+        tc = local;
+        haveCoordinate = true;
+      } else if (texgen.source == Texgen::Source::Normal) {
+        tc = normal;
+        haveCoordinate = haveNormal;
+      }
+      const uint32_t vertexMtx = texMtxPerVertex && texMtxLayout.offset < vtxSize
+                                     ? static_cast<uint32_t>(vtx[texMtxLayout.offset])
+                                     : UINT32_MAX;
+      if (!haveCoordinate || !generate_texcoord(*texgen.tcg, vertexMtx, tc, u, v)) {
+        u = 0.f;
+        v = 0.f;
+      }
+    }
+    uvs.push_back(Vec3{u, v, 0.f});
+    if (!ortho && texLayout.present) {
+      for (const float c : {u, v}) {
+        if (!g_haveUv) {
+          g_uvMin = g_uvMax = c;
+          g_haveUv = true;
+        } else {
+          g_uvMin = c < g_uvMin ? c : g_uvMin;
+          g_uvMax = c > g_uvMax ? c : g_uvMax;
+        }
+      }
+    }
+  }
+
+  // An orthographic draw stops here: its only contribution is the region of the
+  // screen the trace must not shade.
+  if (ortho) {
+    if (g_maskEnabled) {
+      mark_ortho_coverage(verts, proj);
+    }
+    return;
+  }
+
+  const auto track = [](const Vec3& v) {
+    if (!g_haveBounds) {
+      g_boundsMin[0] = g_boundsMax[0] = v.x;
+      g_boundsMin[1] = g_boundsMax[1] = v.y;
+      g_boundsMin[2] = g_boundsMax[2] = v.z;
+      g_haveBounds = true;
+      return;
+    }
+    g_boundsMin[0] = v.x < g_boundsMin[0] ? v.x : g_boundsMin[0];
+    g_boundsMin[1] = v.y < g_boundsMin[1] ? v.y : g_boundsMin[1];
+    g_boundsMin[2] = v.z < g_boundsMin[2] ? v.z : g_boundsMin[2];
+    g_boundsMax[0] = v.x > g_boundsMax[0] ? v.x : g_boundsMax[0];
+    g_boundsMax[1] = v.y > g_boundsMax[1] ? v.y : g_boundsMax[1];
+    g_boundsMax[2] = v.z > g_boundsMax[2] ? v.z : g_boundsMax[2];
+  };
+
+  // The second hash exists only to answer whether reference-space baking earns
+  // its keep on this scene, and it costs a hash per vertex, so it stays off
+  // unless someone is asking.
+  const auto mix64 = [](uint64_t h, float f) {
+    uint32_t bits;
+    std::memcpy(&bits, &f, sizeof(bits));
+    return (h ^ bits) * 0x100000001b3ull;
+  };
+  // A draw with one matrix goes in untransformed and gets an instance; one with
+  // per-vertex matrices is baked, since no single instance transform describes
+  // it. Either way the emitted positions are what the BLAS and the hash see.
+  // A draw can only take an instance if one matrix covers it and that matrix is
+  // actually usable; otherwise its vertices are baked and it takes the identity.
+  float drawTransform[12] = {1.f, 0.f, 0.f, 0.f, 0.f, 1.f, 0.f, 0.f, 0.f, 0.f, 1.f, 0.f};
+  bool baked = true;
+  if (g_useInstances && singleMatrix && firstMtxIdx != UINT32_MAX) {
+    float candidate[12];
+    flatten(g_gxState.pnMtx[firstMtxIdx], candidate);
+    if (affine_is_usable(candidate)) {
+      std::memcpy(drawTransform, candidate, sizeof(drawTransform));
+      baked = false;
+    } else {
+      ++g_drawsSingularMatrix;
+    }
+  }
+  const std::vector<Vec3>& outPositions = baked ? verts : locals;
+  const std::vector<Vec3>& outNormals = baked ? nrmsView : nrmsLocal;
+
+  // Two different questions. The view-space position feeds the scene bounds and
+  // decides what the trace can reach, so it has to be finite and within reach.
+  // The position that goes into the acceleration structure is in the draw's own
+  // space when the draw takes an instance, and there only finiteness matters.
+  // The first version bounded that one too and dropped 20 191 triangles on
+  // w01Dll: a GX_F32 strip whose own z ran to 709 987 while its instance
+  // transform put it 477 units in front of the camera.
+  const auto finiteComponents = [](const Vec3& p) {
+    return std::isfinite(p.x) && std::isfinite(p.y) && std::isfinite(p.z);
+  };
+  const auto withinReach = [](const Vec3& p) {
+    for (const float c : {p.x, p.y, p.z}) {
+      if (c > kMaxPositionMagnitude || c < -kMaxPositionMagnitude) {
+        return false;
+      }
+    }
+    return true;
+  };
+  const auto usable = [&](size_t idx) {
+    return finiteComponents(verts[idx]) && withinReach(verts[idx]) &&
+           finiteComponents(outPositions[idx]);
+  };
+
+  const auto emit = [&](size_t ia, size_t ib, size_t ic) {
+    // A position that is not a usable number stops here, before it reaches the
+    // scene bounds or the acceleration structure. m402Dll and m405Dll produced
+    // them: GX_F32 components pass through decode_position unchecked, and a
+    // baked draw is transformed by whatever its matrix slot holds. The bounds
+    // are seeded from the first vertex of the frame, so one NaN there left them
+    // NaN for the whole frame, and the occlusion radius and shadow range derived
+    // from them went to the shader as the reach of every ray.
+    if (!usable(ia) || !usable(ib) || !usable(ic)) {
+      ++g_rejectedTriangles;
+      if (!g_loggedRejectedPosition) {
+        g_loggedRejectedPosition = true;
+        const size_t bad = !usable(ia) ? ia : (!usable(ib) ? ib : ic);
+        const char* reason = !finiteComponents(verts[bad]) ? "not finite in view space"
+                             : !withinReach(verts[bad])   ? "beyond reach in view space"
+                                                          : "not finite in the draw's own space";
+        Log.warn("Dropped a triangle with an unusable position, {} (first occurrence; the rest are "
+                 "counted in the periodic report): primitive {:#x}, vertex format {}, position type {} "
+                 "(0 U8, 1 S8, 2 U16, 3 S16, 4 F32) with {} fractional bits, {} data, matrix slot {} "
+                 "({}), {}; decoded ({:.1f}, {:.1f}, {:.1f}) -> view ({:.1f}, {:.1f}, {:.1f})",
+                 reason, static_cast<int>(prim), static_cast<int>(fmt), static_cast<int>(attrFmt.type),
+                 static_cast<int>(attrFmt.frac), indexed ? "indexed" : "direct",
+                 firstMtxIdx == UINT32_MAX ? -1 : static_cast<int>(firstMtxIdx),
+                 singleMatrix ? "one matrix" : "per-vertex matrices", baked ? "baked" : "instanced",
+                 locals[bad].x, locals[bad].y, locals[bad].z, verts[bad].x, verts[bad].y, verts[bad].z);
+      }
+      return;
+    }
+    track(verts[ia]);
+    track(verts[ib]);
+    track(verts[ic]);
+    for (const size_t idx : {ia, ib, ic}) {
+      g_triangles.push_back(outPositions[idx]);
+      g_colours.push_back(cols[idx]);
+      g_normals.push_back(outNormals[idx]);
+      g_texcoords.push_back(uvs[idx]);
+      g_contentHash = mix64(mix64(mix64(g_contentHash, outPositions[idx].x),
+                                  outPositions[idx].y),
+                            outPositions[idx].z);
+      if (measureCamera) {
+        g_viewHash = mix64(mix64(mix64(g_viewHash, verts[idx].x), verts[idx].y), verts[idx].z);
+      }
+    }
+    g_materials.push_back(material);
+    g_contentHash = (g_contentHash ^ material) * 0x100000001b3ull;
+  };
+
+  const auto recordDraw = [&] {
+    const uint32_t triangles = static_cast<uint32_t>(g_triangles.size() / 3 - trianglesBefore);
+    if (triangles == 0) {
+      return;
+    }
+    if (projIndex != SIZE_MAX) {
+      g_projections[projIndex].triangles += triangles;
+    }
+    // One group per draw: a triangle range in the shared buffers, plus the
+    // transform that places it. Baked draws carry the identity, since their
+    // vertices are already where they belong.
+    accel::DrawGroup group{};
+    group.firstTriangle = static_cast<uint32_t>(trianglesBefore);
+    group.triangleCount = triangles;
+    std::memcpy(group.transform, drawTransform, sizeof(group.transform));
+    group.additive = (material & accel::MaterialAdditive) != 0u;
+
+    // Consecutive draws of one model share its matrix, and their triangles are
+    // already adjacent, so they can share a structure. Each group costs a BLAS
+    // build, and building many small ones is far more expensive than building
+    // one large one -- measured at 186 ms for 1296 of them.
+    if (!g_groups.empty()) {
+      accel::DrawGroup& last = g_groups.back();
+      // Additive light is never merged with a solid draw: the instance mask
+      // that keeps it out of the rays belongs to the whole group.
+      if (last.firstTriangle + last.triangleCount == group.firstTriangle &&
+          last.additive == group.additive &&
+          std::memcmp(last.transform, group.transform, sizeof(group.transform)) == 0) {
+        last.triangleCount += group.triangleCount;
+        if (measureCamera) {
+          g_drawHashes.push_back(localHash);
+          g_drawTriangles.push_back(triangles);
+        }
+        return;
+      }
+    }
+    g_groups.push_back(group);
+
+    if (measureCamera) {
+      g_drawHashes.push_back(localHash);
+      g_drawTriangles.push_back(triangles);
+    }
+  };
+
+  switch (prim) {
+  case GX_TRIANGLES:
+    for (size_t i = 0; i + 2 < verts.size(); i += 3) {
+      emit(i, i + 1, i + 2);
+    }
+    break;
+  case GX_TRIANGLESTRIP:
+    for (size_t i = 0; i + 2 < verts.size(); ++i) {
+      // Winding alternates along a strip.
+      if ((i & 1u) == 0u) {
+        emit(i, i + 1, i + 2);
+      } else {
+        emit(i + 1, i, i + 2);
+      }
+    }
+    break;
+  case GX_TRIANGLEFAN:
+    for (size_t i = 1; i + 1 < verts.size(); ++i) {
+      emit(0, i, i + 1);
+    }
+    break;
+  case GX_QUADS:
+    for (size_t i = 0; i + 3 < verts.size(); i += 4) {
+      emit(i, i + 1, i + 2);
+      emit(i, i + 2, i + 3);
+    }
+    break;
+  default:
+    break;
+  }
+  recordDraw();
+}
