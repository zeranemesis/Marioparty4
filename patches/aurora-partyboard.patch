+
+bool build(const float* positions, const float* colours, const float* normals,
+           const float* texcoords, const uint32_t* materials, size_t vertexCount,
+           uint64_t contentHash,
+           const DrawGroup* groups, size_t groupCount) noexcept {
+  if (!caps().available || positions == nullptr || colours == nullptr || normals == nullptr ||
+      texcoords == nullptr || materials == nullptr || groups == nullptr || groupCount == 0 ||
+      vertexCount < 3) {
+    return false;
+  }
+  // Triangles only; a trailing partial triangle would read out of bounds.
+  vertexCount -= vertexCount % 3;
+
+  // Identical geometry means the BLAS from last frame still describes it, and
+  // rebuilding would produce the same bytes at full cost -- the largest single
+  // item in this pass's budget. The TLAS is still rebuilt: its instance carries
+  // the camera, which changes even when nothing in the scene does.
+  // The group split has to be part of the test, not just the vertices. Grouping
+  // depends on the transforms -- adjacent draws merge only while their matrices
+  // agree -- so a camera move can change it while the model-space positions,
+  // and therefore contentHash, stay identical. Reusing BLASes across a changed
+  // split leaves every instance pointing at an offset nothing was built at,
+  // which is a hung GPU rather than a wrong picture.
+  uint64_t layoutHash = 0xcbf29ce484222325ull;
+  for (size_t i = 0; i < groupCount; ++i) {
+    layoutHash = (layoutHash ^ groups[i].firstTriangle) * 0x100000001b3ull;
+    layoutHash = (layoutHash ^ groups[i].triangleCount) * 0x100000001b3ull;
+  }
+
+  const bool geometryUnchanged = g_stats.built && contentHash == g_contentHash &&
+                                 layoutHash == g_layoutHash &&
+                                 g_stats.triangleCount == vertexCount / 3;
+  g_stats.reusedThisFrame = geometryUnchanged;
+  if (geometryUnchanged) {
+    ++g_stats.reusedFrames;
+  }
+
+  const auto start = std::chrono::steady_clock::now();
+  if (!ensure_command_objects()) {
+    return false;
+  }
+
+  // Vertex upload. Grown geometrically so a steady frame stops reallocating.
+  const uint64_t vertexBytes = static_cast<uint64_t>(vertexCount) * 3 * sizeof(float);
+  if (!geometryUnchanged && vertexCount > g_vertexCapacity) {
+    const size_t capacity = vertexCount + vertexCount / 2;
+    if (!create_buffer(static_cast<uint64_t>(capacity) * 3 * sizeof(float), D3D12_HEAP_TYPE_UPLOAD,
+                       D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ,
+                       g_vertexBuffer)) {
+      return false;
+    }
+    if (!create_buffer(static_cast<uint64_t>(capacity) * 3 * sizeof(float), D3D12_HEAP_TYPE_UPLOAD,
+                       D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ,
+                       g_colourBuffer)) {
+      return false;
+    }
+    if (!create_buffer(static_cast<uint64_t>(capacity) * 3 * sizeof(float), D3D12_HEAP_TYPE_UPLOAD,
+                       D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ,
+                       g_normalBuffer)) {
+      return false;
+    }
+    if (!create_buffer(static_cast<uint64_t>(capacity) * 3 * sizeof(float), D3D12_HEAP_TYPE_UPLOAD,
+                       D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_GENERIC_READ,
+                       g_texcoordBuffer)) {
+      return false;
+    }
+    // One uint per triangle rather than per vertex, hence the /3.
+    if (!create_buffer(static_cast<uint64_t>(capacity / 3 + 1) * sizeof(uint32_t),
+                       D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_GENERIC_READ, g_materialBuffer)) {
+      return false;
+    }
+    const uint64_t geometryBytes = static_cast<uint64_t>(capacity) * 3 * sizeof(float);
+    const uint64_t materialBytes = static_cast<uint64_t>(capacity / 3 + 1) * sizeof(uint32_t);
+    if (!create_buffer(geometryBytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_COMMON, g_vertexGpu) ||
+        !create_buffer(geometryBytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_COMMON, g_colourGpu) ||
+        !create_buffer(geometryBytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_COMMON, g_normalGpu) ||
+        !create_buffer(geometryBytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_COMMON, g_texcoordGpu) ||
+        !create_buffer(materialBytes, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_COMMON, g_materialGpu)) {
+      return false;
+    }
+    g_geometryBytes = geometryBytes;
+    g_materialBytes = materialBytes;
+    g_vertexCapacity = capacity;
+  }
+  if (!geometryUnchanged) {
+    void* mapped = nullptr;
+    D3D12_RANGE noRead{0, 0};
+    if (FAILED(g_vertexBuffer->Map(0, &noRead, &mapped))) {
+      Log.error("Failed to map ray tracing vertex buffer");
+      return false;
+    }
+    std::memcpy(mapped, positions, vertexBytes);
+    D3D12_RANGE written{0, static_cast<SIZE_T>(vertexBytes)};
+    g_vertexBuffer->Unmap(0, &written);
+
+    mapped = nullptr;
+    if (FAILED(g_colourBuffer->Map(0, &noRead, &mapped))) {
+      Log.error("Failed to map ray tracing colour buffer");
+      return false;
+    }
+    std::memcpy(mapped, colours, vertexBytes);
+    g_colourBuffer->Unmap(0, &written);
+
+    mapped = nullptr;
+    if (FAILED(g_normalBuffer->Map(0, &noRead, &mapped))) {
+      Log.error("Failed to map ray tracing normal buffer");
+      return false;
+    }
+    std::memcpy(mapped, normals, vertexBytes);
+    g_normalBuffer->Unmap(0, &written);
+
+    mapped = nullptr;
+    if (FAILED(g_texcoordBuffer->Map(0, &noRead, &mapped))) {
+      Log.error("Failed to map ray tracing texture coordinate buffer");
+      return false;
+    }
+    std::memcpy(mapped, texcoords, vertexBytes);
+    g_texcoordBuffer->Unmap(0, &written);
+
+    mapped = nullptr;
+    if (FAILED(g_materialBuffer->Map(0, &noRead, &mapped))) {
+      Log.error("Failed to map ray tracing material buffer");
+      return false;
+    }
+    const uint64_t materialBytes = static_cast<uint64_t>(vertexCount / 3) * sizeof(uint32_t);
+    std::memcpy(mapped, materials, static_cast<size_t>(materialBytes));
+    D3D12_RANGE materialWritten{0, static_cast<SIZE_T>(materialBytes)};
+    g_materialBuffer->Unmap(0, &materialWritten);
+  }
+
+  // Every range must lie inside what was uploaded and the transforms must be
+  // finite: a geometry desc pointing past the vertex buffer, or an instance with
+  // a degenerate matrix, hangs the GPU rather than failing cleanly.
+  {
+    const uint32_t triangleTotal = static_cast<uint32_t>(vertexCount / 3);
+    for (size_t i = 0; i < groupCount; ++i) {
+      const uint64_t end =
+          static_cast<uint64_t>(groups[i].firstTriangle) + groups[i].triangleCount;
+      if (groups[i].triangleCount == 0 || end > triangleTotal) {
+        Log.error("Draw group {} covers triangles {}..{} of {}", i, groups[i].firstTriangle,
+                  end, triangleTotal);
+        return false;
+      }
+      for (uint32_t c = 0; c < 12; ++c) {
+        const float v = groups[i].transform[c];
+        if (!(v > -1e30f && v < 1e30f)) {
+          Log.error("Draw group {} has a non-finite transform", i);
+          return false;
+        }
+      }
+    }
+  }
+
+  if (rt_debug_enabled()) {
+    Log.info("Building {} groups, {} triangles", groupCount, vertexCount / 3);
+  }
+
+  // One BLAS per group, each holding that group's triangles alone, all
+  // sub-allocated from a single buffer. They have to be separate: a BLAS is
+  // what an instance points at, so a shared one would put the entire scene
+  // behind every transform.
+  g_geometries.resize(groupCount);
+  g_blasOffsets.resize(groupCount);
+  const D3D12_GPU_VIRTUAL_ADDRESS vertexBase = g_vertexGpu->GetGPUVirtualAddress();
+  for (size_t i = 0; i < groupCount; ++i) {
+    D3D12_RAYTRACING_GEOMETRY_DESC& geometry = g_geometries[i];
+    geometry = {};
+    geometry.Type = D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES;
+    // Opaque unless the group holds textured cut-out triangles -- surfaces with
+    // holes. Those are left for the shader's candidate loop, which tests them
+    // against their texture's alpha; everything else resolves without
+    // candidates. This used to be opaque for all, with a note that alpha-tested
+    // surfaces were 0.31% of pixels -- they are 6 to 35% of draws in the
+    // mini-games swept since.
+    //
+    // Holes only, not haze. A uniformly translucent surface is blended, not
+    // tested: a texel at 0.6 alpha lets 40% through. The first version tested
+    // those too, and on m401Dll the water surface and the shafts of light went
+    // from partial to total occluders, darkening the whole upper scene. They
+    // keep their whole-texture weight, as before.
+    bool holedTextured = false;
+    for (uint32_t t = 0; t < groups[i].triangleCount && !holedTextured; ++t) {
+      const uint32_t m = materials[groups[i].firstTriangle + t];
+      holedTextured = (m & MaterialCutout) != 0u && ((m >> MaterialThumbnailShift) & 0xffffu) != 0u;
+    }
+    geometry.Flags = holedTextured ? D3D12_RAYTRACING_GEOMETRY_FLAG_NONE
+                                   : D3D12_RAYTRACING_GEOMETRY_FLAG_OPAQUE;
+    geometry.Triangles.VertexBuffer.StartAddress =
+        vertexBase + static_cast<uint64_t>(groups[i].firstTriangle) * 3 * 3 * sizeof(float);
+    geometry.Triangles.VertexBuffer.StrideInBytes = 3 * sizeof(float);
+    geometry.Triangles.VertexCount = groups[i].triangleCount * 3;
+    geometry.Triangles.VertexFormat = DXGI_FORMAT_R32G32B32_FLOAT;
+    geometry.Triangles.Transform3x4 = 0;
+  }
+
+  // Sizes first, so the whole set can share one allocation. Acceleration
+  // structures must start on a 256-byte boundary.
+  constexpr uint64_t kAlign = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BYTE_ALIGNMENT;
+  uint64_t blasTotal = 0;
+  uint64_t blasScratchTotal = 0;
+  g_scratchOffsets.resize(groupCount);
+  for (size_t i = 0; i < groupCount; ++i) {
+    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS inputs{};
+    inputs.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
+    inputs.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
+    inputs.Flags = g_fastBuild
+                       ? D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_BUILD
+                       : D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
+    inputs.NumDescs = 1;
+    inputs.pGeometryDescs = &g_geometries[i];
+
+    D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO info{};
+    device()->GetRaytracingAccelerationStructurePrebuildInfo(&inputs, &info);
+    g_blasOffsets[i] = blasTotal;
+    blasTotal += (info.ResultDataMaxSizeInBytes + kAlign - 1) & ~(kAlign - 1);
+    // Scratch per build rather than one shared region: sharing it would force a
+    // barrier between every build, which serialises the GPU. Measured at 304.9
+    // ms that way against 1.7 ms for the single structure it replaced.
+    g_scratchOffsets[i] = blasScratchTotal;
+    blasScratchTotal += (info.ScratchDataSizeInBytes + kAlign - 1) & ~(kAlign - 1);
+  }
+
+  D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO blasInfo{};
+  blasInfo.ResultDataMaxSizeInBytes = blasTotal;
+  blasInfo.ScratchDataSizeInBytes = blasScratchTotal;
+
+  if (rt_debug_enabled() && groupCount != g_stats.groupCount) {
+    uint64_t smallest = UINT64_MAX;
+    uint64_t largest = 0;
+    for (size_t i = 0; i < groupCount; ++i) {
+      const uint64_t size =
+          (i + 1 < groupCount ? g_blasOffsets[i + 1] : blasTotal) - g_blasOffsets[i];
+      smallest = size < smallest ? size : smallest;
+      largest = size > largest ? size : largest;
+    }
+    Log.info("Sub-allocation: {} groups, {} KB total, per-BLAS {}..{} bytes, scratch {} KB",
+             groupCount, blasTotal / 1024, smallest, largest, blasScratchTotal / 1024);
+  }
+
+  D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS tlasInputs{};
+  tlasInputs.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
+  tlasInputs.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
+  tlasInputs.Flags = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
+  // AURORA_RT_ONE_INSTANCE keeps the split BLASes but puts a single instance in
+  // the TLAS. The picture is then wrong, which does not matter: it separates a
+  // hang caused by building many structures from one caused by instancing them.
+  const UINT instanceCount = g_oneInstance ? 1u : static_cast<UINT>(groupCount);
+  tlasInputs.NumDescs = instanceCount;
+
+  D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO tlasInfo{};
+  device()->GetRaytracingAccelerationStructurePrebuildInfo(&tlasInputs, &tlasInfo);
+
+  const uint64_t scratchNeeded =
+      blasInfo.ScratchDataSizeInBytes > tlasInfo.ScratchDataSizeInBytes
+          ? blasInfo.ScratchDataSizeInBytes
+          : tlasInfo.ScratchDataSizeInBytes;
+
+  if (scratchNeeded > g_scratchCapacity) {
+    if (!create_buffer(scratchNeeded, D3D12_HEAP_TYPE_DEFAULT,
+                       D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                       D3D12_RESOURCE_STATE_UNORDERED_ACCESS, g_scratch)) {
+      return false;
+    }
+    g_scratchCapacity = scratchNeeded;
+  }
+  if (blasInfo.ResultDataMaxSizeInBytes > g_blasCapacity) {
+    if (!create_buffer(blasInfo.ResultDataMaxSizeInBytes, D3D12_HEAP_TYPE_DEFAULT,
+                       D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                       D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, g_blas)) {
+      return false;
+    }
+    g_blasCapacity = blasInfo.ResultDataMaxSizeInBytes;
+  }
+  if (tlasInfo.ResultDataMaxSizeInBytes > g_tlasCapacity) {
+    if (!create_buffer(tlasInfo.ResultDataMaxSizeInBytes, D3D12_HEAP_TYPE_DEFAULT,
+                       D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+                       D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE, g_tlas)) {
+      return false;
+    }
+    g_tlasCapacity = tlasInfo.ResultDataMaxSizeInBytes;
+  }
+  if (groupCount > g_instanceCapacity) {
+    const size_t capacity = groupCount + groupCount / 2;
+    if (!create_buffer(capacity * sizeof(D3D12_RAYTRACING_INSTANCE_DESC),
+                       D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_FLAG_NONE,
+                       D3D12_RESOURCE_STATE_GENERIC_READ, g_instanceBuffer)) {
+      return false;
+    }
+    g_instanceCapacity = capacity;
+  }
+
+  // One instance per group, rewritten every frame: the transforms are where the
+  // animation lives now. InstanceID carries the group's first triangle so the
+  // shader can reach the colours, normals and material that go with the hit.
+  {
+    void* mapped = nullptr;
+    D3D12_RANGE noRead{0, 0};
+    if (FAILED(g_instanceBuffer->Map(0, &noRead, &mapped))) {
+      Log.error("Failed to map instance buffer");
+      return false;
+    }
+    auto* instances = static_cast<D3D12_RAYTRACING_INSTANCE_DESC*>(mapped);
+    const D3D12_GPU_VIRTUAL_ADDRESS blasAddress = g_blas->GetGPUVirtualAddress();
+    for (size_t i = 0; i < instanceCount; ++i) {
+      D3D12_RAYTRACING_INSTANCE_DESC& instance = instances[i];
+      instance = {};
+      std::memcpy(&instance.Transform[0][0], groups[i].transform, 12 * sizeof(float));
+      instance.InstanceID = groups[i].firstTriangle;
+      // 0x02 for additive light, 0x01 for everything else: a ray that
+      // includes only 0x01 goes straight through a glow or a light shaft.
+      instance.InstanceMask = groups[i].additive ? 0x02 : 0x01;
+      instance.InstanceContributionToHitGroupIndex = 0;
+      instance.AccelerationStructure = blasAddress + g_blasOffsets[i];
+    }
+    g_instanceBuffer->Unmap(0, nullptr);
+  }
+  tlasInputs.InstanceDescs = g_instanceBuffer->GetGPUVirtualAddress();
+
+  if (FAILED(g_allocator->Reset()) || FAILED(g_cmdList->Reset(g_allocator.Get(), nullptr))) {
+    Log.error("Failed to reset ray tracing command list");
+    return false;
+  }
+
+  if (!geometryUnchanged) {
+    // Staging into device memory before anything reads it. Buffers promote out
+    // of COMMON on first use, so only the copy-to-read transition is needed.
+    const uint64_t materialBytes = static_cast<uint64_t>(vertexCount / 3) * sizeof(uint32_t);
+    g_cmdList->CopyBufferRegion(g_vertexGpu.Get(), 0, g_vertexBuffer.Get(), 0, vertexBytes);
+    g_cmdList->CopyBufferRegion(g_colourGpu.Get(), 0, g_colourBuffer.Get(), 0, vertexBytes);
+    g_cmdList->CopyBufferRegion(g_normalGpu.Get(), 0, g_normalBuffer.Get(), 0, vertexBytes);
+    g_cmdList->CopyBufferRegion(g_texcoordGpu.Get(), 0, g_texcoordBuffer.Get(), 0, vertexBytes);
+    g_cmdList->CopyBufferRegion(g_materialGpu.Get(), 0, g_materialBuffer.Get(), 0, materialBytes);
+    transition(g_vertexGpu.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    transition(g_colourGpu.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    transition(g_normalGpu.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    transition(g_texcoordGpu.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    transition(g_materialGpu.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+               D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+
+    // Each build writes its own scratch region and its own destination, so they
+    // are independent and need no barrier between them. One barrier afterwards
+    // covers the whole set for the TLAS.
+    const D3D12_GPU_VIRTUAL_ADDRESS blasBase = g_blas->GetGPUVirtualAddress();
+    const D3D12_GPU_VIRTUAL_ADDRESS scratchBase = g_scratch->GetGPUVirtualAddress();
+    for (size_t i = 0; i < groupCount; ++i) {
+      D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS inputs{};
+      inputs.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
+      inputs.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
+      inputs.Flags = g_fastBuild
+                       ? D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_BUILD
+                       : D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
+      inputs.NumDescs = 1;
+      inputs.pGeometryDescs = &g_geometries[i];
+
+      D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC blasDesc{};
+      blasDesc.Inputs = inputs;
+      blasDesc.ScratchAccelerationStructureData = scratchBase + g_scratchOffsets[i];
+      blasDesc.DestAccelerationStructureData = blasBase + g_blasOffsets[i];
+      g_cmdList->BuildRaytracingAccelerationStructure(&blasDesc, 0, nullptr);
+    }
+    // One global UAV barrier rather than one per resource: it is what the
+    // vendor guidance asks for, and it covers every build at once.
+    uav_barrier(nullptr);
+  }
+
+  D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC tlasDesc{};
+  tlasDesc.Inputs = tlasInputs;
+  tlasDesc.ScratchAccelerationStructureData = g_scratch->GetGPUVirtualAddress();
+  tlasDesc.DestAccelerationStructureData = g_tlas->GetGPUVirtualAddress();
+  g_cmdList->BuildRaytracingAccelerationStructure(&tlasDesc, 0, nullptr);
+
+  if (FAILED(g_cmdList->Close())) {
+    Log.error("Failed to close ray tracing command list");
+    return false;
+  }
+  ID3D12CommandList* lists[] = {g_cmdList.Get()};
+  g_queue->ExecuteCommandLists(1, lists);
+  if (!wait_for_gpu()) {
+    Log.error("Timed out waiting for acceleration structure build");
+    return false;
+  }
+
+  const auto end = std::chrono::steady_clock::now();
+  g_stats.built = true;
+  g_contentHash = contentHash;
+  g_layoutHash = layoutHash;
+  g_stats.triangleCount = static_cast<uint32_t>(vertexCount / 3);
+  g_stats.blasBytes = blasInfo.ResultDataMaxSizeInBytes;
+  g_stats.tlasBytes = tlasInfo.ResultDataMaxSizeInBytes;
+  g_stats.scratchBytes = scratchNeeded;
+  g_stats.buildMs = std::chrono::duration<double, std::milli>(end - start).count();
+  // A real build is now rare, so its cost is worth seeing rather than averaging
+  // away: 1296 small structures cost more to build than one large one, and the
+  // whole design rests on that happening almost never.
+  if (g_stats.buildMs > g_stats.slowestBuildMs) {
+    g_stats.slowestBuildMs = g_stats.buildMs;
+  }
+  g_stats.groupCount = static_cast<uint32_t>(groupCount);
+  ++g_stats.rebuildCount;
+  if (rt_debug_enabled()) {
+    Log.info("Acceleration structure rebuild #{}: {} groups, {} triangles, {:.1f} ms",
+             g_stats.rebuildCount, groupCount, g_stats.triangleCount, g_stats.buildMs);
+  }
+  return true;
+}
+
+void shutdown() noexcept {
+  if (g_fenceEvent != nullptr) {
+    CloseHandle(g_fenceEvent);
+    g_fenceEvent = nullptr;
+  }
+  g_colourBuffer.Reset();
+  g_normalBuffer.Reset();
+  g_texcoordBuffer.Reset();
+  g_materialBuffer.Reset();
+  g_geometries.clear();
+  g_blasOffsets.clear();
+  g_scratchOffsets.clear();
+  g_instanceCapacity = 0;
+  g_contentHash = 0;
+  g_layoutHash = 0;
+  g_instanceBuffer.Reset();
+  g_tlas.Reset();
+  g_blas.Reset();
+  g_scratch.Reset();
+  g_vertexBuffer.Reset();
+  g_fence.Reset();
+  g_cmdList.Reset();
+  g_allocator.Reset();
+  g_queue.Reset();
+  g_vertexCapacity = 0;
+  g_scratchCapacity = 0;
+  g_blasCapacity = 0;
+  g_tlasCapacity = 0;
+  g_fenceValue = 0;
+  g_stats = {};
+}
+#endif
+
+} // namespace aurora::rt::accel
diff --git a/lib/rt/rt_accel.hpp b/lib/rt/rt_accel.hpp
new file mode 100644
index 0000000..20409f5
--- /dev/null
+++ b/lib/rt/rt_accel.hpp
@@ -0,0 +1,110 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace aurora::rt::accel {
+
+// Ray tracing acceleration structures built from captured GX geometry.
+//
+// One BLAS holds the whole frame as a single non-indexed triangle soup, and one
+// TLAS references it with an identity transform. That is deliberate for now:
+// GX indexes position matrices per vertex, so geometry cannot be split into
+// per-object BLAS entries with instance transforms without first grouping
+// vertices by matrix. Triangles arrive already in view space from rt_capture,
+// which side-steps the problem at the cost of a full rebuild each frame.
+//
+// Rebuilding is affordable here — GameCube-era scenes are tens of thousands of
+// triangles, not millions. See docs/RAYTRACING.md.
+
+struct AccelStats {
+  bool built = false;
+  uint32_t triangleCount = 0;
+  uint64_t blasBytes = 0;
+  uint64_t tlasBytes = 0;
+  uint64_t scratchBytes = 0;
+  double buildMs = 0.0;
+  double slowestBuildMs = 0.0;
+  uint32_t groupCount = 0;
+  uint32_t rebuildCount = 0;
+  // Frames whose geometry was byte-identical to the previous one, so the build
+  // was skipped entirely. Counted since startup.
+  uint64_t reusedFrames = 0;
+  bool reusedThisFrame = false;
+};
+
+// Builds BLAS and TLAS from `vertexCount` view-space positions, three per
+// triangle. Returns false and leaves the previous structures intact on failure.
+// `colours` holds one RGB triple per position, used by the indirect bounce.
+// `normals` holds one per position too, zero where the draw carried none.
+// What the ray tracer knows about a surface, all of it derived from state the
+// game already sets -- nothing invented, and no PBR conversion. One per
+// triangle, since a material belongs to the draw it came from.
+enum MaterialFlag : uint32_t {
+  // Texture coordinates generated from the normal: how the GameCube does
+  // environment mapping, so this is the game calling the surface reflective.
+  MaterialReflective = 1u << 0,
+  // Bound texture has substantially transparent texels: a cut-out.
+  MaterialCutout = 1u << 1,
+  // Bound texture is uniformly translucent rather than holed.
+  MaterialTranslucent = 1u << 2,
+  // Blended additively: the surface adds light and cannot occlude. Its draw
+  // group is kept out of the rays through the instance mask.
+  MaterialAdditive = 1u << 3,
+};
+
+// The high byte of the same word carries how much of a cut-out surface is
+// solid, 0..255. Cut-out geometry is traced as opaque -- alpha testing in
+// traversal would cost far more -- so a canopy of leaves blocks light like a
+// wall. Weighting a hit by this is not alpha testing and does not produce
+// hole-shaped light, but it stops a surface that is mostly holes from occluding
+// as though it were solid. Only meaningful with MaterialCutout set.
+enum : uint32_t {
+  MaterialOpacityShift = 8u,
+  MaterialOpacityMask = 0xffu,
+  // Top half of the word: which thumbnail in the ray tracing texture registry
+  // this surface uses, 0 for none. See rt_textures.hpp.
+  MaterialThumbnailShift = 16u,
+  MaterialThumbnailMask = 0xffffu,
+};
+
+// `materials` holds one MaterialFlag set per triangle, so vertexCount / 3.
+// `contentHash` identifies the geometry: when it matches the last successful
+// build, the structures are still valid and the build is skipped. The caller
+// accumulates it while emitting triangles, so it costs no extra pass.
+// One captured draw: a contiguous run of triangles in the shared buffers, and
+// the row-major 3x4 that places it in the space the rays are traced in.
+//
+// Splitting the scene this way is what lets the structures survive motion. The
+// meshes are rigid -- measured at 100% of source vertices unchanged between
+// frames -- so everything moves through these transforms, which live in TLAS
+// instances and cost a TLAS rebuild rather than a BLAS one.
+struct DrawGroup {
+  uint32_t firstTriangle = 0;
+  uint32_t triangleCount = 0;
+  float transform[12] = {1.f, 0.f, 0.f, 0.f, 0.f, 1.f, 0.f, 0.f, 0.f, 0.f, 1.f, 0.f};
+  // Every draw in the group is blended additively. Groups never mix the two,
+  // since the instance mask that leaves additive light out of the rays is per
+  // group.
+  bool additive = false;
+};
+
+bool build(const float* positions, const float* colours, const float* normals,
+           const float* texcoords, const uint32_t* materials, size_t vertexCount, uint64_t contentHash,
+           const DrawGroup* groups, size_t groupCount) noexcept;
+
+const AccelStats& stats() noexcept;
+
+// Resources the tracing pass binds, as opaque ID3D12Resource pointers so this
+// header stays free of d3d12.h. Null before the first successful build.
+void* tlas_resource() noexcept;
+void* vertex_resource() noexcept;
+void* colour_resource() noexcept;
+void* normal_resource() noexcept;
+void* texcoord_resource() noexcept;
+void* material_resource() noexcept;
+uint32_t vertex_count() noexcept;
+
+void shutdown() noexcept;
+
+} // namespace aurora::rt::accel
diff --git a/lib/rt/rt_capture.cpp b/lib/rt/rt_capture.cpp
new file mode 100644
index 0000000..8d841e2
--- /dev/null
+++ b/lib/rt/rt_capture.cpp
@@ -0,0 +1,2533 @@
+#include "rt_capture.hpp"
+
+#include "rt_accel.hpp"
+#include "rt_device.hpp"
