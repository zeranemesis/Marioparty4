+u32 AuroraPrecompilePipelines(void) {
+  u32 lastLogged = 0;
+  return static_cast<u32>(aurora::gfx::wait_for_pipeline_cache([&](size_t created, size_t total) {
+    // One line per 25% rather than per pipeline: this runs hundreds of times and
+    // the log is the only feedback there is while the window is not yet drawing.
+    if (total == 0) {
+      return;
+    }
+    const auto percent = static_cast<u32>(created * 100 / total);
+    if (percent >= lastLogged + 25) {
+      lastLogged = percent - percent % 25;
+      Log.info("Precompiling shaders: {}% ({}/{})", lastLogged, created, total);
+    }
+  }));
+}
