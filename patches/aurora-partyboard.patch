+// Layout of one attribute inside a vertex of the current format.
+struct AttrLayout {
+  GXAttrType type = GX_NONE;
+  uint32_t offset = 0; // byte offset within the vertex
+  bool present = false;
+};
+
+// GX data is big-endian; only the attribute arrays carry an endianness flag.
+uint16_t read_u16_be(const uint8_t* p) noexcept {
+  return static_cast<uint16_t>((static_cast<uint16_t>(p[0]) << 8) | p[1]);
+}
+uint16_t read_u16_le(const uint8_t* p) noexcept {
+  return static_cast<uint16_t>((static_cast<uint16_t>(p[1]) << 8) | p[0]);
+}
+float read_f32(const uint8_t* p, bool le) noexcept {
+  uint8_t b[4];
+  if (le) {
+    b[0] = p[0];
+    b[1] = p[1];
+    b[2] = p[2];
+    b[3] = p[3];
+  } else {
+    b[0] = p[3];
+    b[1] = p[2];
+    b[2] = p[1];
+    b[3] = p[0];
+  }
+  float f;
+  std::memcpy(&f, b, 4);
+  return f;
+}
