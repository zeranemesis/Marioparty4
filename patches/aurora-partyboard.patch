+/* Test-only input bridge.  A short SendInput key pulse can fall between two
+ * PADRead calls, especially at high render rates.  The launcher writes
+ * "counter port buttons frames" here; a command is latched for a few reads
+ * and is ignored unless the audio diagnostic marker is present. */
+void poll_automation_input() {
+  const char* appData = std::getenv("APPDATA");
+  if (appData == nullptr || appData[0] == '\0')
+    return;
+  char path[1024];
+  /* Reuse the diagnostic marker as the command channel so no extra file or
+   * permission is needed in the user's configuration directory. */
+  std::snprintf(path, sizeof(path), "%s\\MarioPartyRD\\Party Board\\audio_diagnostics.enable", appData);
+  FILE* file = std::fopen(path, "rb");
+  if (file == nullptr)
+    return;
+
+  unsigned counter = 0;
+  unsigned port = 0;
+  unsigned buttons = 0;
+  unsigned frames = 0;
+  const int parsed = std::fscanf(file, "%u %u %x %u", &counter, &port, &buttons, &frames);
+  std::fclose(file);
+  if (parsed != 4 || port >= PAD_CHANMAX || counter == g_automationLastCounter)
+    return;
+
+  g_automationLastCounter = counter;
+  g_automationPulseButtons[port] = static_cast<PADButton>(buttons);
+  g_automationPulseFrames[port] = static_cast<uint8_t>(std::clamp(frames, 1u, 30u));
+}
