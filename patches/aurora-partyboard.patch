+
+void wait_idle() noexcept {
+  // Before the first trace there is no queue and nothing to wait for.
+  if (!g_queue || !g_fence || g_fenceEvent == nullptr) {
+    return;
+  }
+  // Whether the dispatch was still running is the entire question this guards
+  // against, so it is counted rather than assumed: a wait that never actually
+  // waits would mean the hazard is theoretical on this hardware.
+  if (g_fence->GetCompletedValue() >= g_fenceValue) {
+    return;
+  }
+  ++g_stats.waitedFrames;
+  const auto start = std::chrono::steady_clock::now();
+  if (FAILED(g_fence->SetEventOnCompletion(g_fenceValue, g_fenceEvent))) {
+    Log.error("Failed to wait on the tracing fence");
+    return;
+  }
+  if (WaitForSingleObject(g_fenceEvent, 20000) != WAIT_OBJECT_0) {
+    Log.error("Timed out waiting for the tracing dispatch");
+    return;
+  }
+  g_stats.waitedMs += std::chrono::duration<double, std::milli>(
+                          std::chrono::steady_clock::now() - start)
+                          .count();
+}
+
+bool run(const TraceParams& params, const char* dumpPath) noexcept {
+  const uint32_t width = params.width;
+  const uint32_t height = params.height;
+  auto* tlas = static_cast<ID3D12Resource*>(accel::tlas_resource());
+  auto* verts = static_cast<ID3D12Resource*>(accel::vertex_resource());
+  auto* cols = static_cast<ID3D12Resource*>(accel::colour_resource());
+  auto* nrms = static_cast<ID3D12Resource*>(accel::normal_resource());
+  auto* mats = static_cast<ID3D12Resource*>(accel::material_resource());
+  auto* uvs = static_cast<ID3D12Resource*>(accel::texcoord_resource());
+  if (!caps().available || tlas == nullptr || verts == nullptr || cols == nullptr ||
+      nrms == nullptr || mats == nullptr || uvs == nullptr) {
+    return false;
+  }
+  // The previous frame's dispatch was left running. Everything below can pull
+  // the ground out from under it -- ensure_output releases the textures it
+  // writes, and the allocator reset is only legal once the GPU has finished
+  // with the commands it holds -- so the wait comes first.
+  wait_idle();
+
+  // The dispatch that wrote them has just been waited on, so this costs nothing.
+  if (g_timestampPending && g_timestampReadback && g_timestampFrequency != 0) {
+    g_timestampPending = false;
+    void* mapped = nullptr;
+    D3D12_RANGE readRange{0, 2 * sizeof(uint64_t)};
+    if (SUCCEEDED(g_timestampReadback->Map(0, &readRange, &mapped))) {
+      const auto* ticks = static_cast<const uint64_t*>(mapped);
+      if (ticks[1] > ticks[0]) {
+        g_stats.traceMs = 1000.0 * static_cast<double>(ticks[1] - ticks[0]) /
+                          static_cast<double>(g_timestampFrequency);
+      }
+      D3D12_RANGE noWrite{0, 0};
+      g_timestampReadback->Unmap(0, &noWrite);
+    }
+  }
+
+  if (!create_pipeline() || !ensure_output(width, height)) {
+    return false;
+  }
+
+  const auto start = std::chrono::steady_clock::now();
+
+  if (FAILED(g_allocator->Reset()) || FAILED(g_cmdList->Reset(g_allocator.Get(), g_pso.Get()))) {
+    Log.error("Failed to reset tracing command list");
+    return false;
+  }
+
+  Constants constants{};
+  std::memcpy(constants.proj, params.proj, sizeof(constants.proj));
+  std::memcpy(constants.light, params.light, sizeof(constants.light));
+  constants.lightRadius = params.lightRadius;
+  constants.shadowRange = params.shadowRange;
+  constants.debugMode = params.debugMode;
+  constants.features = params.features;
+  constants.shadowSamples = params.shadowSamples;
+  constants.reflectionRange = params.reflectionRange;
+  constants.bounceStrength = params.bounceStrength;
+  constants.dims[0] = width;
+  constants.dims[1] = height;
+  constants.sampleCount = params.aoSamples;
+  constants.rayLength = params.aoRadius;
+  const uint32_t maskCount = params.orthoMask != nullptr ? params.maskCols * params.maskRows : 0u;
+  const D3D12_GPU_VIRTUAL_ADDRESS maskAddress = upload_mask(params.orthoMask, maskCount);
+  const D3D12_GPU_VIRTUAL_ADDRESS thumbAddress = upload_thumbnails();
+  constants.thumbnailCount = thumbAddress != 0 ? static_cast<uint32_t>(textures::count()) : 0u;
+  // The shadow and occlusion views are the same continuous signal the
+  // composition uses, so they accumulate and are filtered like it: a diagnostic
+  // that skips both shows a buffer nobody ever sees. The categorical views --
+  // material flags, primitive index, texture coordinates -- are left alone,
+  // where averaging two neighbours would invent a value that means nothing.
+  const bool filterableDebug = params.debugMode == 0 || params.debugMode == DebugShadow ||
+                               params.debugMode == DebugOcclusion;
+  // The history view needs the accumulation running to have anything to show.
+  const bool wantsTemporal = filterableDebug || params.debugMode == DebugHistory;
+  constants.temporalAlpha = (wantsTemporal && !params.singleFrame) ? g_temporalAlpha : 1.0f;
+  // Held still when nothing is accumulating: a pattern that moves without
+  // converging is flicker, not detail. It also makes two single-frame traces of
+  // the same frame sample identically, which the A/B bench relies on.
+  constants.frameIndex = constants.temporalAlpha < 1.0f ? g_frameIndex : 0u;
+  if (params.advanceState) {
+    ++g_frameIndex;
+  }
+  constants.maskCols = maskAddress != 0 ? params.maskCols : 0u;
+  constants.maskRows = maskAddress != 0 ? params.maskRows : 0u;
+
+  ID3D12DescriptorHeap* heaps[] = {g_uavHeap.Get()};
+  g_cmdList->SetDescriptorHeaps(1, heaps);
+  g_cmdList->SetComputeRootSignature(g_rootSig.Get());
+  g_cmdList->SetComputeRoot32BitConstants(0, sizeof(Constants) / 4, &constants, 0);
+  g_cmdList->SetComputeRootShaderResourceView(1, tlas->GetGPUVirtualAddress());
+  g_cmdList->SetComputeRootShaderResourceView(2, verts->GetGPUVirtualAddress());
+  g_cmdList->SetComputeRootShaderResourceView(4, cols->GetGPUVirtualAddress());
+  g_cmdList->SetComputeRootShaderResourceView(5, nrms->GetGPUVirtualAddress());
+  g_cmdList->SetComputeRootShaderResourceView(6, mats->GetGPUVirtualAddress());
+  g_cmdList->SetComputeRootShaderResourceView(7, maskAddress != 0 ? maskAddress
+                                                                 : mats->GetGPUVirtualAddress());
+  g_cmdList->SetComputeRootShaderResourceView(8, uvs->GetGPUVirtualAddress());
+  g_cmdList->SetComputeRootShaderResourceView(
+      9, thumbAddress != 0 ? thumbAddress : mats->GetGPUVirtualAddress());
+  {
+    const uint32_t descStride =
+        device()->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_GPU_DESCRIPTOR_HANDLE traceTable = g_uavHeap->GetGPUDescriptorHandleForHeapStart();
+    traceTable.ptr += static_cast<UINT64>(g_frameParity * 3u) * descStride;
+    g_cmdList->SetComputeRootDescriptorTable(3, traceTable);
+  }
+
+  if (g_timestampHeap) {
+    g_cmdList->EndQuery(g_timestampHeap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0);
+  }
+  // Must match [numthreads] in rt_ao.hlsl, which is 16x8.
+  g_cmdList->Dispatch((width + 15) / 16, (height + 7) / 8, 1);
+
+  // Temporal pass: this frame's raw estimate against the history. It writes the
+  // accumulated value into g_output, which the filter starts from and Dawn
+  // imports, and hands the filter a variance in the alpha.
+  if (g_temporalPso) {
+    D3D12_RESOURCE_BARRIER temporalBarrier{};
+    temporalBarrier.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+    temporalBarrier.UAV.pResource = nullptr; // all UAV writes on this list
+    g_cmdList->ResourceBarrier(1, &temporalBarrier);
+
+    TemporalConstants tc{};
+    tc.dims[0] = width;
+    tc.dims[1] = height;
+    tc.alpha = constants.temporalAlpha;
+    tc.clampSigma = g_clampSigma;
+    tc.debugMode = params.debugMode;
+    tc.reproject = (g_reproject && params.haveViewDelta && !params.singleFrame) ? 1u : 0u;
+    std::memcpy(tc.proj, params.proj, sizeof(tc.proj));
+    std::memcpy(tc.prevProj, params.prevProj, sizeof(tc.prevProj));
+    std::memcpy(tc.viewDelta, params.viewDelta, sizeof(tc.viewDelta));
+
+    const uint32_t temporalStride =
+        device()->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_GPU_DESCRIPTOR_HANDLE temporalTable = g_uavHeap->GetGPUDescriptorHandleForHeapStart();
+    temporalTable.ptr += static_cast<UINT64>(6u + g_frameParity * 8u) * temporalStride;
+
+    g_cmdList->SetComputeRootSignature(g_temporalRootSig.Get());
+    g_cmdList->SetPipelineState(g_temporalPso.Get());
+    g_cmdList->SetComputeRoot32BitConstants(0, sizeof(TemporalConstants) / 4, &tc, 0);
+    g_cmdList->SetComputeRootDescriptorTable(1, temporalTable);
+    // Must match [numthreads] in rt_temporal.hlsl, which is 8x8.
+    g_cmdList->Dispatch((width + 7) / 8, (height + 7) / 8, 1);
+  }
+
+  // A-trous: a 3x3 kernel run repeatedly with the taps spaced 1, 2, 4, 8 pixels
+  // apart, so four cheap passes reach as far as a 31x31 filter would. An even
+  // number of passes is required: the ping-pong has to end back in g_output,
+  // which is the texture Dawn imports.
+  // Rounded up to even like the global setting: the ping-pong has to finish in
+  // the texture Dawn imports.
+  const uint32_t denoisePasses = params.denoisePasses >= 0
+                                     ? static_cast<uint32_t>((params.denoisePasses + 1) & ~1)
+                                     : g_denoisePasses;
+  const float luminancePhi = params.luminancePhi >= 0.f ? params.luminancePhi : g_luminancePhi;
+  if (g_denoisePso && denoisePasses > 0 && filterableDebug) {
+    const uint32_t stride =
+        device()->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    const D3D12_GPU_DESCRIPTOR_HANDLE heapBase = g_uavHeap->GetGPUDescriptorHandleForHeapStart();
+
+    g_cmdList->SetComputeRootSignature(g_denoiseRootSig.Get());
+    g_cmdList->SetPipelineState(g_denoisePso.Get());
+
+    for (uint32_t pass = 0; pass < denoisePasses; ++pass) {
+      // The previous pass writes what this one reads, so the UAV writes have to
+      // be visible before it starts.
+      D3D12_RESOURCE_BARRIER uavBarrier{};
+      uavBarrier.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+      uavBarrier.UAV.pResource = nullptr; // all UAV writes on this list
+      g_cmdList->ResourceBarrier(1, &uavBarrier);
+
+      DenoiseConstants dc{};
+      dc.dims[0] = width;
+      dc.dims[1] = height;
+      dc.step = 1u << pass;
+      // The normals here are geometric, one per triangle, so two pixels on the
+      // same curved surface already disagree by the facet angle. Tightening the
+      // test per pass (32, 64, 128, 256) rejected nearly every tap and left the
+      // grain in place: measured, that filtered 25% of it. A constant, gentler
+      // exponent lets the filter work, and depth carries the real edges -- it
+      // is trustworthy here because it comes from the primary ray itself.
+      dc.normalSharpness = 12.0f;
+      dc.depthTolerance = 0.04f;
+      dc.luminancePhi = luminancePhi;
+      dc.varianceGuided = g_varianceGuided ? 1u : 0u;
+
+      D3D12_GPU_DESCRIPTOR_HANDLE table = heapBase;
+      // 22 and 25 for parity 0, 28 and 31 for parity 1.
+      table.ptr += static_cast<UINT64>(22u + g_frameParity * 6u + ((pass % 2 == 0) ? 0u : 3u)) *
+                   stride;
+
+      g_cmdList->SetComputeRoot32BitConstants(0, sizeof(DenoiseConstants) / 4, &dc, 0);
+      g_cmdList->SetComputeRootDescriptorTable(1, table);
+      g_cmdList->Dispatch((width + 7) / 8, (height + 7) / 8, 1);
+    }
+  }
+
+  // The readback exists only to write the debug BMP and its mean. Doing it every
+  // frame copies the whole texture back and stalls on the GPU, which measured as
+  // the dominant cost of this pass — far above the rays themselves.
+  const bool readback = dumpPath != nullptr;
+
+  D3D12_RESOURCE_BARRIER toCopy{};
+  toCopy.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  toCopy.Transition.pResource = g_output.Get();
+  toCopy.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  toCopy.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  toCopy.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  if (readback) {
+    g_cmdList->ResourceBarrier(1, &toCopy);
+  }
+
+  const uint32_t rowPitch =
+      (width * 8 + D3D12_TEXTURE_DATA_PITCH_ALIGNMENT - 1) & ~(D3D12_TEXTURE_DATA_PITCH_ALIGNMENT - 1);
+  D3D12_TEXTURE_COPY_LOCATION dst{};
+  dst.pResource = g_readback.Get();
+  dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  dst.PlacedFootprint.Footprint.Width = width;
+  dst.PlacedFootprint.Footprint.Height = height;
+  dst.PlacedFootprint.Footprint.Depth = 1;
+  dst.PlacedFootprint.Footprint.RowPitch = rowPitch;
+
+  D3D12_TEXTURE_COPY_LOCATION src{};
+  src.pResource = g_output.Get();
+  src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  src.SubresourceIndex = 0;
+  if (readback) {
+    g_cmdList->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+
+    D3D12_RESOURCE_BARRIER back = toCopy;
+    back.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    back.Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    g_cmdList->ResourceBarrier(1, &back);
+  }
+
+  if (g_timestampHeap && g_timestampReadback) {
+    g_cmdList->EndQuery(g_timestampHeap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 1);
+    g_cmdList->ResolveQueryData(g_timestampHeap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0, 2,
+                                g_timestampReadback.Get(), 0);
+    g_timestampPending = true;
+  }
+
+  if (FAILED(g_cmdList->Close())) {
+    Log.error("Failed to close tracing command list");
+    return false;
+  }
+  ID3D12CommandList* lists[] = {g_cmdList.Get()};
+  g_queue->ExecuteCommandLists(1, lists);
+
+  // Signal the shared fence before the CPU wait, so a consumer that only needs
+  // the GPU result never has to wait on us.
+  if (g_sharedFence) {
+    ++g_sharedFenceValue;
+    if (FAILED(g_queue->Signal(g_sharedFence.Get(), g_sharedFenceValue))) {
+      Log.warn("Failed to signal the shared fence");
+    }
+  }
+
+  // The shared fence answers to Dawn. This one answers to us: it is how
+  // wait_idle() knows whether this dispatch has finished, which is what makes
+  // it safe to release what the dispatch reads.
+  if (FAILED(g_queue->Signal(g_fence.Get(), ++g_fenceValue))) {
+    Log.warn("Failed to signal the tracing fence");
+  }
+
+  // Dawn's wait on the shared fence orders the GPU, but it tells this thread
+  // nothing, so the dispatch is still running when this returns. That is
+  // deliberate -- it buys a frame of overlap -- and it is why every caller that
+  // touches what the dispatch reads goes through wait_idle() first. Only the
+  // readback needs the result on the CPU, here and now.
+  if (readback && !wait_for_gpu()) {
+    Log.error("Timed out waiting for the tracing dispatch");
+    return false;
+  }
+
+  const auto end = std::chrono::steady_clock::now();
+
+  if (params.advanceState) {
+    g_frameParity ^= 1u;
+  }
+  if (!readback) {
+    g_stats.traced = true;
+    g_stats.width = width;
+    g_stats.height = height;
+    g_stats.sampleCount = params.aoSamples;
+    // traceMs comes from the GPU timestamps read at the top of the next call.
+    // The stopwatch here would only time recording and submission.
+    g_stats.submitMs = std::chrono::duration<double, std::milli>(end - start).count();
+    return true;
+  }
+
+  std::vector<float> pixels(static_cast<size_t>(width) * height * 3, 1.f);
+  void* mapped = nullptr;
+  D3D12_RANGE readRange{0, static_cast<SIZE_T>(rowPitch) * height};
+  if (FAILED(g_readback->Map(0, &readRange, &mapped))) {
+    Log.error("Failed to map readback buffer");
+    return false;
+  }
+  double sum = 0.0;
+  for (uint32_t y = 0; y < height; ++y) {
+    const auto* row = reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(mapped) +
+                                                        static_cast<size_t>(y) * rowPitch);
+    for (uint32_t x = 0; x < width; ++x) {
+      const size_t base = (static_cast<size_t>(y) * width + x) * 3;
+      for (uint32_t c = 0; c < 3; ++c) {
+        pixels[base + c] = half_to_float(row[x * 4 + c]);
+      }
+      sum += pixels[base];
+    }
+  }
+  D3D12_RANGE noWrite{0, 0};
+  g_readback->Unmap(0, &noWrite);
+
+  const size_t pathLength = std::strlen(dumpPath);
+  if (pathLength > 4 && std::strcmp(dumpPath + pathLength - 4, ".pfm") == 0) {
+    write_pfm(dumpPath, pixels, width, height);
+  } else {
+    write_bmp(dumpPath, pixels, width, height);
+  }
+
+  g_stats.traced = true;
+  g_stats.width = width;
+  g_stats.height = height;
+  g_stats.sampleCount = params.aoSamples;
+  g_stats.traceMs = std::chrono::duration<double, std::milli>(end - start).count();
+  g_stats.averageAo = static_cast<float>(sum / (static_cast<double>(width) * height));
+  return true;
+}
+
+void shutdown() noexcept {
+  // Everything below is released, and a dispatch may still be reading it.
+  wait_idle();
+  if (g_fenceEvent != nullptr) {
+    CloseHandle(g_fenceEvent);
+    g_fenceEvent = nullptr;
+  }
+  if (g_sharedTextureHandle != nullptr) {
+    CloseHandle(g_sharedTextureHandle);
+    g_sharedTextureHandle = nullptr;
+  }
+  if (g_sharedFenceHandle != nullptr) {
+    CloseHandle(g_sharedFenceHandle);
+    g_sharedFenceHandle = nullptr;
+  }
+  g_sharedFence.Reset();
+  g_sharedFenceValue = 0;
+  g_readback.Reset();
+  g_timestampHeap.Reset();
+  g_timestampReadback.Reset();
+  g_timestampFrequency = 0;
+  g_timestampPending = false;
+  g_maskBuffer.Reset();
+  g_thumbnailBuffer.Reset();
+  g_thumbnailCapacity = 0;
+  textures::shutdown();
+  g_maskCapacity = 0;
+  g_output.Reset();
+  g_reflection.Reset();
+  g_guide[0].Reset();
+  g_guide[1].Reset();
+  g_history[0].Reset();
+  g_history[1].Reset();
+  g_scratch.Reset();
+  g_moments[0].Reset();
+  g_moments[1].Reset();
+  g_uavHeap.Reset();
+  g_temporalPso.Reset();
+  g_temporalRootSig.Reset();
+  g_denoisePso.Reset();
+  g_denoiseRootSig.Reset();
+  g_pso.Reset();
+  g_rootSig.Reset();
+  g_fence.Reset();
+  g_cmdList.Reset();
+  g_allocator.Reset();
+  g_queue.Reset();
+  g_outWidth = 0;
+  g_outHeight = 0;
+  g_fenceValue = 0;
+  g_stats = {};
+}
+#endif
+
+} // namespace aurora::rt::trace
diff --git a/lib/rt/rt_trace.hpp b/lib/rt/rt_trace.hpp
new file mode 100644
index 0000000..f3c7b91
--- /dev/null
+++ b/lib/rt/rt_trace.hpp
@@ -0,0 +1,140 @@
+#pragma once
+
+#include <cstdint>
+
+namespace aurora::rt::trace {
+
+struct TraceStats {
+  bool traced = false;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t sampleCount = 0;
+  // GPU time for the dispatch, from timestamp queries. Zero until the first
+  // frame's timestamps have been read back.
+  double traceMs = 0.0;
+  // CPU time to record and submit the command list. This is what traceMs used
+  // to hold, which made the pass look about twenty times cheaper than it is.
+  double submitMs = 0.0;
+  float averageAo = 0.0f; // 1.0 = fully open, 0.0 = fully occluded
+  // How often wait_idle() found the dispatch still running, and how long it
+  // spent there. Non-zero means the frame that follows was about to release or
+  // reset something the GPU was still reading.
+  uint64_t waitedFrames = 0;
+  double waitedMs = 0.0;
+};
+
+// Which terms the trace computes. Independent so ambient occlusion and shadows
+// can be turned on separately: they cost different amounts and suit different
+// scenes, and welding them together made "shadows off" impossible to express.
+enum Feature : uint32_t {
+  FeatureAmbientOcclusion = 1u << 0,
+  FeatureShadows = 1u << 1,
+  // Only surfaces the game itself environment maps are traced; see MaterialFlag.
+  FeatureReflections = 1u << 2,
+  // Test see-through candidates against their texture's alpha instead of
+  // counting them whole. Off, every candidate counts, which is how the geometry
+  // behaved while it was flagged opaque -- the A/B bench compares the two.
+  FeatureAlphaTest = 1u << 3,
+  // Leave additive surfaces out of every ray. Off, they are traced like any
+  // other surface, which is how they behaved before -- the A/B bench compares
+  // the two.
+  FeatureSkipAdditive = 1u << 4,
+  // Stratify the shadow disc -- sample i in its own ring, its angle from a
+  // radical inverse, both rotated per pixel -- instead of two white-noise draws
+  // per sample. Off, the white noise, which is how the penumbra was sampled
+  // before -- the A/B bench compares the two.
+  FeatureStratifiedShadow = 1u << 5,
+};
+
+struct TraceParams {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  float proj[4] = {0.f, 0.f, 0.f, 0.f}; // GX projection parameters, view space
+  // Brightest GX light in view space: xyz its position, w a flag that is 0 when
+  // the frame declared none, in which case no shadow ray is traced.
+  float light[4] = {0.f, 0.f, 0.f, 0.f};
+  // Angular radius of the light, as the tangent of its half-angle. 0 gives hard
+  // shadows, larger values widen the penumbra.
+  float lightRadius = 0.f;
+  // Caps how far a shadow ray travels, in view-space units.
+  float shadowRange = 0.f;
+  float bounceStrength = 0.f;
+  float aoRadius = 0.f;
+  uint32_t aoSamples = 0;
+  uint32_t shadowSamples = 0;
+  // How far a reflection ray travels, in view-space units.
+  float reflectionRange = 0.f;
+  uint32_t features = FeatureAmbientOcclusion | FeatureShadows;
+  // Coarse grid of the screen, non-zero where the game drew a 2D overlay. Those
+  // pixels get no occlusion, no shadow and no reflection: the composition
+  // multiplies the finished frame, interface included, so anything traced there
+  // shades the HUD rather than the scene. Null leaves every pixel shaded.
+  const uint32_t* orthoMask = nullptr;
+  uint32_t maskCols = 0;
+  uint32_t maskRows = 0;
+  // Diagnostic view instead of the composited result: 0 off, 1 shadow,
+  // 2 occlusion, 3 normals, 4 depth, 5 primitive id, 6 material, 7 reflection,
+  // 8 texture coordinates, 9 mask, 10 screen-space ramp. The two continuous
+  // ones are filtered like the real result, so what they show is what ships;
+  // the categorical ones bypass the denoiser, where averaging neighbours would
+  // invent a value that means nothing.
+  uint32_t debugMode = 0;
+  // A side trace that leaves nothing behind: it does not advance the frame
+  // counter that moves the sampling pattern, nor swap which history and guide
+  // buffers the next frame reads. The A/B bench traces its second setting this
+  // way, on the same frame and the same structures as the first.
+  bool advanceState = true;
+  // This frame's estimate alone: no temporal accumulation, and the sampling
+  // pattern held still, so two traces of one frame sample identically.
+  bool singleFrame = false;
+  // From this frame's view space to the previous frame's, row major 3x4, with
+  // that frame's projection parameters: where a pixel was, for the temporal
+  // pass to find its history there. False leaves the history at the same pixel.
+  float viewDelta[12] = {1.f, 0.f, 0.f, 0.f, 0.f, 1.f, 0.f, 0.f, 0.f, 0.f, 1.f, 0.f};
+  float prevProj[4] = {0.f, 0.f, 0.f, 0.f};
+  bool haveViewDelta = false;
+  // Per-trace denoiser overrides; negative keeps the global setting.
+  float luminancePhi = -1.f;
+  int32_t denoisePasses = -1;
+};
+
+// The two diagnostic views that carry a continuous signal rather than a label.
+constexpr uint32_t DebugShadow = 1u;
+constexpr uint32_t DebugOcclusion = 2u;
+// Where the temporal history survives its test; needs the accumulation running.
+constexpr uint32_t DebugHistory = 11u;
+
+// Traces against the current TLAS and, when `dumpPath` is not null, writes the
+// result: as raw floats when the path ends in .pfm, which the A/B bench
+// compares, otherwise as an 8-bit BMP clamped to [0, 1] for a quick look.
+//
+// Primary visibility is traced rather than rasterised, so nothing has to be
+// shared with Dawn's device for this to run. Only perspective projections are
+// handled; see docs/RAYTRACING.md.
+bool run(const TraceParams& params, const char* dumpPath) noexcept;
+
+const TraceStats& stats() noexcept;
+
+// Blocks until the last dispatch has finished on the GPU. Anything about to
+// release or overwrite what the trace reads -- the vertex, colour, normal and
+// material buffers, or the acceleration structures -- has to call this first.
+// D3D12 does not keep a resource alive because submitted work still refers to
+// it, and the dispatch is left running on purpose so the CPU can get on with
+// the frame.
+void wait_idle() noexcept;
+
+// Interop handles for importing the AO result into Dawn. The texture is created
+// shared and the fence is signalled after the dispatch, so the consumer waits on
+// `fence_value()` rather than stalling the CPU.
+void* shared_texture_handle() noexcept; // HANDLE, null before the first trace
+// Reflected colour in rgb, blend weight in a; zero everywhere when the feature
+// is off, which makes the composition a no-op rather than a second pipeline.
+void* shared_reflection_handle() noexcept;
+void* shared_fence_handle() noexcept;   // HANDLE, null before the first trace
+uint64_t fence_value() noexcept;
+uint32_t output_width() noexcept;
+uint32_t output_height() noexcept;
+
+void shutdown() noexcept;
+
+} // namespace aurora::rt::trace
