+}
+
+size_t wait_for_pipeline_cache(const PipelineCacheProgress& progress) {
+  // initialize_pipeline_cache() already queues every cached pipeline through
+  // load_pipeline_cache(), but creation is asynchronous: the game starts while
+  // the worker thread is still compiling, and a draw whose pipeline is not ready
+  // is dropped rather than delayed (gx/pipeline.cpp:18). Draining the queue up
+  // front is what turns a seeded cache into no pop-in at all, at the cost of a
+  // wait before the first frame.
+  if (g_pipelineCacheBroken) {
+    Log.warn("Not precompiling pipelines: the pipeline cache is unusable");
+    return 0;
+  }
+  const auto total = static_cast<size_t>(queuedPipelines.load());
+  if (total == 0) {
+    // Not the same as never running, and the difference matters: the background
+    // worker drains the queue while the prelaunch UI is up, so by the time the
+    // player presses play there may genuinely be nothing left to do. Silence here
+    // would be indistinguishable from the call never happening.
+    Log.info("Nothing to precompile: all {} cached pipelines were already built", createdPipelines.load());
+    return 0;
+  }
+
+  const auto start = std::chrono::steady_clock::now();
+  // A pipeline that never completes must not hang the game on startup, so the
+  // wait gives up rather than blocking forever; the queue keeps draining in the
+  // background afterwards exactly as it did before.
+  constexpr std::chrono::seconds Timeout{120};
+  size_t remaining = total;
+  while (true) {
+    if (!g_hasPipelineThread) {
+      // With no dedicated thread the worker only runs from end_pipeline_frame and
+      // stops after BuildPipelinesPerFrame, so it has to be driven directly here.
+      g_pipelinesPerFrame = 0;
+      pipeline_worker();
+    }
+    remaining = static_cast<size_t>(queuedPipelines.load());
+    if (progress) {
+      progress(total - remaining, total);
+    }
+    if (remaining == 0) {
+      break;
+    }
+    if (std::chrono::steady_clock::now() - start > Timeout) {
+      Log.warn("Gave up precompiling pipelines after {}s, {} of {} still queued", Timeout.count(), remaining, total);
+      break;
+    }
+    if (g_hasPipelineThread) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(4));
+    }
+  }
+
+  const auto elapsed =
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+  const auto built = total - remaining;
+  Log.info("Precompiled {} of {} pipelines in {}ms", built, total, elapsed);
+  return built;
+}
