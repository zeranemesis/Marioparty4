+      const float weight =
+          kKernel[dx + 1] * kKernel[dy + 1] * normalAgreement * depthAgreement * lumaAgreement;
+      if (weight <= 0.0f) {
+        continue;
+      }
+      sum += gSource[coord].rgb * weight;
+      weightSum += weight;
+      varianceSum += gSource[coord].a * weight * weight;
+    }
+  }
+
+  // weightSum can only be zero if every tap disagreed, centre included, which
+  // the kernel's own centre weight rules out; guard anyway rather than divide.
+  const float3 result = weightSum > 0.0f ? sum / weightSum : gSource[tid.xy].rgb;
+  // A weighted mean's variance shrinks with the square of its weights, so each
+  // later pass sees a smaller one and filters less: SVGF's propagation.
+  const float variance =
+      weightSum > 0.0f ? varianceSum / (weightSum * weightSum) : gSource[tid.xy].a;
+  gTarget[tid.xy] = float4(result, variance);
+}
