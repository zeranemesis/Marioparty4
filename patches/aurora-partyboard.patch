+
+      // Normal agreement. A high exponent makes this a near-binary test, which
+      // is what keeps a wall's occlusion off the floor it meets.
+      const float normalAgreement =
+          pow(saturate(dot(centreNormal, tapGuide.xyz)), gNormalSharpness);
+
+      // Depth agreement, relative to the centre's own distance: a 5 cm gap
+      // matters up close and is noise at the far end of the board.
+      const float depthDelta = abs(tapGuide.w - centreDepth) / max(centreDepth, 1e-4f);
+      const float depthAgreement = exp(-depthDelta / max(gDepthTolerance, 1e-5f));
+
+      // Signal agreement. The denominator is what makes this safe: where the
+      // estimate is still noisy the spread is large, every tap agrees, and the
+      // filter works as before; where it has converged the spread collapses and
+      // a real step in the signal cuts the tap out.
+      const float lumaDelta = abs(luminance(gSource[coord].rgb) - centreLuma);
+      const float lumaAgreement = exp(-lumaDelta / (gLuminancePhi * lumaSigma + 1e-3f));
