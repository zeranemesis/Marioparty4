new file mode 100644
index 0000000..1cb65be
--- /dev/null
+++ b/lib/rt/shaders/rt_temporal.hlsl
@@ -0,0 +1,204 @@
+// Temporal accumulation for the ray traced terms, between the trace -- which
+// writes this frame's raw estimate -- and the a-trous filter.
+//
+// It is a pass of its own because both of the things it adds need neighbours,
+// and the trace computes every pixel independently of the ones next to it:
+//
+//  * the history is clamped against the spread of this frame's 3x3
+//    neighbourhood, so a value that no longer describes the surface -- a shadow
+//    that has moved, an object that has gone -- is pulled in before it drags a
+//    trail behind it. Sampling noise sits inside the box and still averages.
+//    Salvi, "An Excursion in Temporal Supersampling" (2016).
+//
+//  * a luminance variance is carried forward from two accumulated moments and
+//    handed to the filter, which can then tell noise from a real edge; a pixel
+//    with too short a history uses the spatial variance of its neighbourhood
+//    instead. Schied et al., "Spatiotemporal Variance-Guided Filtering" (2017).
+//
+// There are still no motion vectors: a history survives where the same surface
+// is at the same pixel, judged by normal and hit distance. The clamp is what
+// keeps that test from being the only guard.
+
+RWTexture2D<float4> gCurrent : register(u0);    // this frame's raw estimate
+RWTexture2D<float4> gGuide : register(u1);      // normal in xyz, hit distance in w; 0 is a miss
+RWTexture2D<float4> gGuidePrev : register(u2);
+RWTexture2D<float4> gHistoryIn : register(u3);  // accumulated colour
+RWTexture2D<float4> gHistoryOut : register(u4);
+RWTexture2D<float4> gMomentsIn : register(u5);  // r mean luminance, g mean square, b history length
+RWTexture2D<float4> gMomentsOut : register(u6);
+RWTexture2D<float4> gOutput : register(u7);     // accumulated colour; a carries the variance
+
+cbuffer TemporalConstants : register(b0) {
+  uint2 gDims;
+  // Weight of this frame once the history is long enough. 1 disables the
+  // accumulation, and with it the clamp.
+  float gAlpha;
+  // Width of the clamp in standard deviations of the neighbourhood; 0 or less
+  // turns it off.
+  float gClampSigma;
+  uint gDebugMode;
+  // Whether to look the history up where this pixel was in the previous frame.
+  uint gReproject;
+  float2 gPad0;
+  // Projection parameters of this frame and of the previous one, as rt_ao.hlsl
+  // uses them to build a view ray.
+  float4 gProj;
+  float4 gProjPrev;
+  // This frame's view space to the previous frame's, row major 3x4: the
+  // camera's own motion, measured by the capture from the draws that held
+  // still.
+  float4 gDeltaRow0;
+  float4 gDeltaRow1;
+  float4 gDeltaRow2;
+};
+
+// Where this pixel was in the previous frame. Everything is traced in view
+// space, so a surface that did not move is displaced by the camera alone, and
+// that displacement is one affine transform. False when the pixel had no
+// previous position on screen -- behind the camera, or outside the frame -- and
+// then the history is read where it is, as it was before.
+bool reproject(uint2 pixel, float distance, out int2 source, out float previousDistance) {
+  source = int2(pixel);
+  previousDistance = distance;
+  if (gReproject == 0u || abs(gProj.x) < 1e-8f || abs(gProj.z) < 1e-8f ||
+      abs(gProjPrev.x) < 1e-8f || abs(gProjPrev.z) < 1e-8f || distance <= 0.0f) {
+    return false;
+  }
+  const float2 uv = (float2(pixel) + 0.5f) / float2(gDims);
+  const float2 ndc = float2(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f);
+  const float3 direction =
+      normalize(float3((ndc.x + gProj.y) / gProj.x, (ndc.y + gProj.w) / gProj.z, -1.0f));
+  const float3 here = direction * distance;
+  const float3 there = float3(dot(gDeltaRow0.xyz, here) + gDeltaRow0.w,
+                              dot(gDeltaRow1.xyz, here) + gDeltaRow1.w,
+                              dot(gDeltaRow2.xyz, here) + gDeltaRow2.w);
+  if (there.z > -1e-4f) {
+    return false;
+  }
+  const float2 ndcPrevious = float2((there.x / -there.z) * gProjPrev.x - gProjPrev.y,
+                                    (there.y / -there.z) * gProjPrev.z - gProjPrev.w);
+  const float2 uvPrevious = float2(ndcPrevious.x * 0.5f + 0.5f, 0.5f - ndcPrevious.y * 0.5f);
+  const int2 pixelPrevious = int2(floor(uvPrevious * float2(gDims)));
+  if (any(pixelPrevious < int2(0, 0)) || any(pixelPrevious >= int2(gDims))) {
+    return false;
+  }
+  source = pixelPrevious;
+  previousDistance = length(there);
+  return true;
+}
+
+// A normal turns with the camera as well.
+float3 turn_with_camera(float3 normal) {
+  return float3(dot(gDeltaRow0.xyz, normal), dot(gDeltaRow1.xyz, normal),
+                dot(gDeltaRow2.xyz, normal));
+}
+
+#define DEBUG_OFF 0u
+#define DEBUG_SHADOW 1u
+#define DEBUG_OCCLUSION 2u
+#define DEBUG_HISTORY 11u
+
+float luminance(float3 c) { return dot(c, float3(0.2126f, 0.7152f, 0.0722f)); }
+
+[numthreads(8, 8, 1)]
+void main(uint3 tid : SV_DispatchThreadID) {
+  if (tid.x >= gDims.x || tid.y >= gDims.y) {
+    return;
+  }
+
+  const float4 current = gCurrent[tid.xy];
+  const float4 guide = gGuide[tid.xy];
+  const float luma = luminance(current.rgb);
+
+  // A categorical diagnostic -- material flags, primitive index -- or a pixel
+  // the primary ray missed: there is nothing to accumulate. Passed through as
+  // it is, with the history restarting at that pixel.
+  const bool continuous = gDebugMode == DEBUG_OFF || gDebugMode == DEBUG_SHADOW ||
+                          gDebugMode == DEBUG_OCCLUSION || gDebugMode == DEBUG_HISTORY;
+  if (!continuous || guide.w <= 0.0f) {
+    gOutput[tid.xy] = float4(current.rgb, 0.0f);
+    gHistoryOut[tid.xy] = float4(current.rgb, 1.0f);
+    gMomentsOut[tid.xy] = float4(luma, luma * luma, 0.0f, 0.0f);
+    return;
+  }
+
+  // This frame's neighbourhood at one-pixel spacing. Misses are left out: they
+  // carry no estimate, and counting them would widen the spread with an edge
+  // rather than with noise.
+  float3 sum = float3(0.0f, 0.0f, 0.0f);
+  float3 sumSquares = float3(0.0f, 0.0f, 0.0f);
+  float lumaSum = 0.0f;
+  float lumaSquares = 0.0f;
+  float count = 0.0f;
+  [unroll] for (int dy = -1; dy <= 1; ++dy) {
+    [unroll] for (int dx = -1; dx <= 1; ++dx) {
+      const int2 c = clamp(int2(tid.xy) + int2(dx, dy), int2(0, 0), int2(gDims) - int2(1, 1));
+      if (gGuide[c].w <= 0.0f) {
+        continue;
+      }
+      const float3 s = gCurrent[c].rgb;
+      sum += s;
+      sumSquares += s * s;
+      const float l = luminance(s);
+      lumaSum += l;
+      lumaSquares += l * l;
+      count += 1.0f;
+    }
+  }
+  const float3 mean = sum / count;
+  const float3 sigma = sqrt(max(sumSquares / count - mean * mean, 0.0f));
+  const float lumaMean = lumaSum / count;
+  const float spatialVariance = max(lumaSquares / count - lumaMean * lumaMean, 0.0f);
+
+  // Same surface at the same pixel: the normal and the hit distance both have
+  // to agree. Distance alone lets a silhouette slide over a background at the
+  // same depth; normal alone lets a wall inherit the floor it meets.
+  int2 source;
+  float previousDistance;
+  const bool reprojected = reproject(tid.xy, guide.w, source, previousDistance);
+  const float3 previousNormal = reprojected ? turn_with_camera(guide.xyz) : guide.xyz;
+  const float4 previousGuide = gGuidePrev[source];
+  const bool haveHistory = previousGuide.w > 0.0f;
+  const bool normalAgrees = dot(previousNormal, previousGuide.xyz) > 0.9f;
+  const bool distanceAgrees =
+      abs(previousDistance - previousGuide.w) <= 0.02f * previousDistance;
+  const bool guideAccepts = haveHistory && normalAgrees && distanceAgrees;
+  const bool accepted = gAlpha < 1.0f && guideAccepts;
+
+  const float4 previousMoments = gMomentsIn[source];
+  const float historyLength = accepted ? min(previousMoments.b + 1.0f, 255.0f) : 1.0f;
+  // A true running average until the history is as long as the fixed weight
+  // implies, then the exponential blend. A fresh pixel settles in a few frames
+  // instead of carrying its first noisy estimate for twenty.
+  const float alpha = accepted ? max(gAlpha, 1.0f / historyLength) : 1.0f;
+
+  float3 history = gHistoryIn[source].rgb;
+  if (accepted && gClampSigma > 0.0f) {
+    history = clamp(history, mean - gClampSigma * sigma, mean + gClampSigma * sigma);
+  }
+  const float3 accumulated = lerp(history, current.rgb, alpha);
+
+  const float firstMoment = accepted ? lerp(previousMoments.r, luma, alpha) : luma;
+  const float secondMoment = accepted ? lerp(previousMoments.g, luma * luma, alpha) : luma * luma;
+  // Too short a history to trust a temporal estimate: the spatial one stands in
+  // rather than a variance of zero, which would tell the filter that a fresh,
+  // noisy pixel had already converged.
+  const float variance = historyLength < 4.0f
+                             ? spatialVariance
+                             : max(secondMoment - firstMoment * firstMoment, 0.0f);
+
+  gHistoryOut[tid.xy] = float4(accumulated, 1.0f);
+  gMomentsOut[tid.xy] = float4(firstMoment, secondMoment, historyLength, 0.0f);
+
+  if (gDebugMode == DEBUG_HISTORY) {
+    // Green accepted, red the normal disagreed, blue the distance did, black no
+    // history yet. The guide's own verdict, whether or not anything accumulates.
+    const float3 code = !haveHistory   ? float3(0.0f, 0.0f, 0.0f)
+                        : guideAccepts ? float3(0.0f, 1.0f, 0.0f)
+                        : !normalAgrees ? float3(1.0f, 0.0f, 0.0f)
+                                        : float3(0.0f, 0.0f, 1.0f);
+    gOutput[tid.xy] = float4(code, 0.0f);
+    return;
+  }
+  gOutput[tid.xy] = float4(accumulated, variance);
+}
