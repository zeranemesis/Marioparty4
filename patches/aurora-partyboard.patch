+// What the build and the trace actually read. An upload heap is write-combined
+// system memory reached across PCIe, and the trace shader reads these buffers
+// once per ray hit, not once per frame -- so the copy into device memory pays
+// for itself many times over. See docs/RAYTRACING_AUDIT.md section 3.
+ComPtr<ID3D12Resource> g_vertexGpu;
+ComPtr<ID3D12Resource> g_colourGpu;
+ComPtr<ID3D12Resource> g_normalGpu;
+ComPtr<ID3D12Resource> g_texcoordGpu;
+ComPtr<ID3D12Resource> g_materialGpu;
