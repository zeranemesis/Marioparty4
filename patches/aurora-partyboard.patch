+void shutdown() noexcept {}
+void wait_idle() noexcept {}
+void* shared_texture_handle() noexcept { return nullptr; }
+void* shared_reflection_handle() noexcept { return nullptr; }
+void* shared_fence_handle() noexcept { return nullptr; }
+uint64_t fence_value() noexcept { return 0; }
+uint32_t output_width() noexcept { return 0; }
+uint32_t output_height() noexcept { return 0; }
+#else
