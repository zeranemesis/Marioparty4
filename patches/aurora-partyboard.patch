new file mode 100644
index 0000000..d20154f
--- /dev/null
+++ b/lib/gfx/rt_composite.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <webgpu/webgpu_cpp.h>
+
+#include <cstdint>
+
+// Applies the ray tracing terms inside the EFB render pass, ahead of the 2D
+// layer, rather than over the finished frame at present time.
+//
+// The old composition multiplied the whole EFB, HUD included. That shaded the
+// interface as though it were scenery, so a coverage mask was built from the
+// orthographic draws to hold those pixels back. A mask built from geometry
+// cannot see a texture's alpha, so every protected rectangle was larger than
+// the panel inside it, and the scene behind that margin was left unshaded --
+// hard-edged steps around dialogue boxes and menus.
+//
+// Measured instead: the frame flips between projections two or three times, but
+// no 3D draw ever follows the last 3D -> 2D transition, and only zero to four
+// of the 112 to 148 2D draws precede it. So compositing at that boundary shades
+// the scene and nothing else, with no mask and no rectangles. The command list
+// is replayed later, so the boundary is found by the end of the frame and the
+// draw inserted at the position already recorded for it -- no prediction.
+
+namespace aurora::gfx::rt_composite {
+
+// Builds everything the composition needs and reports whether it is ready.
+// Called while the pass is sealed, on the thread that records commands: every
+// Dawn object this module owns is created here and only read on the render
+// worker. An earlier attempt created them inside the pass instead and took an
+// access violation there.
+bool prepare(uint32_t msaaSamples, bool hasDepth) noexcept;
+
+// Emits the multiply and the reflection blend over the whole target. Runs on
+// the render worker, inside the pass; binds and draws, creates nothing.
+void render(const wgpu::RenderPassEncoder& pass, const wgpu::Extent3D& targetSize) noexcept;
+
+// How many times the composition ran since this was last called. More than one
+// per frame means the term is being applied more than once.
+uint32_t take_draw_count() noexcept;
+
+void shutdown() noexcept;
+
+} // namespace aurora::gfx::rt_composite
