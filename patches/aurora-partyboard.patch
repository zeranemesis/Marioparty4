+// Walks the vertex descriptor in attribute order, accumulating byte offsets.
+// Mirrors calculate_last_vtx_size in command_processor.cpp, which computes the
+// same walk but keeps only the total.
+// texAttr and texMtxAttr are the texture coordinate and the per-vertex texture
+// matrix index the map the trace reads comes through -- not necessarily TEX0 --
+// or -1.
+void compute_layout(GXVtxFmt fmt, int texAttr, int texMtxAttr, AttrLayout& pos,
+                    AttrLayout& pnMtxIdx, AttrLayout& colour, AttrLayout& normal,
+                    AttrLayout& texcoord, AttrLayout& texMtxIdx) noexcept {
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  uint32_t offset = 0;
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
+    const auto desc = g_gxState.vtxDesc[i];
+    if (desc == GX_NONE) {
+      continue;
+    }
+
+    AttrLayout* target = nullptr;
+    if (i == GX_VA_POS) {
+      target = &pos;
+    } else if (i == GX_VA_PNMTXIDX) {
+      target = &pnMtxIdx;
+    } else if (i == GX_VA_CLR0) {
+      target = &colour;
+    } else if (i == GX_VA_NRM) {
+      target = &normal;
+    } else if (i == texAttr) {
+      target = &texcoord;
+    } else if (i == texMtxAttr) {
+      target = &texMtxIdx;
+    }
+    if (target != nullptr) {
+      target->type = desc;
+      target->offset = offset;
+      target->present = true;
+    }
+
+    switch (desc) {
+    case GX_DIRECT: {
+      const auto attr = static_cast<GXAttr>(i);
+      const auto& attrFmt = vtxFmt.attrs[i];
+      offset += gx::comp_type_size(attr, attrFmt.type) * gx::comp_cnt_count(attr, attrFmt.cnt);
+      break;
+    }
+    case GX_INDEX8:
+      offset += (i == GX_VA_NRM && vtxFmt.attrs[i].cnt == GX_NRM_NBT3) ? 3 : 1;
+      break;
+    case GX_INDEX16:
+      offset += (i == GX_VA_NRM && vtxFmt.attrs[i].cnt == GX_NRM_NBT3) ? 6 : 2;
+      break;
+    default:
+      break;
+    }
+  }
+}
+
+// Decodes one position from raw bytes according to its component format.
+bool decode_position(const uint8_t* p, const gx::VtxAttrFmt& fmt, bool le, Vec3& out) noexcept {
+  const uint32_t count = (fmt.cnt == GX_POS_XY) ? 2u : 3u;
+  float v[3] = {0.f, 0.f, 0.f};
+
+  switch (fmt.type) {
+  case GX_F32:
+    for (uint32_t i = 0; i < count; ++i) {
+      v[i] = read_f32(p + i * 4, le);
+    }
+    break;
+  case GX_S16: {
+    const float scale = 1.f / static_cast<float>(1u << fmt.frac);
+    for (uint32_t i = 0; i < count; ++i) {
+      const uint16_t raw = le ? read_u16_le(p + i * 2) : read_u16_be(p + i * 2);
+      v[i] = static_cast<float>(static_cast<int16_t>(raw)) * scale;
+    }
+    break;
+  }
+  case GX_U16: {
+    const float scale = 1.f / static_cast<float>(1u << fmt.frac);
+    for (uint32_t i = 0; i < count; ++i) {
+      const uint16_t raw = le ? read_u16_le(p + i * 2) : read_u16_be(p + i * 2);
+      v[i] = static_cast<float>(raw) * scale;
+    }
+    break;
+  }
+  case GX_S8: {
+    const float scale = 1.f / static_cast<float>(1u << fmt.frac);
+    for (uint32_t i = 0; i < count; ++i) {
+      v[i] = static_cast<float>(static_cast<int8_t>(p[i])) * scale;
+    }
+    break;
+  }
+  case GX_U8: {
+    const float scale = 1.f / static_cast<float>(1u << fmt.frac);
+    for (uint32_t i = 0; i < count; ++i) {
+      v[i] = static_cast<float>(p[i]) * scale;
+    }
+    break;
+  }
+  default:
+    return false; // unsupported component type, draw is skipped
+  }
+
+  out = Vec3{v[0], v[1], v[2]};
+  return true;
+}
+
+// Texture coordinates use the same fixed-point conventions as positions, but
+// GX_TEX_S carries one component and GX_TEX_ST two, where the position decoder
+// only ever reads two or three. Reading one component too many would run past
+// the vertex, so the count comes from the texture enum rather than being
+// borrowed.
+bool decode_texcoord(const uint8_t* p, const gx::VtxAttrFmt& fmt, bool le, float& u,
+                     float& v) noexcept {
+  const uint32_t count = (fmt.cnt == GX_TEX_ST) ? 2u : 1u;
+  float out[2] = {0.f, 0.f};
+  const float scale = 1.f / static_cast<float>(1u << fmt.frac);
+
+  switch (fmt.type) {
+  case GX_F32:
+    for (uint32_t i = 0; i < count; ++i) {
+      out[i] = read_f32(p + i * 4, le);
+    }
+    break;
+  case GX_S16:
+    for (uint32_t i = 0; i < count; ++i) {
+      const uint16_t raw = le ? read_u16_le(p + i * 2) : read_u16_be(p + i * 2);
+      out[i] = static_cast<float>(static_cast<int16_t>(raw)) * scale;
+    }
+    break;
+  case GX_U16:
+    for (uint32_t i = 0; i < count; ++i) {
+      const uint16_t raw = le ? read_u16_le(p + i * 2) : read_u16_be(p + i * 2);
+      out[i] = static_cast<float>(raw) * scale;
+    }
+    break;
+  case GX_S8:
+    for (uint32_t i = 0; i < count; ++i) {
+      out[i] = static_cast<float>(static_cast<int8_t>(p[i])) * scale;
+    }
+    break;
+  case GX_U8:
+    for (uint32_t i = 0; i < count; ++i) {
+      out[i] = static_cast<float>(p[i]) * scale;
+    }
+    break;
+  default:
+    return false;
+  }
+  u = out[0];
+  v = out[1];
+  return true;
+}
+
+// Normals reuse the position decoder's component handling: GX stores them in
+// the same fixed-point types, always three components, and NBT variants put the
+// normal first, so reading three is right in every case.
+bool decode_normal(const uint8_t* p, const gx::VtxAttrFmt& fmt, bool le, Vec3& out) noexcept {
+  gx::VtxAttrFmt asPosition = fmt;
+  asPosition.cnt = GX_POS_XYZ; // three components, whatever the NBT packing says
+  if (!decode_position(p, asPosition, le, out)) {
+    return false;
+  }
+  const float lengthSq = out.x * out.x + out.y * out.y + out.z * out.z;
+  if (lengthSq < 1e-12f) {
+    return false;
+  }
+  const float inv = 1.f / std::sqrt(lengthSq);
+  out = Vec3{out.x * inv, out.y * inv, out.z * inv};
+  return true;
+}
+
+// Vertex colours drive the indirect bounce: a ray that hits geometry brings back
+// what that surface looks like, which is what turns a grey occlusion term into
+// coloured bounced light.
+bool decode_colour(const uint8_t* p, GXCompType type, bool le, Vec3& out) noexcept {
+  const auto u8n = [](uint8_t v) { return static_cast<float>(v) / 255.f; };
+  switch (type) {
+  case GX_RGB565: {
+    const uint16_t v = le ? read_u16_le(p) : read_u16_be(p);
+    out = Vec3{static_cast<float>((v >> 11) & 0x1F) / 31.f,
+               static_cast<float>((v >> 5) & 0x3F) / 63.f,
+               static_cast<float>(v & 0x1F) / 31.f};
+    return true;
+  }
+  case GX_RGB8:
+  case GX_RGBX8:
+  case GX_RGBA8:
+    out = Vec3{u8n(p[0]), u8n(p[1]), u8n(p[2])};
+    return true;
+  case GX_RGBA4: {
+    const uint16_t v = le ? read_u16_le(p) : read_u16_be(p);
+    out = Vec3{static_cast<float>((v >> 12) & 0xF) / 15.f,
+               static_cast<float>((v >> 8) & 0xF) / 15.f,
+               static_cast<float>((v >> 4) & 0xF) / 15.f};
+    return true;
+  }
+  case GX_RGBA6: {
+    const uint32_t v = (static_cast<uint32_t>(p[0]) << 16) |
+                       (static_cast<uint32_t>(p[1]) << 8) | p[2];
+    out = Vec3{static_cast<float>((v >> 18) & 0x3F) / 63.f,
+               static_cast<float>((v >> 12) & 0x3F) / 63.f,
+               static_cast<float>((v >> 6) & 0x3F) / 63.f};
+    return true;
+  }
+  default:
+    return false;
+  }
+}
+
+// Row-vector times 3x4 matrix, matching the generated shader:
+//   mv_pos = vec4f(in_pos, 1.0) * postex_mtx[pnmtxidx]
+Vec3 transform(const Vec3& p, const gx::PnMtx& mtx) noexcept {
+  // Vec4 exposes its components as accessors, not fields.
+  const auto& m = mtx.pos;
+  return Vec3{
+      m.m0.x() * p.x + m.m0.y() * p.y + m.m0.z() * p.z + m.m0.w(),
+      m.m1.x() * p.x + m.m1.y() * p.y + m.m1.z() * p.z + m.m1.w(),
+      m.m2.x() * p.x + m.m2.y() * p.y + m.m2.z() * p.z + m.m2.w(),
+  };
+}
+
+// Inverse of an affine 3x4, row-major. Returns false when the linear part is
+// singular, which happens for a matrix the game has not set this frame.
+bool invert_affine(const float m[12], float out[12]) noexcept {
+  const float a = m[0], b = m[1], c = m[2];
+  const float d = m[4], e = m[5], f = m[6];
+  const float g = m[8], h = m[9], i = m[10];
+  const float det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
+  if (det > -1e-9f && det < 1e-9f) {
+    return false;
+  }
+  const float inv = 1.f / det;
+  const float r[9] = {
+      (e * i - f * h) * inv, (c * h - b * i) * inv, (b * f - c * e) * inv,
+      (f * g - d * i) * inv, (a * i - c * g) * inv, (c * d - a * f) * inv,
+      (d * h - e * g) * inv, (b * g - a * h) * inv, (a * e - b * d) * inv,
+  };
+  const float tx = m[3], ty = m[7], tz = m[11];
+  out[0] = r[0]; out[1] = r[1]; out[2] = r[2];
+  out[3] = -(r[0] * tx + r[1] * ty + r[2] * tz);
+  out[4] = r[3]; out[5] = r[4]; out[6] = r[5];
+  out[7] = -(r[3] * tx + r[4] * ty + r[5] * tz);
+  out[8] = r[6]; out[9] = r[7]; out[10] = r[8];
+  out[11] = -(r[6] * tx + r[7] * ty + r[8] * tz);
+  return true;
+}
+
+// A TLAS instance with a singular transform is undefined behaviour, and the
+// game leaves position matrix slots zeroed until it fills them -- which happens
+// on every scene change. Baking such a draw instead costs nothing and keeps the
+// structure valid.
+bool affine_is_usable(const float m[12]) noexcept {
+  for (uint32_t i = 0; i < 12; ++i) {
+    if (!std::isfinite(m[i])) {
+      return false;
+    }
+  }
+  const float det = m[0] * (m[5] * m[10] - m[6] * m[9]) -
+                    m[1] * (m[4] * m[10] - m[6] * m[8]) +
+                    m[2] * (m[4] * m[9] - m[5] * m[8]);
+  return det > 1e-9f || det < -1e-9f;
+}
+
+// out = a applied after b, both row-major 3x4 affines.
+void compose_affine(const float a[12], const float b[12], float out[12]) noexcept {
+  for (uint32_t row = 0; row < 3; ++row) {
+    for (uint32_t col = 0; col < 3; ++col) {
+      out[row * 4 + col] = a[row * 4 + 0] * b[0 * 4 + col] + a[row * 4 + 1] * b[1 * 4 + col] +
+                           a[row * 4 + 2] * b[2 * 4 + col];
+    }
+    out[row * 4 + 3] = a[row * 4 + 0] * b[3] + a[row * 4 + 1] * b[7] +
+                       a[row * 4 + 2] * b[11] + a[row * 4 + 3];
+  }
+}
+
+Vec3 apply_affine(const float m[12], const Vec3& p) noexcept {
+  return Vec3{
+      m[0] * p.x + m[1] * p.y + m[2] * p.z + m[3],
+      m[4] * p.x + m[5] * p.y + m[6] * p.z + m[7],
+      m[8] * p.x + m[9] * p.y + m[10] * p.z + m[11],
+  };
+}
+
+void flatten(const gx::PnMtx& mtx, float out[12]) noexcept {
+  const auto& m = mtx.pos;
+  out[0] = m.m0.x(); out[1] = m.m0.y(); out[2] = m.m0.z(); out[3] = m.m0.w();
+  out[4] = m.m1.x(); out[5] = m.m1.y(); out[6] = m.m1.z(); out[7] = m.m1.w();
+  out[8] = m.m2.x(); out[9] = m.m2.y(); out[10] = m.m2.z(); out[11] = m.m2.w();
+}
+
+Vec3 rotate_normal(const Vec3& n, const gx::PnMtx& mtx) noexcept {
+  const auto& m = mtx.nrm;
+  return Vec3{
+      m.m0.x() * n.x + m.m0.y() * n.y + m.m0.z() * n.z,
+      m.m1.x() * n.x + m.m1.y() * n.y + m.m1.z() * n.z,
+      m.m2.x() * n.x + m.m2.y() * n.y + m.m2.z() * n.z,
+  };
+}
+
+// A map the active stages name, and the stage that names it for the purpose.
+struct MapChoice {
+  const gfx::TextureBind* map = nullptr;
+  uint8_t stage = 0;
+};
+
+// Whether a stage's alpha combiner reads its texture's alpha. The game's toon,
+// highlight, reflection and shadow stages (hsfdraw.c) sample a map but carry the
+// alpha of the stage before: their maps say nothing about holes.
+bool reads_texture_alpha(const gx::TevStage& stage) noexcept {
+  const auto& p = stage.alphaPass;
+  return p.a == GX_CA_TEXA || p.b == GX_CA_TEXA || p.c == GX_CA_TEXA || p.d == GX_CA_TEXA;
+}
+
+// Whether a stage's colour combiner reads its texture, as a colour or a factor.
+bool reads_texture_colour(const gx::TevStage& stage) noexcept {
+  const auto& p = stage.colorPass;
+  const auto texture = [](GXTevColorArg arg) { return arg == GX_CC_TEXC || arg == GX_CC_TEXA; };
+  return texture(p.a) || texture(p.b) || texture(p.c) || texture(p.d);
+}
+
+// The two ways a map lets the scene through, measured once when it was loaded.
+bool is_holed(const gfx::TextureBind& texture) noexcept {
+  return texture.ref->cutoutFraction > 0.05f;
+}
+bool is_hazy(const gfx::TextureBind& texture) noexcept {
+  return texture.ref->averageAlpha < 0.95f;
+}
+
+// Where the coordinate of the map the trace reads comes from, resolved once per
+// draw.
+struct Texgen {
+  enum class Source : uint8_t { None, Texcoord, Position, Normal };
+  Source source = Source::None;
+  int attr = -1;    // GX_VA_TEXn, for a texture coordinate source
+  int mtxAttr = -1; // GX_VA_TEXnMTXIDX, used when the vertex carries it
+  // The generator the source runs through; null reads the source raw.
+  const gx::TcgConfig* tcg = nullptr;
+};
+
+// The generator behind a TEV stage, as the vertex shader builds it
+// (gx/shader.cpp). What this does not reproduce -- a colour source, a tangent,
+// an emboss offset, a stage without a coordinate -- resolves to None, and the
+// draw is traced without a thumbnail rather than read at a coordinate that
+// means nothing.
+Texgen resolve_texgen(const gx::TevStage& stage) noexcept {
+  Texgen out;
+  if (stage.texCoordId == GX_TEXCOORD_NULL) {
+    return out;
+  }
+  const auto coord = static_cast<uint32_t>(stage.texCoordId);
+  if (coord >= g_gxState.numTexGens || coord >= g_gxState.tcgs.size()) {
+    return out;
+  }
+  const auto& tcg = g_gxState.tcgs[coord];
+  if (tcg.type != GX_TG_MTX2x4 && tcg.type != GX_TG_MTX3x4) {
+    return out;
+  }
+  if (tcg.src >= GX_TG_TEX0 && tcg.src <= GX_TG_TEX7) {
+    out.source = Texgen::Source::Texcoord;
+    out.attr = GX_VA_TEX0 + static_cast<int>(tcg.src - GX_TG_TEX0);
+  } else if (tcg.src == GX_TG_POS) {
+    out.source = Texgen::Source::Position;
+  } else if (tcg.src == GX_TG_NRM) {
+    out.source = Texgen::Source::Normal;
+  } else {
+    return out;
+  }
+  out.mtxAttr = GX_VA_TEX0MTXIDX + static_cast<int>(coord);
+  out.tcg = &tcg;
+  return out;
+}
+
+// A generator's matrix by the index the vertex shader uses: postex_mtx holds the
+// position matrices, then the texture matrices, and a GX matrix id over three
+// addresses it. Null past both.
+const Mat3x4<float>* texgen_matrix(uint32_t index) noexcept {
+  if (index < g_gxState.pnMtx.size()) {
+    return &g_gxState.pnMtx[index].pos;
+  }
+  if (index - g_gxState.pnMtx.size() < g_gxState.texMtxs.size()) {
+    return &g_gxState.texMtxs[index - g_gxState.pnMtx.size()];
+  }
+  return nullptr;
+}
+
+Vec3 apply_rows(const Mat3x4<float>& m, const Vec3& p) noexcept {
+  return Vec3{
+      m.m0.x() * p.x + m.m0.y() * p.y + m.m0.z() * p.z + m.m0.w(),
+      m.m1.x() * p.x + m.m1.y() * p.y + m.m1.z() * p.z + m.m1.w(),
+      m.m2.x() * p.x + m.m2.y() * p.y + m.m2.z() * p.z + m.m2.w(),
+  };
+}
+
+// Runs one source value through a generator the way the vertex shader does:
+// the texture matrix -- the vertex's own when it carries an index, passed as
+// vertexMtx, else UINT32_MAX -- then the post-transform matrix, then for a
+// projective generator the divide. Every source this is used for enters with
+// w = 1: a texture coordinate as (s, t, 1, 1), a position or a normal as itself.
+//
+// The divide is per vertex: exact for the affine generators sprites use, only
+// approximate across a triangle for a projective one -- and those project
+// lights and shadows onto surfaces rather than cutting holes in them.
+bool generate_texcoord(const gx::TcgConfig& tcg, uint32_t vertexMtx, Vec3 tc, float& u,
+                       float& v) noexcept {
+  const bool wantsMatrix = vertexMtx != UINT32_MAX || tcg.mtx != GX_IDENTITY;
+  if (wantsMatrix) {
+    const Mat3x4<float>* m = texgen_matrix(
+        vertexMtx != UINT32_MAX ? vertexMtx / 3u : static_cast<uint32_t>(tcg.mtx) / 3u);
+    if (m == nullptr) {
+      return false;
+    }
+    tc = apply_rows(*m, tc);
+  }
+  if (tcg.type == GX_TG_MTX2x4) {
+    tc.z = 1.f;
+  }
+  if (tcg.normalize) {
+    const float length = std::sqrt(tc.x * tc.x + tc.y * tc.y + tc.z * tc.z);
+    if (!(length > 0.f)) {
+      return false;
+    }
+    tc = Vec3{tc.x / length, tc.y / length, tc.z / length};
+  }
+  if (tcg.postMtx != GX_PTIDENTITY) {
+    const uint32_t index =
+        (static_cast<uint32_t>(tcg.postMtx) - static_cast<uint32_t>(GX_PTTEXMTX0)) / 3u;
+    if (index >= g_gxState.ptTexMtxs.size()) {
+      return false;
+    }
+    tc = apply_rows(g_gxState.ptTexMtxs[index], tc);
+  }
+  if (tcg.type == GX_TG_MTX3x4) {
+    if (!(std::abs(tc.z) > 1e-6f)) {
+      return false;
+    }
+    u = tc.x / tc.z;
+    v = tc.y / tc.z;
+  } else {
+    u = tc.x;
+    v = tc.y;
+  }
+  return std::isfinite(u) && std::isfinite(v);
+}
+
+// Marks the tiles an orthographic draw covers. GX stores an orthographic
+// projection as clip.x = m0[0]*x + m0[3], clip.y = m1[1]*y + m1[3] with w = 1
+// (see command_processor.cpp), so the view-space vertices map to the screen
+// without a divide. A bounding box per draw is exact for the quads the HUD is
+// made of, and conservative for anything else, which is the right way round:
+// covering a little too much only costs some occlusion at the edge of a panel.
+void mark_ortho_coverage(const std::vector<Vec3>& viewPositions,
+                         const Mat4x4<float>& proj) noexcept {
+  if (viewPositions.empty() || proj.m0[0] == 0.f || proj.m1[1] == 0.f) {
+    return;
+  }
+  float minU = 1.f, maxU = 0.f, minV = 1.f, maxV = 0.f;
+  for (const Vec3& v : viewPositions) {
+    const float u = (proj.m0[0] * v.x + proj.m0[3] + 1.f) * 0.5f;
+    const float t = (1.f - (proj.m1[1] * v.y + proj.m1[3])) * 0.5f;
+    if (!(u > -1e6f && u < 1e6f && t > -1e6f && t < 1e6f)) {
+      return; // a degenerate projection would smear the box over everything
+    }
+    minU = u < minU ? u : minU;
+    maxU = u > maxU ? u : maxU;
+    minV = t < minV ? t : minV;
+    maxV = t > maxV ? t : maxV;
+  }
+  if (maxU <= 0.f || minU >= 1.f || maxV <= 0.f || minV >= 1.f) {
+    return; // entirely off screen
+  }
+  const auto clampTile = [](float f, uint32_t count) {
+    const int i = static_cast<int>(f * static_cast<float>(count));
+    return static_cast<uint32_t>(i < 0 ? 0 : (i >= static_cast<int>(count)
+                                                  ? static_cast<int>(count) - 1
+                                                  : i));
+  };
+  // A draw covering the whole screen is not an interface element to protect --
+  // it is the 2D layer's backdrop or a fade, whose geometry says nothing about
+  // where anything is actually drawn. Masking it switches the effect off
+  // entirely, which is what a first attempt did: coverage went straight to 100%.
+  // Measured on a mini-game screen, a frame has one of these and 45 bounded
+  // draws averaging 2.5% of the screen, so excluding it costs almost nothing and
+  // is the difference between a working mask and no effect at all.
+  const float area = (maxU - minU) * (maxV - minV);
+  if (area > 0.9f) {
+    ++g_orthoFullscreen;
+    return;
+  }
+  ++g_orthoBounded;
+  g_orthoBoundedArea += area;
+  const uint32_t x0 = clampTile(minU, kMaskCols);
+  const uint32_t x1 = clampTile(maxU, kMaskCols);
+  const uint32_t y0 = clampTile(minV, kMaskRows);
+  const uint32_t y1 = clampTile(maxV, kMaskRows);
+  for (uint32_t y = y0; y <= y1; ++y) {
+    uint32_t* row = g_orthoMask.data() + static_cast<size_t>(y) * kMaskCols;
+    for (uint32_t x = x0; x <= x1; ++x) {
+      row[x] = 1u;
+    }
+  }
+}
