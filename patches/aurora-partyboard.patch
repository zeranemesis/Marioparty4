+void uav_barrier(ID3D12Resource* resource) noexcept {
+  D3D12_RESOURCE_BARRIER barrier{};
+  barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+  barrier.UAV.pResource = resource;
+  g_cmdList->ResourceBarrier(1, &barrier);
+}
