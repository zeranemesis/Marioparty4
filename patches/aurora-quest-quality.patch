+// The sRGB byte for a linear value: the encoding every mip texel goes through.
+inline uint8_t encode_srgb(float v) {
+  const float encoded = v <= 0.0031308f ? v * 12.92f : 1.055f * std::pow(v, 1.0f / 2.4f) - 0.055f;
+  return uint8_t(std::clamp(std::lround(encoded * 255), 0l, 255l));
