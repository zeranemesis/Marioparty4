+// The sRGB byte for a linear value: the encoding every mip texel goes through.
+inline uint8_t encode_srgb(float v) {
+  const float encoded = v <= 0.0031308f ? v * 12.92f : 1.055f * std::pow(v, 1.0f / 2.4f) - 0.055f;
+  return uint8_t(std::clamp(std::lround(encoded * 255), 0l, 255l));
+}
+
+struct SrgbTables {
+  static constexpr unsigned kBucketShift = 15; // [0, 2) in 32768 buckets of float bit patterns
+  static constexpr uint32_t kTwo = 0x40000000u;
+  float linear[256];
+  // threshold[k], 1 <= k <= 255: the bits of the smallest float encode_srgb
+  // takes to k or above; threshold[256] ends the search.
+  uint32_t threshold[257];
+  // The byte at the start of each bucket: at most a step or two below the answer.
+  uint8_t bucket[kTwo >> kBucketShift];
+};
+
+// Built once with this platform's own pow, so a lookup gives exactly the
+// byte encode_srgb would: mip generation runs on the game thread, for every
+// world texture loaded or updated, and pow per texel was most of its cost.
+inline const SrgbTables& srgb_tables() {
+  static const SrgbTables tables = [] {
+    SrgbTables t;
+    for (unsigned i = 0; i < 256; ++i) {
+      const float c = i / 255.0f;
+      t.linear[i] = c <= 0.04045f ? c / 12.92f : std::pow((c + 0.055f) / 1.055f, 2.4f);
+    }
+    // Non-negative floats sort like their bit patterns: bisect those.
+    const auto as_float = [](uint32_t bits) { float f; std::memcpy(&f, &bits, sizeof f); return f; };
+    t.threshold[0] = 0;
+    for (unsigned k = 1; k < 256; ++k) {
+      uint32_t lo = 0, hi = SrgbTables::kTwo; // 0 encodes to 0, 2 to 255
+      while (hi - lo > 1) {
+        const uint32_t mid = lo + (hi - lo) / 2;
+        (encode_srgb(as_float(mid)) >= k ? hi : lo) = mid;
+      }
+      t.threshold[k] = hi;
+    }
+    t.threshold[256] = UINT32_MAX;
+    unsigned k = 0;
+    for (uint32_t i = 0; i < std::size(t.bucket); ++i) {
+      while (t.threshold[k + 1] <= i << SrgbTables::kBucketShift) ++k;
+      t.bucket[i] = uint8_t(k);
+    }
+    return t;
+  }();
+  return tables;
+}
