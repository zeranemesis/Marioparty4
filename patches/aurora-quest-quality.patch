+namespace aurora::gfx::astc {
+namespace {
+Module Log("aurora::gfx::astc");
+
+constexpr uint32_t kMagic = 0x34545341; // "AST4"
+constexpr size_t kMaxQueued = 256;
+
+uint32_t level_size(uint32_t size, uint32_t level) { return std::max(size >> level, 1u); }
+
+size_t rgba_level_bytes(uint32_t width, uint32_t height, uint32_t level) {
+  return size_t(level_size(width, level)) * level_size(height, level) * 4;
+}
+
+size_t astc_level_bytes(uint32_t width, uint32_t height, uint32_t level) {
+  return size_t((level_size(width, level) + 3) / 4) * ((level_size(height, level) + 3) / 4) * 16;
+}
+
+size_t astc_chain_bytes(uint32_t width, uint32_t height, uint32_t levels) {
+  size_t total = 0;
+  for (uint32_t level = 0; level < levels; ++level) total += astc_level_bytes(width, height, level);
+  return total;
+}
+
+uint64_t chain_hash(const uint8_t* rgba, size_t bytes, uint32_t width, uint32_t height, uint32_t levels) {
+  const uint64_t seed = (uint64_t(width) << 40) ^ (uint64_t(height) << 16) ^ levels;
+  return XXH3_64bits_withSeed(rgba, bytes, seed);
+}
+
+std::filesystem::path cache_file(uint64_t hash) {
+  return std::filesystem::path{g_config.cachePath} / "astc4x4" / fmt::format("{:016x}.astc", hash);
+}
+
+struct Job {
+  std::weak_ptr<TextureRef> ref;
+  std::vector<uint8_t> rgba;
+  uint32_t width = 0, height = 0, levels = 0;
+  uint64_t hash = 0;
+};
+struct Done {
+  std::weak_ptr<TextureRef> ref;
+  std::vector<uint8_t> blocks;
+  uint32_t levels = 0;
+};
+
+// Never destroyed: the process may exit while it encodes.
+struct Worker {
+  std::mutex mutex;
+  std::condition_variable wake;
+  std::deque<Job> jobs;
+  std::deque<Done> done;
+  bool started = false;
+};
+Worker& worker() {
+  static auto* instance = new Worker;
+  return *instance;
+}
+
+#if AURORA_ASTC_ENCODE
+// One chain, level by level, on this thread (ARM's encoder at its medium
+// preset: 4x4 blocks at that effort look the same as the RGBA8 they replace).
+bool encode_chain(astcenc_context* context, const Job& job, std::vector<uint8_t>& out) {
+  out.assign(astc_chain_bytes(job.width, job.height, job.levels), 0);
+  size_t in = 0, offset = 0;
+  const astcenc_swizzle swizzle{ASTCENC_SWZ_R, ASTCENC_SWZ_G, ASTCENC_SWZ_B, ASTCENC_SWZ_A};
+  for (uint32_t level = 0; level < job.levels; ++level) {
+    void* slices[1] = {const_cast<uint8_t*>(job.rgba.data() + in)};
+    astcenc_image image{
+        .dim_x = level_size(job.width, level),
+        .dim_y = level_size(job.height, level),
+        .dim_z = 1,
+        .data_type = ASTCENC_TYPE_U8,
+        .data = slices,
+    };
+    const size_t bytes = astc_level_bytes(job.width, job.height, level);
+    if (astcenc_compress_image(context, &image, &swizzle, out.data() + offset, bytes, 0) != ASTCENC_SUCCESS) {
