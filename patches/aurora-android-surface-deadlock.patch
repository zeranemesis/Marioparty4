   {
+#if defined(SDL_PLATFORM_ANDROID)
+    // SurfaceLock is SDL's Android activity mutex, and the render worker takes
+    // it too (end_frame's present). Dropping or recreating the surface below
+    // first waits for that worker, so waiting while holding the lock deadlocks
+    // the game, the worker and the UI thread (surfaceDestroyed) as soon as the
+    // app goes to the background. Drain the worker first, unlocked: this
+    // thread is its only producer, so it has nothing left to lock for.
+    bool presentable;
+    {
+      window::SurfaceLock probe;
+      presentable = window::is_presentable() && g_surface;
+    }
+    if (!presentable) {
+      gfx::gpu_synchronize();
+    }
+#endif
     window::SurfaceLock surfaceLock;
     if (!window::is_presentable()) {
       webgpu::release_surface();
