+// Dawn destroys an unconfigured swapchain only once the GPU has finished the
+// submission that follows it. In the background nothing is submitted, so on
+// resume the old swapchain was still alive and connected to the Android
+// window. The new surface for that window then failed with
+// VK_ERROR_NATIVE_WINDOW_IN_USE_KHR, a lost device: at every resume after a
+// pause on the Quest 3, whose flat screen is one window kept for the whole
+// session (2026-09-27 and 28). Submit an empty command buffer, wait for it and
+// tick the device, so the released swapchain is gone before a new surface.
+static void flush_released_surfaces() {
+  if (!g_device || !g_queue) {
+    return;
+  }
+  const wgpu::CommandEncoderDescriptor encoderDescriptor{.label = "Surface release flush"};
+  auto encoder = g_device.CreateCommandEncoder(&encoderDescriptor);
+  const auto commands = encoder.Finish();
+  g_queue.Submit(1, &commands);
+  const auto future = g_queue.OnSubmittedWorkDone(wgpu::CallbackMode::WaitAnyOnly,
+                                                  [](wgpu::QueueWorkDoneStatus, wgpu::StringView) {});
+  g_instance.WaitAny(future, UINT64_MAX);
+  g_device.Tick();
+}
