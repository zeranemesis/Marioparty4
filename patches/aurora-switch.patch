+#if defined(__SWITCH__)
+// Dawn cannot load libEGL on libnx: it is handed switch-mesa's display and
+// loader instead (RequestAdapterOptionsGetGLProc).
+static EGLDisplay switch_egl_display() {
+  static const EGLDisplay display = [] {
+    EGLDisplay d = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (d != EGL_NO_DISPLAY && eglInitialize(d, nullptr, nullptr) == EGL_FALSE) {
+      Log.error("eglInitialize failed: {:#x}", eglGetError());
+      d = EGL_NO_DISPLAY;
+    }
+    return d;
+  }();
+  return display;
+}
+#endif
+
 static bool create_surface() {
+#if defined(__SWITCH__)
+  // The console has one window, libnx's default NWindow, and WebGPU no
+  // surface source for it: Dawn's OpenGL ES backend presents to it through
+  // EGL (cmake/PatchDawnForSwitch.cmake adds this entry point).
+  release_surface();
+  flush_released_surfaces();
+  g_surface = wgpu::Surface::Acquire(
+      dawn::native::opengl::CreateSurfaceFromEGLNativeWindow(g_instance.Get(), nwindowGetDefault()));
+  if (!g_surface) {
+    Log.error("Failed to create surface");
+    return false;
+  }
+  g_surfaceGeneration = window::surface_generation();
+  Log.info("Created surface generation {}", g_surfaceGeneration);
+  return true;
+#else
   SDL_Window* window = window::get_sdl_window();
   if (window == nullptr) {
     Log.error("Failed to create surface: no window");
@@ -719,6 +758,7 @@ static bool create_surface() {
