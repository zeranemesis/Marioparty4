+  // What the resolved handle actually depends on besides the texture object itself.
+  // A palettised texture decodes to different pixels depending on the TLUT loaded in
+  // its slot, and a palettised EFB copy also depends on the revision of the copy it
+  // reads from; neither of those touches the texture object, so both have to be part
+  // of the "bind unchanged" test in resolve_sampled_textures.
+  u32 tlutObjId = 0;
+  u32 tlutDataVersion = 0;
+  u32 copyRevision = 0;
 
   TextureBind() noexcept = default;
   TextureBind(const GXTexObj_& obj, TextureHandle handle) noexcept : ref(std::move(handle)), texObj(obj) {}
+  TextureBind(const GXTexObj_& obj, TextureHandle handle, u32 tlutObjId_, u32 tlutDataVersion_,
+              u32 copyRevision_) noexcept
+  : ref(std::move(handle))
+  , texObj(obj)
+  , tlutObjId(tlutObjId_)
+  , tlutDataVersion(tlutDataVersion_)
+  , copyRevision(copyRevision_) {}
   void reset() noexcept { ref.reset(); }
   [[nodiscard]] wgpu::SamplerDescriptor get_descriptor() const noexcept;
   operator bool() const noexcept { return ref.operator bool(); }
