diff --git a/src/video/switch/SDL_switchvideo.c b/src/video/switch/SDL_switchvideo.c
new file mode 100644
index 0000000..2109b85
--- /dev/null
+++ b/src/video/switch/SDL_switchvideo.c
@@ -0,0 +1,321 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_SWITCH
+
+#include "../SDL_sysvideo.h"
+#include "../../events/SDL_events_c.h"
+#include "SDL_switchvideo.h"
+
+#include <switch.h>
+
+#define SWITCHVID_DRIVER_NAME "switch"
+
+// The Nintendo Switch composes a single fullscreen surface. Handheld is
+// 1280x720; docked can present at up to 1920x1080. We advertise 1280x720 as
+// the desktop mode and let the SDL renderer scale logical content to it.
+#define SWITCH_SCREEN_W 1280
+#define SWITCH_SCREEN_H 720
+
+// ---------------------------------------------------------------------------
+// EGL / OpenGL ES backed by libnx's default NWindow and switch-mesa.
+// ---------------------------------------------------------------------------
+
+static bool SWITCH_GL_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    // EGL/GLESv2 are statically linked from the portlibs; nothing to dlopen.
+    (void)path;
+    return true;
+}
+
+static SDL_FunctionPointer SWITCH_GL_GetProcAddress(SDL_VideoDevice *_this, const char *proc)
+{
+    (void)_this;
+    return (SDL_FunctionPointer)eglGetProcAddress(proc);
+}
+
+static void SWITCH_GL_UnloadLibrary(SDL_VideoDevice *_this)
+{
+    SDL_VideoData *v = _this->internal;
+    if (v && v->display != EGL_NO_DISPLAY) {
+        eglTerminate(v->display);
+        v->display = EGL_NO_DISPLAY;
+    }
+}
+
+static SDL_GLContext SWITCH_GL_CreateContext(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_VideoData *v = _this->internal;
+    EGLint num_configs = 0;
+
+    static const EGLint config_attrs[] = {
+        EGL_RED_SIZE, 8,
+        EGL_GREEN_SIZE, 8,
+        EGL_BLUE_SIZE, 8,
+        EGL_ALPHA_SIZE, 8,
+        EGL_DEPTH_SIZE, 24,
+        EGL_STENCIL_SIZE, 8,
+        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_NONE
+    };
+    static const EGLint context_attrs[] = {
+        EGL_CONTEXT_CLIENT_VERSION, 2,
+        EGL_NONE
+    };
+
+    v->display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (v->display == EGL_NO_DISPLAY) {
+        SDL_SetError("eglGetDisplay() failed: %d", eglGetError());
+        return NULL;
+    }
+    if (!eglInitialize(v->display, NULL, NULL)) {
+        SDL_SetError("eglInitialize() failed: %d", eglGetError());
+        return NULL;
+    }
+    if (!eglBindAPI(EGL_OPENGL_ES_API)) {
+        SDL_SetError("eglBindAPI() failed: %d", eglGetError());
+        goto error;
+    }
+    if (!eglChooseConfig(v->display, config_attrs, &v->config, 1, &num_configs) || num_configs < 1) {
+        SDL_SetError("eglChooseConfig() found no usable config: %d", eglGetError());
+        goto error;
+    }
+
+    v->surface = eglCreateWindowSurface(v->display, v->config,
+                                        (EGLNativeWindowType)nwindowGetDefault(), NULL);
+    if (v->surface == EGL_NO_SURFACE) {
+        SDL_SetError("eglCreateWindowSurface() failed: %d", eglGetError());
+        goto error;
+    }
+
+    v->context = eglCreateContext(v->display, v->config, EGL_NO_CONTEXT, context_attrs);
+    if (v->context == EGL_NO_CONTEXT) {
+        SDL_SetError("eglCreateContext() failed: %d", eglGetError());
+        goto error;
+    }
+
+    if (!eglMakeCurrent(v->display, v->surface, v->surface, v->context)) {
+        SDL_SetError("eglMakeCurrent() failed: %d", eglGetError());
+        goto error;
+    }
+
+    eglSwapInterval(v->display, 1);
+    v->swap_interval = 1;
+    v->egl_initialized = true;
+
+    if (window->internal) {
+        ((SDL_WindowData *)window->internal)->uses_gl = true;
+    }
+
+    return (SDL_GLContext)v->context;
+
+error:
+    if (v->surface != EGL_NO_SURFACE) {
+        eglDestroySurface(v->display, v->surface);
+        v->surface = EGL_NO_SURFACE;
+    }
+    eglTerminate(v->display);
+    v->display = EGL_NO_DISPLAY;
+    return NULL;
+}
+
+static bool SWITCH_GL_MakeCurrent(SDL_VideoDevice *_this, SDL_Window *window, SDL_GLContext context)
+{
+    SDL_VideoData *v = _this->internal;
+    (void)window;
+    (void)context;
+    if (!v->egl_initialized) {
+        return SDL_SetError("No EGL context to make current");
+    }
+    if (!eglMakeCurrent(v->display, v->surface, v->surface, v->context)) {
+        return SDL_SetError("eglMakeCurrent() failed: %d", eglGetError());
+    }
+    return true;
+}
+
+static bool SWITCH_GL_SetSwapInterval(SDL_VideoDevice *_this, int interval)
+{
+    SDL_VideoData *v = _this->internal;
+    if (!eglSwapInterval(v->display, interval)) {
+        return SDL_SetError("eglSwapInterval() failed: %d", eglGetError());
+    }
+    v->swap_interval = interval;
+    return true;
+}
+
+static bool SWITCH_GL_GetSwapInterval(SDL_VideoDevice *_this, int *interval)
+{
+    *interval = _this->internal->swap_interval;
+    return true;
+}
+
+static bool SWITCH_GL_SwapWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_VideoData *v = _this->internal;
+    (void)window;
+    if (!eglSwapBuffers(v->display, v->surface)) {
+        return SDL_SetError("eglSwapBuffers() failed: %d", eglGetError());
+    }
+    return true;
+}
+
+static bool SWITCH_GL_DestroyContext(SDL_VideoDevice *_this, SDL_GLContext context)
+{
+    SDL_VideoData *v = _this->internal;
+    (void)context;
+    if (v->display != EGL_NO_DISPLAY) {
+        eglMakeCurrent(v->display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        if (v->context != EGL_NO_CONTEXT) {
+            eglDestroyContext(v->display, v->context);
+            v->context = EGL_NO_CONTEXT;
+        }
+        if (v->surface != EGL_NO_SURFACE) {
+            eglDestroySurface(v->display, v->surface);
+            v->surface = EGL_NO_SURFACE;
+        }
+    }
+    v->egl_initialized = false;
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// Display / window management
+// ---------------------------------------------------------------------------
+
+static bool SWITCH_VideoInit(SDL_VideoDevice *_this)
+{
+    SDL_DisplayMode mode;
+
+    SDL_zero(mode);
+    mode.w = SWITCH_SCREEN_W;
+    mode.h = SWITCH_SCREEN_H;
+    mode.refresh_rate = 60.0f;
+    mode.format = SDL_PIXELFORMAT_RGBA8888;
+
+    if (SDL_AddBasicVideoDisplay(&mode) == 0) {
+        return false;
+    }
+    return true;
+}
+
+static void SWITCH_VideoQuit(SDL_VideoDevice *_this)
+{
+    (void)_this;
+}
+
+static bool SWITCH_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props)
+{
+    SDL_WindowData *data;
+    (void)create_props;
+
+    data = (SDL_WindowData *)SDL_calloc(1, sizeof(SDL_WindowData));
+    if (!data) {
+        return false;
+    }
+    window->internal = data;
+
+    // Single fullscreen surface only.
+    window->w = SWITCH_SCREEN_W;
+    window->h = SWITCH_SCREEN_H;
+    SDL_SetWindowFocusable(window, true);
+    SDL_SetKeyboardFocus(window);
+    SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, SWITCH_SCREEN_W, SWITCH_SCREEN_H);
+    return true;
+}
+
+static void SWITCH_DestroyWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    if (window && window->internal) {
+        SDL_free(window->internal);
+        window->internal = NULL;
+    }
+}
+
+static void SWITCH_PumpEvents(SDL_VideoDevice *_this)
+{
+    (void)_this;
+    // Allow the system to request exit (HOME menu / applet messages).
+    if (!appletMainLoop()) {
+        SDL_SendQuit();
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Bootstrap
+// ---------------------------------------------------------------------------
+
+static void SWITCH_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device->internal);
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *SWITCH_CreateDevice(void)
+{
+    SDL_VideoDevice *device;
+    SDL_VideoData *data;
+
+    device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        return NULL;
+    }
+
+    data = (SDL_VideoData *)SDL_calloc(1, sizeof(SDL_VideoData));
+    if (!data) {
+        SDL_free(device);
+        return NULL;
+    }
+    data->display = EGL_NO_DISPLAY;
+    data->context = EGL_NO_CONTEXT;
+    data->surface = EGL_NO_SURFACE;
+    device->internal = data;
+
+    device->VideoInit = SWITCH_VideoInit;
+    device->VideoQuit = SWITCH_VideoQuit;
+    device->CreateSDLWindow = SWITCH_CreateWindow;
+    device->DestroyWindow = SWITCH_DestroyWindow;
+    device->PumpEvents = SWITCH_PumpEvents;
+
+    device->GL_LoadLibrary = SWITCH_GL_LoadLibrary;
+    device->GL_GetProcAddress = SWITCH_GL_GetProcAddress;
+    device->GL_UnloadLibrary = SWITCH_GL_UnloadLibrary;
+    device->GL_CreateContext = SWITCH_GL_CreateContext;
+    device->GL_MakeCurrent = SWITCH_GL_MakeCurrent;
+    device->GL_SetSwapInterval = SWITCH_GL_SetSwapInterval;
+    device->GL_GetSwapInterval = SWITCH_GL_GetSwapInterval;
+    device->GL_SwapWindow = SWITCH_GL_SwapWindow;
+    device->GL_DestroyContext = SWITCH_GL_DestroyContext;
+
+    device->device_caps = VIDEO_DEVICE_CAPS_FULLSCREEN_ONLY;
+
+    device->free = SWITCH_DeleteDevice;
+
+    return device;
+}
+
+VideoBootStrap SWITCH_bootstrap = {
+    SWITCHVID_DRIVER_NAME, "Nintendo Switch (libnx) video driver",
+    SWITCH_CreateDevice, NULL, false
+};
+
+#endif // SDL_VIDEO_DRIVER_SWITCH
