/* On-screen controller (src/port/ui/touch_overlay.cpp). Positions and sizes are set from code,
   in pixels, from the window; this file only says how the controls look. */

body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: "FOT-NewRodin Pro";
    font-weight: bold;
    color: #FFFFFF;
    pointer-events: none;
    z-index: 0;
}

#touch-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
}

#touch-root.shown {
    display: block;
}

.button,
.stick {
    position: absolute;
    /* border-radius is set in pixels from code: RmlUi rejects "50%". */
    border: 2dp rgba(255, 255, 255, 70%);
    background-color: rgba(30, 30, 40, 55%);
    /* Centred with text-align and a line-height set from code: RmlUi draws no bare text
       inside a flex container, which left every label blank. */
    display: block;
    text-align: center;
    font-size: 22dp;
}

.button.pressed {
    background-color: rgba(255, 255, 255, 60%);
    color: #202020;
}

/* GameCube colours: a green A, a red B. */
.button.a {
    background-color: rgba(40, 170, 90, 70%);
    font-size: 30dp;
}

.button.a.pressed {
    background-color: rgba(120, 230, 150, 90%);
}

.button.b {
    background-color: rgba(200, 50, 60, 70%);
}

.button.b.pressed {
    background-color: rgba(250, 130, 130, 90%);
}

.button.z {
    background-color: rgba(110, 70, 190, 65%);
}

.button.shoulder {
    font-size: 20dp;
}

.button.small {
    font-size: 13dp;
}

.button.menu {
    font-family: "Material Symbols Rounded";
    font-size: 20dp;
}

.stick {
    background-color: rgba(30, 30, 40, 35%);
}

.knob {
    position: absolute;
    background-color: rgba(220, 220, 230, 75%);
    border: 2dp rgba(255, 255, 255, 80%);
}

.stick.pressed .knob {
    background-color: rgba(255, 255, 255, 95%);
}
