# IDE folders
.idea/
.vs/
.vscode/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
work/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
*.exe

# Build outputs never belong in the tree. A 32 MB zip committed here is carried
# by every clone forever, and the URL that serves it from the branch is mutable:
# the same link gives different bytes tomorrow, so an artifact a tester crashed
# on cannot be fetched back to reproduce the crash. Releases carry their own
# immutable assets - see tools/test_update_channel.ps1.
dist/*.zip

# Generated input files. They are reproducible from a seed and a script, which
# is the whole point: the seed is the artifact worth keeping, not the megabytes.
work/gen/
